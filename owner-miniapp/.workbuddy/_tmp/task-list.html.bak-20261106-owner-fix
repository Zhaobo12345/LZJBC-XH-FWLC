            if (!s.hasRealContract) {
                var loose = s.tasks || [];
                if (loose.length) h += bandHtml('流程任务', '流程任务', rowsHtml(loose, c.id, 'temp'), loose.length);
                (s.stages || []).forEach(function (sg) {
                    var ts = sg.tasks || [];
                    if (ts.length) h += bandHtml(sg.n, '流程任务', rowsHtml(ts, c.id, 'temp'), ts.length);
                });
            }
            var ext = s.temp || [];
            if (ext.length) h += bandHtml('临时任务', '临时任务', rowsHtml(ext, c.id, 'temp'), ext.length);
            return h || '<div class="block-empty">该流程项暂无临时任务</div>';
