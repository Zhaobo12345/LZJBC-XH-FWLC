                    '<div class="contract-progress"><div class="progress-track"><div class="progress-fill" style="width:' + pct + '%"></div></div>' +
                    '<div class="progress-text">已完成 ' + done + '/' + total + '</div></div></div></div>' +
                    '<div class="arrow expanded">▼</div></div>' +
                    '<div class="stage-group show">' + stageHtml + '</div></div>';
            }
            var title = c.hasContract ? '合同尚未创建' : '该流程项不含合同';
            var hint = c.hasContract
                ? '该项已开启合同，合同生效后阶段任务才归入「合同任务」'
                : '该项为纯任务流程项，任务统一在「临时任务」中查看';
            return '<div class="block-empty"><span class="be-t">' + esc(title) + '</span>' + esc(hint) + '</div>';
