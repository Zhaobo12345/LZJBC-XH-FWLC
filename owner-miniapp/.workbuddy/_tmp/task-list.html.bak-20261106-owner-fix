<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>家装平台小程序原型 - 任务列表</title>
    <link rel="stylesheet" href="common.css">
    <style>
        .page-content {
            height: calc(100% - 44px - 44px);
        }

        .search-filter-bar {
            background-color: var(--bg-primary);
            padding: 4px 10px;
        }

        .search-input {
            width: 100%;
            height: 28px;
            background-color: var(--bg-secondary);
            border: none;
            border-radius: 14px;
            padding: 0 12px;
            font-size: 13px;
            color: var(--text-primary);
            outline: none;
        }

        .search-input::placeholder {
            color: var(--text-tertiary);
        }

        .search-input:focus {
            background-color: #E6F7FF;
        }

        .filter-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .filter-tag {
            display: flex;
            align-items: center;
            padding: 4px 10px;
            background-color: var(--status-primary-bg);
            border-radius: 14px;
            font-size: 12px;
            color: var(--primary-color);
        }

        .filter-tag .remove {
            margin-left: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .filter-level-one {
            display: flex;
            background-color: var(--bg-primary);
            padding: 8px 16px;
            gap: 8px;
            border-bottom: 1px solid var(--border-color);
        }

        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 12px 12px 0px 12px;
            background-color: var(--bg-primary);
            position: relative;
            z-index: 1;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 1;
        }

        .filter-group:first-child {
            flex: 0 0 auto;
        }

        .filter-label {
            font-size: 12px;
            color: var(--text-secondary);
            white-space: nowrap;
        }

        .filter-toggle {
            display: flex;
            background-color: var(--bg-secondary);
            border-radius: 16px;
            overflow: hidden;
            padding: 2px;
        }

        .filter-option {
            padding: 5px 12px;
            font-size: 12px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            -webkit-user-select: none;
            border-radius: 14px;
            background-color: transparent;
        }

        .filter-option:hover {
            color: var(--primary-color);
        }

        .filter-option.active {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .filter-option.active:hover {
            background-color: var(--primary-color);
        }

        .filter-select {
            position: relative;
            padding: 6px 28px 6px 12px;
            font-size: 12px;
            color: var(--text-primary);
            background-color: var(--bg-secondary);
            border: none;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            -webkit-user-select: none;
            min-width: 90px;
        }

        .filter-select:hover {
            background-color: #E6F7FF;
        }

        .filter-select.active {
            background-color: #E6F7FF;
            color: var(--primary-color);
        }

        .filter-select::after {
            content: '▼';
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 8px;
            color: var(--text-tertiary);
            transition: transform 0.2s;
        }

        .filter-select.active::after {
            transform: translateY(-50%) rotate(180deg);
            color: var(--primary-color);
        }

        .status-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            width: 140px;
            background-color: var(--bg-primary);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            border: 1px solid var(--border-color);
            overflow: hidden;
            z-index: 1000;
            display: none;
        }

        .status-dropdown.show {
            display: block;
            animation: dropdownFadeIn 0.15s ease;
        }

        @keyframes dropdownFadeIn {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .status-dropdown-item {
            padding: 10px 14px;
            font-size: 13px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
            user-select: none;
            -webkit-user-select: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-dropdown-item:hover {
            background-color: #F5F5F5;
        }

        .status-dropdown-item.active {
            background-color: #E6F7FF;
            color: var(--primary-color);
            font-weight: 500;
        }

        .status-dropdown-item.active::before {
            content: '✓';
            font-size: 12px;
        }

        .contract-section {
            background-color: var(--bg-primary);
            margin-bottom: 8px;
        }

        .contract-header {
            display: flex;
            align-items: flex-start;
            padding: 12px 16px;
            background-color: var(--bg-secondary);
            cursor: pointer;
            transition: all 0.2s;
        }

        .contract-header:hover {
            background-color: #E6F7FF;
        }

        .contract-header .contract-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 16px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .contract-header .contract-main {
            flex: 1;
            min-width: 0;
        }

        .contract-header .contract-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            line-height: 20px;
        }

        .contract-header .contract-footer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .contract-header .contract-meta {
            font-size: 12px;
            color: var(--text-tertiary);
            line-height: 16px;
            white-space: nowrap;
        }

        .contract-header .contract-progress {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1 1 120px;
            min-width: 96px;
        }

        .contract-header .progress-track {
            flex: 1;
            height: 6px;
            min-width: 50px;
            background-color: #F0F0F0;
            border-radius: 3px;
            overflow: hidden;
        }

        .contract-header .progress-fill {
            height: 100%;
            width: 0;
            background-color: var(--success-color);
            border-radius: 3px;
            transition: width 0.3s ease;
        }

        .contract-header .progress-text {
            font-size: 12px;
            color: var(--text-tertiary);
            white-space: nowrap;
        }

        .contract-header .arrow {
            color: var(--text-tertiary);
            transition: transform 0.3s;
            margin-left: 8px;
            flex-shrink: 0;
            line-height: 20px;
        }

        .contract-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .stage-group {
            display: none;
        }

        .stage-group.show {
            display: block;
        }

        .stage-header {
            display: flex;
            align-items: center;
            padding: 10px 16px 10px 44px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
        }

        .stage-header:hover {
            background-color: #F5F5F5;
        }

        .stage-header .stage-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--primary-color);
            margin-right: 8px;
        }

        .stage-header .stage-dot.completed {
            background-color: var(--success-color);
        }

        .stage-header .stage-dot.confirming {
            background-color: var(--warning-color);
        }

        .stage-header .stage-name {
            flex: 1;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .stage-header .stage-count {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .stage-header .sequential-icon {
            color: var(--warning-color);
            margin-left: 8px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .stage-header .sequential-icon::before {
            content: '↪';
        }

        .task-item.disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .task-item.disabled .task-name {
            color: var(--text-tertiary);
        }

        .task-item.disabled::after {
            content: '🔒';
            font-size: 12px;
            margin-left: 8px;
        }

        .stage-header .arrow {
            margin-left: 8px;
            color: var(--text-tertiary);
            font-size: 10px;
            transition: transform 0.3s;
        }

        .stage-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .temp-tasks-section {
            border-top: 1px solid var(--border-color);
        }

        .temp-tasks-header {
            display: flex;
            align-items: center;
            padding: 10px 16px 10px 44px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
        }

        .temp-tasks-header:hover {
            background-color: #F5F5F5;
        }

        .temp-tasks-icon {
            font-size: 14px;
            margin-right: 8px;
        }

        .temp-tasks-title {
            flex: 1;
            font-size: 13px;
            font-weight: 600;
            color: #722ED1;
        }

        .temp-tasks-count {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .temp-tasks-header .arrow {
            margin-left: 8px;
            color: var(--text-tertiary);
            font-size: 10px;
            transition: transform 0.3s;
        }

        .temp-tasks-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .temp-tasks-list {
            display: none;
        }

        .temp-tasks-list.show {
            display: block;
        }

        .task-list {
            display: none;
        }

        .task-list.show {
            display: block;
        }

        .task-item {
            display: flex;
            align-items: center;
            padding: 12px 16px 12px 60px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .task-item:hover {
            background-color: #E6F7FF;
        }

        .task-item:last-child {
            border-bottom: none;
        }

        .task-item .task-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 12px;
            flex-shrink: 0;
        }

        .task-item .task-status.completed {
            background-color: var(--success-color);
            color: #FFFFFF;
        }

        .task-item .task-status.confirming {
            background-color: var(--warning-color);
            color: #FFFFFF;
        }

        .task-item .task-status.executing {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .task-item .task-status.pending {
            background-color: var(--bg-tertiary);
            color: var(--text-tertiary);
        }

        .task-item .task-status.config {
            background-color: transparent;
            color: var(--text-tertiary);
            border: 1px dashed var(--border-color);
        }

        .task-item .task-status-text {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 12px;
            flex-shrink: 0;
        }

        .task-item .task-status-text .status-icon {
            font-size: 10px;
        }

        .task-item .task-status-text.pending {
            background-color: var(--status-warning-bg);
            color: var(--warning-color);
        }

        .task-item .task-status-text.config {
            background-color: #F5F5F5;
            color: #8C8C8C;
            border: 1px solid #E8E8E8;
        }

        .task-item .task-status-text.confirming {
            background-color: var(--status-primary-bg);
            color: var(--primary-color);
        }

        .task-item .task-status-text.completed {
            background-color: var(--status-success-bg);
            color: var(--success-color);
        }

        .task-item .task-status-text.executing {
            background-color: var(--status-primary-bg);
            color: var(--primary-color);
        }

        .task-item .confirm-progress {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
        }

        .task-item .confirm-progress-bar {
            flex: 1;
            height: 4px;
            background-color: var(--bg-tertiary);
            border-radius: 2px;
            overflow: hidden;
        }

        .task-item .confirm-progress-fill {
            height: 100%;
            background-color: var(--primary-color);
            border-radius: 2px;
            transition: width 0.3s;
        }

        .task-item .confirm-progress-text {
            font-size: 11px;
            color: var(--text-tertiary);
            white-space: nowrap;
        }

        .task-item .priority-badge {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: 6px;
        }

        .task-item .priority-badge.urgent {
            background-color: #FFF1F0;
            color: var(--error-color);
        }

        .task-item .priority-badge.important {
            background-color: #FFF7E6;
            color: var(--warning-color);
        }

        .task-item .priority-badge.normal {
            background-color: var(--bg-secondary);
            color: var(--text-tertiary);
        }

        .task-item .task-info {
            flex: 1;
            min-width: 0;
        }

        .task-item .task-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            line-height: 1.4;
        }

        .task-item .task-tag {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .task-item .task-tag.contract {
            background-color: #E6F7FF;
            color: #1890FF;
        }

        .task-item .task-tag.temp {
            background-color: #F9F0FF;
            color: #722ED1;
        }

        .task-item .task-tag.rejected {
            background-color: #FFF1F0;
            color: var(--error-color);
            border: 1px solid #FFCCC7;
        }

        .task-item .task-meta {
            font-size: 12px;
            color: var(--text-tertiary);
            margin-top: 4px;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 16px;
            color: var(--text-tertiary);
        }

        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
            opacity: 0.6;
        }

        .empty-state .text {
            font-size: 14px;
        }

        .result-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3px 12px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            font-size: 11px;
            color: var(--text-tertiary);
        }

        .expand-all-btn {
            color: var(--primary-color);
            cursor: pointer;
        }

        .quick-filter-bar {
            display: flex;
            padding: 8px 12px;
            gap: 6px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            flex-wrap: nowrap;
        }

        .quick-filter-bar::-webkit-scrollbar {
            display: none;
        }

        .quick-filter-btn {
            flex: 1;
            padding: 6px 8px;
            background-color: var(--bg-secondary);
            border-radius: 16px;
            font-size: 12px;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            transition: all 0.2s;
            border: 1px solid transparent;
            white-space: nowrap;
            min-width: 0;
        }

        .quick-filter-btn:hover {
            background-color: #E6F7FF;
        }

        .quick-filter-btn.active {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .quick-filter-btn .badge {
            background-color: rgba(255,255,255,0.3);
            padding: 0 6px;
            border-radius: 8px;
            font-size: 10px;
        }

        .quick-filter-btn:not(.active) .badge {
            background-color: var(--status-warning-bg);
            color: var(--warning-color);
        }

        .filter-panel-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0,0,0,0.5);
            z-index: 999;
            display: none;
        }

        .filter-panel-overlay.show {
            display: block;
        }

        .filter-panel {
            position: absolute;
            top: 0;
            right: -280px;
            width: 280px;
            height: 100%;
            background-color: var(--bg-primary);
            z-index: 1000;
            transition: right 0.3s;
            display: flex;
            flex-direction: column;
        }

        .filter-panel.show {
            right: 0;
        }

        .filter-panel-header {
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .filter-panel-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .filter-panel-close {
            font-size: 20px;
            color: var(--text-tertiary);
            cursor: pointer;
        }

        .filter-panel-content {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .filter-group {
            margin-bottom: 20px;
        }

        .filter-group-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .filter-group-title .tip {
            font-size: 11px;
            color: var(--text-tertiary);
            font-weight: normal;
        }

        .filter-multi-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .filter-multi-option {
            padding: 8px 14px;
            background-color: var(--bg-secondary);
            border-radius: 8px;
            font-size: 13px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .filter-multi-option:hover {
            background-color: #E6F7FF;
        }

        .filter-multi-option.selected {
            background-color: #E6F7FF;
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .filter-panel-footer {
            padding: 16px;
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 12px;
        }

        .filter-panel-btn {
            flex: 1;
            height: 40px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
        }

        .filter-panel-btn.reset {
            background-color: var(--bg-secondary);
            color: var(--text-secondary);
        }

        .filter-panel-btn.apply {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .save-filter-btn {
            font-size: 12px;
            color: var(--primary-color);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-top: 12px;
        }

        .saved-filters {
