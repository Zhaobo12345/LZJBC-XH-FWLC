            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .saved-filter-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background-color: var(--bg-secondary);
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
        }

        .saved-filter-item:hover {
            background-color: #E6F7FF;
        }

        .saved-filter-name {
            font-size: 13px;
            color: var(--text-primary);
        }

        .saved-filter-delete {
            font-size: 14px;
            color: var(--text-tertiary);
        }

