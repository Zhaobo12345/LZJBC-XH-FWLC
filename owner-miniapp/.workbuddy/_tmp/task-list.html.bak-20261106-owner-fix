            display: flex;
            align-items: center;
            padding: 12px 16px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .flat-task-item:hover {
            background-color: #E6F7FF;
        }

        .flat-task-item .task-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
