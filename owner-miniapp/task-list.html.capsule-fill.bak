                        </div>
                    </div>
                    <div class="task-status-text confirming">确认中</div>
                </div>
                <div class="flat-task-item" data-status="pending" onclick="goToTaskDetail(this)">
                    <div class="task-status pending">○</div>
                    <div class="task-info">
                        <div class="task-name">吊顶施工</div>
                        <div class="task-meta">
                            <span class="contract-name">木工分包合同</span>
                            <span>执行人：赵六</span>
                        </div>
                    </div>
                    <div class="task-status-text pending">待开始</div>
                </div>
                <div class="flat-task-item" data-status="pending" onclick="goToTaskDetail(this)">
                    <div class="task-status pending">○</div>
                    <div class="task-info">
                        <div class="task-name">墙面批刮</div>
                        <div class="task-meta">
                            <span class="contract-name">油漆分包合同</span>
                            <span>执行人：钱七</span>
                        </div>
                    </div>
                    <div class="task-status-text pending">待开始</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="page-nav">
        <div class="page-nav-title">原型导航</div>
        <a href="home.html" class="page-nav-item">首页</a>
        <a href="project-detail.html" class="page-nav-item">项目详情</a>
        <a href="task-list.html" class="page-nav-item active">任务列表</a>
        <a href="contract-detail.html" class="page-nav-item">合同详情</a>
        <a href="task-detail.html" class="page-nav-item">任务详情</a>
    </div>
    
    <script>
        let currentFilters = {
            contract: 'all',
            contractText: '全部合同',
            type: 'all',
            typeText: '全部类型',
            status: 'all',
            statusText: '全部状态',
            mine: false
        };
        
        let allExpanded = true;
        
        function showToast(message, duration = 2500) {
            const existingToast = document.querySelector('.app-toast');
            if (existingToast) {
                existingToast.remove();
            }
            
            const toast = document.createElement('div');
            toast.className = 'app-toast';
            toast.innerHTML = message.replace(/\n/g, '<br>');
            toast.style.cssText = `
                position: absolute;
                bottom: 80px;
                left: 50%;
                transform: translateX(-50%);
                background-color: rgba(0, 0, 0, 0.7);
                color: #FFFFFF;
                padding: 10px 20px;
                border-radius: 8px;
                font-size: 13px;
                z-index: 1000;
                white-space: pre-wrap;
                max-width: 90%;
                text-align: center;
                line-height: 1.5;
            `;
            const phoneFrame = document.querySelector('.phone-frame');
            if (phoneFrame) {
                phoneFrame.appendChild(toast);
            }
            
            setTimeout(() => {
                toast.remove();
            }, duration);
        }
        
        function toggleFilterDropdown() {
            const dropdown = document.getElementById('filterDropdown');
            const filterBtn = document.getElementById('filterBtn');
            dropdown.classList.toggle('show');
            filterBtn.classList.toggle('active');
        }
        
        function closeFilterDropdown() {
            document.getElementById('filterDropdown').classList.remove('show');
            document.getElementById('filterBtn').classList.remove('active');
        }
        
        function selectContract(element, value, text) {
            currentFilters.contract = value;
            currentFilters.contractText = text;
            updateFilterOptions('contractOptions', value);
            updateFilterTags();
            filterTasks();
        }
        
        function selectType(element, value, text) {
            currentFilters.type = value;
            currentFilters.typeText = text;
            updateFilterOptions('typeOptions', value);
            updateFilterTags();
            filterTasks();
        }
        
        function selectStatus(element, value, text) {
            currentFilters.status = value;
            currentFilters.statusText = text;
            updateFilterOptions('statusOptions', value);
            updateFilterTags();
            filterTasks();
        }
        
        function updateFilterOptions(containerId, activeValue) {
            const container = document.getElementById(containerId);
            const options = container.querySelectorAll('.filter-option');
            options.forEach(option => {
                if (option.dataset.value === activeValue) {
                    option.classList.add('active');
                } else {
                    option.classList.remove('active');
                }
            });
        }
        
        function updateFilterTags() {
            const filterTags = document.getElementById('filterTags');
            const tags = [];
            
            if (currentFilters.contract !== 'all') {
                tags.push({ type: 'contract', text: currentFilters.contractText });
            }
            if (currentFilters.type !== 'all') {
                tags.push({ type: 'type', text: currentFilters.typeText });
            }
            if (currentFilters.status !== 'all') {
                tags.push({ type: 'status', text: currentFilters.statusText });
            }
            
            if (tags.length > 0) {
                filterTags.style.display = 'flex';
                filterTags.innerHTML = tags.map(tag => `
                    <div class="filter-tag">
                        <span>${tag.text}</span>
                        <span class="remove" onclick="removeFilter('${tag.type}')">×</span>
                    </div>
                `).join('');
            } else {
                filterTags.style.display = 'none';
            }
            
            const filterBtn = document.getElementById('filterBtn');
            if (tags.length > 0) {
                filterBtn.classList.add('active');
            } else {
                filterBtn.classList.remove('active');
            }
        }
        
        function removeFilter(type) {
            if (type === 'contract') {
                currentFilters.contract = 'all';
                currentFilters.contractText = '全部合同';
                updateFilterOptions('contractOptions', 'all');
            } else if (type === 'type') {
                currentFilters.type = 'all';
                currentFilters.typeText = '全部类型';
                updateFilterOptions('typeOptions', 'all');
            } else if (type === 'status') {
                currentFilters.status = 'all';
                currentFilters.statusText = '全部状态';
                updateFilterOptions('statusOptions', 'all');
            }
            updateFilterTags();
            filterTasks();
        }
        
        function goToTaskDetail(element) {
            const taskType = element.dataset.type;
            const taskStatus = element.dataset.status;
            
            if (taskType === 'temp') {
                location.href = `temp-task-detail.html?status=${taskStatus}`;
            } else {
                location.href = `task-detail.html?status=${taskStatus}`;
            }
        }
        
        function toggleContract(header) {
            const stageGroup = header.nextElementSibling;
            const arrow = header.querySelector('.arrow');
            
            if (stageGroup.classList.contains('show')) {
                stageGroup.classList.remove('show');
                arrow.classList.remove('expanded');
            } else {
                stageGroup.classList.add('show');
                arrow.classList.add('expanded');
            }
        }
        
        function toggleStage(header) {
            const taskList = header.nextElementSibling;
            const arrow = header.querySelector('.arrow');
            
            if (taskList.classList.contains('show')) {
                taskList.classList.remove('show');
                arrow.classList.remove('expanded');
            } else {
                taskList.classList.add('show');
                arrow.classList.add('expanded');
            }
        }
        
        function toggleTempTasks(header) {
            const taskList = header.nextElementSibling;
            const arrow = header.querySelector('.arrow');
            
            if (taskList.classList.contains('show')) {
                taskList.classList.remove('show');
                arrow.classList.remove('expanded');
            } else {
                taskList.classList.add('show');
                arrow.classList.add('expanded');
            }
        }
        
        function expandAllContracts() {
            const btn = document.querySelector('.expand-all-btn');
            const contractSections = document.querySelectorAll('.contract-section');
            
            if (allExpanded) {
                contractSections.forEach(section => {
                    const stageGroup = section.querySelector('.stage-group');
                    const arrow = section.querySelector('.contract-header .arrow');
                    stageGroup.classList.remove('show');
                    arrow.classList.remove('expanded');
                    
                    section.querySelectorAll('.task-list').forEach(list => list.classList.remove('show'));
                    section.querySelectorAll('.stage-header .arrow').forEach(a => a.classList.remove('expanded'));
                });
                btn.textContent = '展开全部';
                allExpanded = false;
            } else {
                contractSections.forEach(section => {
                    const stageGroup = section.querySelector('.stage-group');
                    const arrow = section.querySelector('.contract-header .arrow');
                    stageGroup.classList.add('show');
                    arrow.classList.add('expanded');
                    
                    section.querySelectorAll('.task-list').forEach(list => list.classList.add('show'));
                    section.querySelectorAll('.stage-header .arrow').forEach(a => a.classList.add('expanded'));
                });
                btn.textContent = '收起全部';
                allExpanded = true;
            }
        }
        
        function filterTasks() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const contractSections = document.querySelectorAll('.contract-section');
            let totalVisible = 0;
            let pendingCount = 0;
            let confirmingCount = 0;
            let completedCount = 0;
            
            contractSections.forEach(section => {
                const contractId = section.dataset.contract;
                const stages = section.querySelectorAll('.stage-item');
                const tempTasksSection = section.querySelector('.temp-tasks-section');
                let contractVisibleCount = 0;
                
                stages.forEach(stage => {
                    const tasks = stage.querySelectorAll('.task-item');
                    let stageVisibleCount = 0;
                    
                    tasks.forEach(task => {
                        const taskType = task.dataset.type;
                        const taskStatus = task.dataset.status;
                        const taskParticipant = task.dataset.participant === 'true';
                        const taskName = task.querySelector('.task-name').textContent.toLowerCase();
                        
                        let visible = true;
                        
                        if (currentFilters.contract !== 'all' && contractId !== currentFilters.contract) {
                            visible = false;
                        }
                        
                        if (currentFilters.type !== 'all' && taskType !== currentFilters.type) {
                            visible = false;
                        }
                        
                        if (currentFilters.status !== 'all' && taskStatus !== currentFilters.status) {
                            visible = false;
                        }
                        
                        if (currentFilters.mine && !taskParticipant) {
                            visible = false;
                        }
                        
                        if (searchText && !taskName.includes(searchText)) {
                            visible = false;
                        }
                        
                        task.style.display = visible ? 'flex' : 'none';
                        
                        if (visible) {
                            stageVisibleCount++;
                            contractVisibleCount++;
                            totalVisible++;
                            if (taskStatus === 'pending') pendingCount++;
                            if (taskStatus === 'confirming') confirmingCount++;
                            if (taskStatus === 'completed') completedCount++;
                        }
                    });
                    
                    if (stageVisibleCount > 0) {
                        stage.style.display = 'block';
                    } else {
                        stage.style.display = 'none';
                    }
                });
                
                if (tempTasksSection) {
                    const tempTasks = tempTasksSection.querySelectorAll('.task-item');
                    let tempVisibleCount = 0;
                    
                    tempTasks.forEach(task => {
                        const taskType = task.dataset.type;
                        const taskStatus = task.dataset.status;
                        const taskName = task.querySelector('.task-name').textContent.toLowerCase();
                        
                        let visible = true;
                        
                        if (currentFilters.contract !== 'all' && contractId !== currentFilters.contract) {
                            visible = false;
                        }
                        
                        if (currentFilters.type !== 'all' && taskType !== currentFilters.type) {
                            visible = false;
                        }
                        
                        if (currentFilters.status !== 'all' && taskStatus !== currentFilters.status) {
                            visible = false;
                        }
                        
                        if (searchText && !taskName.includes(searchText)) {
                            visible = false;
                        }
                        
                        task.style.display = visible ? 'flex' : 'none';
                        
                        if (visible) {
                            tempVisibleCount++;
                            contractVisibleCount++;
                            totalVisible++;
                            if (taskStatus === 'pending') pendingCount++;
                            if (taskStatus === 'confirming') confirmingCount++;
                            if (taskStatus === 'completed') completedCount++;
                        }
                    });
                    
                    if (tempVisibleCount > 0) {
                        tempTasksSection.style.display = 'block';
                        const countEl = tempTasksSection.querySelector('.temp-tasks-count');
                        if (countEl) countEl.textContent = tempVisibleCount + '个任务';
                    } else {
                        tempTasksSection.style.display = 'none';
                    }
                }
                
                if (contractVisibleCount > 0) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });
            
            document.getElementById('resultCount').textContent = '共 ' + totalVisible + ' 个任务';
            document.getElementById('totalCount').textContent = totalVisible;
            document.getElementById('pendingCount').textContent = pendingCount;
            document.getElementById('confirmingCount').textContent = confirmingCount;
            document.getElementById('completedCount').textContent = completedCount;
            
            const emptyState = document.getElementById('emptyState');
            if (totalVisible === 0) {
                emptyState.style.display = 'flex';
            } else {
                emptyState.style.display = 'none';
            }
        }
        
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-filter-bar')) {
                const dropdown = document.getElementById('filterDropdown');
                if (dropdown) dropdown.classList.remove('show');
            }
            
            const filterPanel = document.getElementById('filterPanel');
            const filterOverlay = document.getElementById('filterPanelOverlay');
            if (filterPanel && filterPanel.classList.contains('show')) {
                if (e.target === filterOverlay) {
                    closeFilterPanel();
                }
            }
        });

        function openFilterPanel() {
            const panel = document.getElementById('filterPanel');
            const overlay = document.getElementById('filterPanelOverlay');
            if (panel && overlay) {
                panel.classList.add('show');
                overlay.classList.add('show');
            }
        }

        function closeFilterPanel() {
            const panel = document.getElementById('filterPanel');
            const overlay = document.getElementById('filterPanelOverlay');
            if (panel && overlay) {
                panel.classList.remove('show');
                overlay.classList.remove('show');
            }
        }

        function toggleMultiOption(element) {
            element.classList.toggle('selected');
        }

        function quickFilter(type, btn) {
            document.querySelectorAll('.quick-filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            if (type === 'all') {
                currentFilters.status = 'all';
                currentFilters.type = 'all';
                currentFilters.mine = false;
            } else if (type === 'mine') {
                currentFilters.status = 'all';
                currentFilters.type = 'all';
                currentFilters.mine = true;
            } else {
                currentFilters.status = type;
                currentFilters.type = 'all';
                currentFilters.mine = false;
            }
            
            filterTasks();
        }

        function handleParticipantClick(type, btn) {
            document.querySelectorAll('.filter-option').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            currentFilters.mine = type === 'mine';
            filterTasks();
        }

        function saveFilterScheme() {
            showToast('筛选方案已保存');
        }

        let currentView = 'grouped';
        let currentGroupBy = 'contract';

        function switchView(view, tab) {
            currentView = view;
            
            document.querySelectorAll('.view-switch-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            
            const taskContainer = document.getElementById('taskContainer');
            const flatList = document.getElementById('flatTaskList');
            const groupBySelector = document.getElementById('groupBySelector');
            const resultBar = document.querySelector('.result-bar');
            
            if (view === 'flat') {
                taskContainer.style.display = 'none';
                flatList.classList.add('show');
                groupBySelector.style.display = 'none';
                resultBar.style.display = 'none';
            } else {
                taskContainer.style.display = 'block';
                flatList.classList.remove('show');
                groupBySelector.style.display = 'flex';
                resultBar.style.display = 'flex';
            }
        }

        function changeGroupBy(value) {
            currentGroupBy = value;
            
            const taskContainer = document.getElementById('taskContainer');
            const contractSections = taskContainer.querySelectorAll('.contract-section');
            
            if (value === 'stage') {
                contractSections.forEach(section => {
                    const stages = section.querySelectorAll('.stage-item');
                    stages.forEach(stage => {
                        const stageName = stage.querySelector('.stage-name').textContent;
                        const stageDot = stage.querySelector('.stage-dot');
                        const stageHeader = stage.querySelector('.stage-header');
                        
                        if (stageName.includes('材料') || stageName.includes('防水')) {
                            stageDot.className = 'stage-dot completed';
                            stageHeader.style.borderLeft = '3px solid var(--success-color)';
                        } else if (stageName.includes('布管') || stageName.includes('贴砖')) {
                            stageDot.className = 'stage-dot confirming';
                            stageHeader.style.borderLeft = '3px solid var(--warning-color)';
                        } else {
                            stageDot.className = 'stage-dot';
                            stageHeader.style.borderLeft = '3px solid var(--primary-color)';
                        }
                    });
                });
                
                showToast('已按阶段分组显示');
            } else if (value === 'status') {
                contractSections.forEach(section => {
                    const stages = section.querySelectorAll('.stage-item');
                    stages.forEach(stage => {
                        const tasks = stage.querySelectorAll('.task-item');
                        let hasConfirming = false;
                        let hasPending = false;
                        let allCompleted = true;
                        
                        tasks.forEach(task => {
                            const status = task.dataset.status;
                            if (status === 'confirming') hasConfirming = true;
                            if (status === 'pending') hasPending = true;
                            if (status !== 'completed') allCompleted = false;
                        });
                        
                        const stageDot = stage.querySelector('.stage-dot');
                        const stageHeader = stage.querySelector('.stage-header');
                        
                        if (allCompleted && tasks.length > 0) {
                            stageDot.className = 'stage-dot completed';
                            stageHeader.style.borderLeft = '3px solid var(--success-color)';
                        } else if (hasConfirming) {
                            stageDot.className = 'stage-dot confirming';
                            stageHeader.style.borderLeft = '3px solid var(--warning-color)';
                        } else {
                            stageDot.className = 'stage-dot';
                            stageHeader.style.borderLeft = '3px solid var(--primary-color)';
                        }
                    });
                });
                
                showToast('已按状态分组显示');
            } else {
                contractSections.forEach(section => {
                    const stages = section.querySelectorAll('.stage-item');
                    stages.forEach(stage => {
                        const stageDot = stage.querySelector('.stage-dot');
                        const stageHeader = stage.querySelector('.stage-header');
                        stageDot.className = 'stage-dot';
                        stageHeader.style.borderLeft = 'none';
                    });
                });
                
                showToast('已按合同分组显示');
            }
        }

        function goToTaskDetail(element) {
            const taskType = element.dataset.type;
            const taskStatus = element.dataset.status;
            
            if (element.classList.contains('disabled')) {
                showToast('当前阶段内任务为按序执行，存在未完成的前置任务，当前任务无法执行');
                return;
            }
            
            if (taskType === 'temp') {
                location.href = `temp-task-detail.html?status=${taskStatus}`;
            } else {
                location.href = `task-detail.html?status=${taskStatus}`;
            }
        }

        function checkSequentialTasks() {
            const contractSections = document.querySelectorAll('.contract-section');
            
            contractSections.forEach(section => {
                const stages = section.querySelectorAll('.stage-item');
                
                stages.forEach(stage => {
                    const isSequential = stage.dataset.sequential === 'true';
                    if (!isSequential) return;
                    
                    const tasks = stage.querySelectorAll('.task-item');
                    let prevTaskCompleted = true;
                    
                    tasks.forEach((task, index) => {
                        const taskStatus = task.dataset.status;
                        
                        if (index > 0 && isSequential) {
                            const prevTask = tasks[index - 1];
                            const prevTaskStatus = prevTask.dataset.status;
                            prevTaskCompleted = prevTaskStatus === 'completed';
                            
                            if (!prevTaskCompleted && taskStatus !== 'completed') {
                                task.classList.add('disabled');
                                task.removeAttribute('onclick');
                                task.setAttribute('onclick', 'goToTaskDetail(this)');
                            } else {
                                task.classList.remove('disabled');
                            }
                        }
                    });
                });
            });
        }

        function showToast(message, duration = 2500) {
            const existingToast = document.querySelector('.app-toast');
            if (existingToast) {
                existingToast.remove();
            }
            
            const toast = document.createElement('div');
            toast.className = 'app-toast';
            toast.textContent = message;
            toast.style.cssText = `
                position: fixed;
                bottom: 80px;
                left: 50%;
                transform: translateX(-50%);
                background-color: rgba(0, 0, 0, 0.75);
                color: #FFFFFF;
                padding: 12px 20px;
                border-radius: 8px;
                font-size: 13px;
                z-index: 10000;
                white-space: nowrap;
                max-width: 90%;
                text-align: center;
                line-height: 1.5;
            `;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, duration);
        }

        document.addEventListener('DOMContentLoaded', function() {
            checkSequentialTasks();
            
            const participantOptions = document.querySelectorAll('.filter-option');
            participantOptions.forEach(function(option) {
                option.addEventListener('click', function(e) {
                    e.stopPropagation();
                    participantOptions.forEach(function(o) { o.classList.remove('active'); });
                    option.classList.add('active');
                    
                    const type = option.dataset.filter;
                    currentFilters.mine = type === 'mine';
                    filterTasks();
                });
            });
            
            const dropdown = document.getElementById('statusDropdownMenu');
            const selectBtn = document.getElementById('statusSelectBtn');
            
            if (dropdown && selectBtn) {
                selectBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.classList.toggle('show');
                    selectBtn.classList.toggle('active');
                    
                    if (dropdown.classList.contains('show')) {
                        setTimeout(function() {
                            document.addEventListener('click', function handleDocClick(e) {
                                if (!dropdown.contains(e.target) && !selectBtn.contains(e.target)) {
                                    dropdown.classList.remove('show');
                                    selectBtn.classList.remove('active');
                                    document.removeEventListener('click', handleDocClick);
                                }
                            });
                        }, 0);
                    }
                });
                
                const items = dropdown.querySelectorAll('.status-dropdown-item');
                items.forEach(function(item) {
                    item.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const status = item.dataset.status;
                        const text = item.textContent;
                        
                        items.forEach(function(i) { i.classList.remove('active'); });
                        item.classList.add('active');
                        
                        selectBtn.textContent = text;
                        dropdown.classList.remove('show');
                        selectBtn.classList.remove('active');
                        
                        currentFilters.status = status;
                        filterTasks();
                    });
                });
            }
        });
        
        function toggleActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.toggle('show');
            }
        }
        
        function closeActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.remove('show');
            }
        }
        
        
    </script>
</body>
</html>

