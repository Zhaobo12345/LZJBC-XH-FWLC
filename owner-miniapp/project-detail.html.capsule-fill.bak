                </div>
                <span class="locate-btn" onclick="ProjectNav.scrollToCurrentTask()">
                    <span class="locate-icon">📍</span>
                    定位施工项
                </span>
            </div>

            <!-- 阶段+任务列表内容区 -->
            <div class="drawer-content" id="projectNavContent">
                <!-- 内容由 JS 动态生成 -->
            </div>

            <!-- 底部提示 -->
