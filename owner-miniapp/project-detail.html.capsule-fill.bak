                <div class="drawer-header-right">
                    <span class="drawer-expand-btn" id="projectNavExpandAll" onclick="ProjectNav.toggleExpandAll()">全部展开</span>
                    <span class="drawer-close" id="projectNavClose">×</span>
                </div>
            </div>

            <!-- 统计信息栏 -->
