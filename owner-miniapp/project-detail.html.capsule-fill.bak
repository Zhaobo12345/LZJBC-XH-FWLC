                <span class="footer-tip-icon">💡</span>
                <span>点击阶段行可展开/收起；点击任务直达详情</span>
            </div>
        </div>
        
        <div class="tab-bar">
            <div class="tab-item" onclick="location.href='home.html'">
                <div class="icon">🏠</div>
                <div class="label">首页</div>
            </div>
            <div class="tab-item active">
                <div class="icon">📋</div>
                <div class="label">我的家</div>
            </div>
            <div class="tab-item" onclick="location.href='message.html'">
                <div class="icon">💬</div>
                <div class="label">消息</div>
            </div>
            <div class="tab-item" onclick="showToast('个人中心开发中')">
                <div class="icon">👤</div>
                <div class="label">我的</div>
            </div>
        </div>
    </div>
    
    <div class="page-nav">
        <div class="page-nav-title">原型导航</div>
        <a href="home.html" class="page-nav-item">首页</a>
        <a href="project-detail.html" class="page-nav-item active">项目详情</a>
        <a href="../service-miniapp/project-detail-ongoing-v2.html" class="page-nav-item">项目详情（进行中-新版）</a>
        <a href="project-detail-completed.html" class="page-nav-item">项目详情（已完成）</a>
        <a href="project-info.html" class="page-nav-item">项目信息</a>
        <a href="architecture.html" class="page-nav-item">项目架构</a>
        <a href="contract-detail.html" class="page-nav-item">合同详情</a>
        <a href="task-detail.html" class="page-nav-item">任务详情</a>
    </div>

    <script>
        // 导航栏菜单功能
        function toggleActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.toggle('show');
            }
        }
        
        function closeActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.remove('show');
            }
        }
        
        // 直接在页面中初始化原型导航折叠功能
        function initPageNav() {
            var pageNav = document.querySelector('.page-nav');
            if (!pageNav) return;

            var navTitle = pageNav.querySelector('.page-nav-title');
            if (!navTitle) return;

            var toggleBtn = document.createElement('span');
            toggleBtn.className = 'toggle-btn';
            toggleBtn.textContent = '▼';
            navTitle.appendChild(toggleBtn);

            navTitle.addEventListener('click', function() {
                pageNav.classList.toggle('collapsed');
                toggleBtn.classList.toggle('collapsed');
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPageNav);
        } else {
            initPageNav();
        }
    </script>
    <script src="js/project-nav-data.js"></script>
    <script src="js/project-detail.js"></script>
    <!-- 移除内联脚本，避免事件绑定冲突 -->
</body>
</html>