<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>家装平台小程序原型 - 项目列表</title>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        /* 手机端小程序规范：隐藏所有滚动条（手机框内详情滚动、下拉面板、原型导航等） */
        ::-webkit-scrollbar { width: 0 !important; height: 0 !important; display: none !important; }
        * { -ms-overflow-style: none; scrollbar-width: none; }
        :root {
            --primary: #1677ff; --primary-bg: #e6f7ff; --primary-light: #4096ff;
            --success: #52c41a; --success-bg: #f6ffed; --warning: #fa8c16; --warning-bg: #fff7e6;
            --danger: #ff4d4f; --danger-bg: #fff2f0; --orange: #fa541c;
            --text: #222; --text-2: #555; --text-3: #999; --bg: #f2f3f5;
            --card: #fff; --border: #ececec; --shadow: 0 1px 6px rgba(0,0,0,.05);
            /* 与 project-detail.css 对齐的渐变色（快捷入口图标用） */
            --gradient-blue: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
            --gradient-green: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
            --gradient-orange: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
            --gradient-purple: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);
            --gradient-gold: linear-gradient(135deg, #FAAD14 0%, #FFC53D 100%);
            --gradient-cyan: linear-gradient(135deg, #13C2C2 0%, #36CFC9 100%);
        }
        body {
            margin: 0; background: #e9ebee; min-height: 100vh;
            font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
            display: flex; align-items: flex-start; justify-content: center; padding: 24px; gap: 16px;
        }

        /* ===== 手机框 ===== */
        .phone-frame {
            width: 375px; height: 812px; background: var(--bg);
            border-radius: 40px; overflow: hidden; position: relative; flex-shrink: 0;
            box-shadow: 0 12px 40px rgba(0,0,0,.25); display: flex; flex-direction: column;
        }
        .stage { position: relative; flex-shrink: 0; }
        .status-bar {
            height: 44px; background: #fff; display: flex; align-items: center;
            justify-content: space-between; padding: 0 22px; font-size: 14px;
            font-weight: 600; color: #000; flex-shrink: 0;
        }
        .nav-bar {
            height: 48px; background: #fff; display: flex; align-items: center;
            position: relative; border-bottom: 1px solid var(--border); flex-shrink: 0;
        }
        .nav-bar .nb-back { position: absolute; left: 14px; font-size: 26px; line-height: 1; color: #1a1a1a; text-decoration: none; }
        .nav-bar .title { flex: 1; text-align: center; font-size: 17px; font-weight: 600; color: #1a1a1a; }

        /* ===== 顶部：项目切换条 + 角色分段 ===== */
        .topbar {
            flex-shrink: 0; background: #fff; border-bottom: 1px solid var(--border);
            padding: 8px 12px; display: flex; align-items: center; gap: 10px; position: relative; z-index: 30;
        }
        .proj-switch {
            flex: 1; display: flex; align-items: stretch;
            background: #f5f7fa; border: 1px solid #e8edf3; border-radius: 12px; overflow: hidden;
        }
        .proj-info-zone {
            flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; cursor: pointer;
            padding: 8px 10px; transition: background .15s;
        }
        .proj-info-zone:active { background: #eef2f7; }
        .proj-info-zone .info-arrow { font-size: 18px; color: var(--text-3); flex: 0 0 auto; line-height: 1; }
        .proj-switch-left { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 0 1 auto; }
        .proj-name { font-size: 14px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 110px; }
        .proj-status { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--primary-bg); color: var(--primary); flex: 0 0 auto; }
        .proj-switch-hero { flex: 1 1 auto; min-width: 0; text-align: right; font-size: 12px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
        .proj-switch-hero b { color: var(--primary); font-weight: 700; font-size: 14px; }
        .proj-status.done { background: var(--success-bg); color: var(--success); }
        .proj-switch-right {
            display: flex; align-items: center; gap: 4px; flex: 0 0 auto; cursor: pointer;
            padding: 8px 12px; border-left: 1px solid #e3e8ef; background: #fafbfc; transition: background .15s;
        }
        .proj-switch-right:active { background: #eef2f7; }
        .switch-hint { font-size: 11px; color: var(--text-3); }
        .switch-arrow { font-size: 12px; color: var(--text-3); transition: transform .25s; }
        .switch-arrow.open { transform: rotate(180deg); }

        /* ===== 角色演示开关（手机框外侧，参考「演示开关」效果） ===== */
        .role-demo-switch {
            position: absolute; left: calc(100% + 16px); top: 80px;
            background: #fff; border: 1px solid #ffe7ba; border-radius: 12px;
            padding: 12px 14px; box-shadow: 0 4px 16px rgba(0,0,0,.1); z-index: 100; width: 132px;
        }
        .role-demo-switch .switch-title { font-size: 12px; font-weight: 600; color: #333; margin-bottom: 8px; text-align: center; }
        .role-demo-switch .switch-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
        .role-demo-switch .switch-status { color: var(--primary); font-weight: 600; font-size: 12px; white-space: nowrap; }
        .role-demo-switch .switch-status.worker { color: var(--warning); }
        .role-demo-switch .switch-hint { font-size: 10px; color: #999; text-align: center; line-height: 1.3; }
        .switch { position: relative; display: inline-block; width: 36px; height: 20px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc; transition: .3s; border-radius: 20px;
        }
        .slider:before {
            position: absolute; content: ""; height: 16px; width: 16px; left: 2px; bottom: 2px;
            background-color: #fff; transition: .3s; border-radius: 50%;
        }
        .switch input:checked + .slider { background-color: var(--warning); }
        .switch input:checked + .slider:before { transform: translateX(16px); }

        /* ===== 认证状态演示开关（手机框右侧中间，对应「新建项目」） ===== */
        .auth-demo-switch {
            position: absolute; left: calc(100% + 16px); top: 50%; transform: translateY(-50%);
            background: #fff; border: 1px solid #bae0ff; border-radius: 12px;
            padding: 12px 14px; box-shadow: 0 4px 16px rgba(0,0,0,.1); z-index: 100; width: 132px;
        }
        .auth-demo-switch .switch-title { font-size: 12px; font-weight: 600; color: #333; margin-bottom: 8px; text-align: center; }
        .auth-demo-switch .switch-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
        .auth-demo-switch .switch-status { color: var(--text-3); font-weight: 600; font-size: 12px; white-space: nowrap; }
        .auth-demo-switch .switch-status.certified { color: var(--success); }
        .auth-demo-switch .switch-hint { font-size: 10px; color: #999; text-align: center; line-height: 1.3; }
        .auth-demo-switch .switch input:checked + .slider { background-color: var(--success); }

        /* 认证提示弹窗（新建项目未认证时） */
        .app-modal {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0,0,0,.5); display: none;
            justify-content: center; align-items: center; z-index: 300;
        }
        .app-modal.show { display: flex; }
        .modal-box { width: 280px; background: #fff; border-radius: 12px; padding: 24px 20px 16px; text-align: center; }
        .modal-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 16px; }
        .modal-content { font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 24px; }
        .modal-content p { margin: 0; }
        .modal-actions { display: flex; gap: 12px; }
        .modal-btn {
            flex: 1; height: 40px; border: none; border-radius: 8px; font-size: 14px;
            cursor: pointer; transition: all .2s; display: flex; justify-content: center;
            align-items: center; text-align: center; line-height: 1; padding: 0;
            -webkit-appearance: none; font-family: inherit; font-weight: 500;
        }
        .modal-btn.cancel { background: #f5f5f5; color: #666; }
        .modal-btn.confirm { background: var(--primary); color: #fff; }

        /* ===== 项目下拉面板 ===== */
        .proj-panel {
            position: absolute; left: 0; right: 0; top: 100%; background: #fff;
            max-height: 0; overflow: hidden; transition: max-height .3s ease; z-index: 25;
            box-shadow: 0 8px 20px rgba(0,0,0,.12); border-radius: 0 0 16px 16px;
        }
        .proj-panel.open { max-height: 460px; display: flex; flex-direction: column; overflow: hidden; }
        .proj-panel-inner { flex: 1; min-height: 0; overflow-y: auto; padding: 8px 12px 12px; }
        .proj-option {
            border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer;
            transition: all .15s; background: #fff;
        }
        .proj-option:active { background: #f5f7fa; }
        .proj-option.active { border-color: var(--primary); background: #f5faff; }
        .po-top { display: flex; align-items: center; justify-content: space-between; }
        .po-name { font-size: 14px; font-weight: 600; color: var(--text); }
        .po-status { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--primary-bg); color: var(--primary); }
        .po-status.done { background: var(--success-bg); color: var(--success); }
        .po-addr { font-size: 12px; color: var(--text-3); margin: 4px 0; }
        .po-stats { display: flex; gap: 14px; font-size: 12px; color: var(--text-2); margin-bottom: 6px; }
        .po-bar { height: 4px; background: #eef0f3; border-radius: 2px; overflow: hidden; }
        .po-bar-fill { height: 100%; background: var(--primary); border-radius: 2px; }
        /* ===== 切换面板：状态筛选胶囊 + 新建项目 ===== */
        .proj-panel-filter { flex-shrink: 0; display: flex; gap: 6px; padding: 8px 12px 6px; border-bottom: 1px solid var(--border); background: #fff; }
        .pf-item {
            flex: 1; text-align: center; font-size: 12px; padding: 5px 0; border-radius: 8px;
            background: #f2f4f7; color: var(--text-2); cursor: pointer; transition: all .15s;
        }
        .pf-item.active { background: #333; color: #fff; font-weight: 600; }
        .proj-panel-foot {
            flex-shrink: 0; padding: 8px 12px 10px;
            border-top: 1px solid var(--border); background: #fff;
            box-shadow: 0 -2px 8px rgba(0,0,0,.04);
        }
        .proj-new-btn {
            width: 100%; padding: 9px; border: none; border-radius: 10px;
            background: var(--primary); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
            transition: opacity .15s;
        }
        .proj-new-btn:active { opacity: .85; }
        .proj-empty { text-align: center; font-size: 12px; color: #999; padding: 18px 0; }

        /* ===== 详情滚动区 ===== */
        .detail-scroll { flex: 1; overflow-y: auto; padding: 12px 12px 56px; position: relative; }
        .detail-fade { animation: fadeUp .28s ease both; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

        /* ===== 项目基本信息头 ===== */
        .project-basic-header {
            background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%); color: #fff; border-radius: 14px;
            padding: 16px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; cursor: pointer;
            box-shadow: 0 4px 14px rgba(22,119,255,.25);
        }
        .project-basic-header.worker { background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%); box-shadow: 0 4px 14px rgba(250,140,22,.25); }
        .project-basic-header .left-info { font-size: 15px; font-weight: 600; }
        .project-basic-header .left-info .highlight { font-size: 22px; font-weight: 800; margin: 0 2px; }
        .project-basic-header .right-wrap { display: flex; align-items: center; gap: 6px; }
        .project-basic-header .right-info { font-size: 13px; opacity: .95; }
        .project-basic-header .right-info.worker-stat { font-weight: 600; }
        .project-basic-header .enter-arrow { font-size: 18px; opacity: .9; }

        /* ===== 通用卡片 ===== */
        .card {
            background: var(--card); border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; box-shadow: var(--shadow);
        }
        .card-title {
            display: flex; align-items: center; font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 10px; gap: 6px;
        }
        .card-title .badge-wrap { display: inline-flex; }
        .card-title .badge {
            background: var(--danger-bg); color: var(--danger); font-size: 11px; font-weight: 600;
            min-width: 18px; height: 18px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; padding: 0 5px;
        }
        .card-title .more { margin-left: auto; font-size: 12px; color: var(--text-3); font-weight: 400; }

        /* ===== 待办 ===== */
        .todo-content { }
        .todo-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
        .todo-item:last-child { border-bottom: none; }
        .todo-item .icon { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex: 0 0 auto; }
        .todo-item .content { flex: 1; min-width: 0; }
        .todo-item .title { font-size: 13px; color: var(--text); font-weight: 500; display: flex; align-items: center; gap: 6px; }
        .todo-item .desc { font-size: 11px; color: var(--text-3); margin-top: 3px; }
        .todo-item .status { font-size: 11px; padding: 3px 9px; border-radius: 10px; flex: 0 0 auto; font-weight: 500; }
        .status.urgent { background: var(--danger-bg); color: var(--danger); }
        .status.pending { background: var(--warning-bg); color: var(--warning); }
        .status.in-progress { background: var(--primary-bg); color: var(--primary); }
        .task-tag { font-size: 10px; padding: 1px 6px; border-radius: 4px; font-weight: 500; }
        .task-tag.contract { background: #e6f7ff; color: #1677ff; }
        .task-tag.task { background: #f6ffed; color: #52c41a; }
        .todo-group-label { font-size: 12px; font-weight: 600; color: var(--text-3); margin: 10px 0 2px; }
        .todo-group-label:first-child { margin-top: 0; }
        .todo-card.worker { border-left: 3px solid var(--warning); }
        .todo-card.worker .card-title { color: #d46b08; }

        /* ===== 吸顶快捷入口 + 架构（与 project-detail.css / 源页对齐） ===== */
        .sticky-header {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.92);
            -webkit-backdrop-filter: saturate(180%) blur(12px);
            backdrop-filter: saturate(180%) blur(12px);
            border-radius: 0 0 14px 14px;
            padding: 8px 12px; margin-bottom: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
            transition: box-shadow .25s;
        }
        .sticky-header.with-shadow { box-shadow: 0 4px 16px rgba(0,0,0,.08); }

        /* 快捷入口：4 项网格，常驻吸顶、始终可见（主操作不因滚动隐藏） */
        .quick-nav {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            padding: 4px 8px 2px;
            background: transparent;
            position: relative;
        }
        /* 工人视角快捷入口：取消「更多」后 5 项同处一行（不影响非工人视角 4 项布局） */
        .quick-nav.work-quick-nav { grid-template-columns: repeat(4, 1fr); }
        .quick-nav-item {
            display: flex; flex-direction: column; align-items: center;
            cursor: pointer; padding: 4px 2px; border-radius: 8px;
            transition: all .2s;
        }
        .quick-nav-item:active { transform: scale(0.95); background: var(--primary-bg); }
        .quick-nav-item .icon {
            width: 32px; height: 32px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; margin-bottom: 2px; color: #fff;
            position: relative;
        }
        .quick-nav-item .icon.info { background: var(--gradient-blue); }
        .quick-nav-item .icon.structure { background: var(--gradient-green); }
        .quick-nav-item .icon.member { background: var(--gradient-orange); }
        .quick-nav-item .icon.file { background: var(--gradient-purple); }
        .quick-nav-item .icon.statement { background: var(--gradient-gold); }
        .quick-nav-item .icon.tasks { background: var(--gradient-blue); }
        .quick-nav-item .icon.activity { background: var(--gradient-cyan); }
        .quick-nav-item .icon.contract { background: var(--gradient-orange); }
        .quick-nav-item .icon.more { background: linear-gradient(135deg, #8C8C8C 0%, #BFBFBF 100%); }
        .quick-nav-item .label { font-size: 11px; color: var(--text-2); text-align: center; line-height: 1.2; }
        .quick-nav-item .nav-badge {
            position: absolute;
            top: -4px; right: -4px;
            background: var(--danger); color: #fff;
            font-size: 10px; min-width: 14px; height: 14px; border-radius: 7px;
            padding: 0 3px;
            display: inline-flex; align-items: center; justify-content: center;
            white-space: nowrap;
        }

        /* 更多面板（次级入口）：默认折叠，平滑展开；绝不隐藏 4 个主入口 */
        .more-panel {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 8px; padding: 0 8px;
            max-height: 0; overflow: hidden; opacity: 0;
            transition: max-height .3s ease, padding .3s ease, opacity .25s ease;
        }
        .more-panel.show { max-height: 120px; opacity: 1; padding: 10px 8px 6px; }
        .quick-nav-item.more-open .icon.more { transform: rotate(45deg); }

        /* 架构选择器 */
        .level-selector {
            margin-top: 4px; border-top: 1px solid #f0f0f0; padding-top: 4px;
            position: relative; z-index: 50;
        }
        .level-dropdown { display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
        .level-dropdown .current { display: flex; align-items: center; }
        .level-dropdown .current .icon {
            width: 32px; height: 32px; border-radius: 8px; background: var(--gradient-blue);
            display: flex; align-items: center; justify-content: center;
            margin-right: 10px; font-size: 14px; color: #fff; flex: 0 0 auto;
        }
        .level-dropdown .text-row { display: flex; align-items: center; gap: 6px; }
        .level-dropdown .text { font-size: 14px; font-weight: 600; color: var(--text); }
        .level-dropdown .type-badge {
            font-size: 10px; padding: 1px 6px; border-radius: 4px;
            background: var(--primary-bg); color: var(--primary);
        }
        .level-dropdown .type-badge.workgroup { background: var(--success-bg); color: var(--success); }
        .level-dropdown .arrow { color: var(--text-3); transition: transform .3s; }
        .level-dropdown .arrow.open { transform: rotate(180deg); }
        .breadcrumb-inline { display: flex; align-items: center; font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .breadcrumb-inline .breadcrumb-item { color: var(--text-3); }
        .breadcrumb-inline .breadcrumb-item.active { color: var(--primary); font-weight: 500; }
        .breadcrumb-inline .separator { margin: 0 4px; color: var(--text-3); }
        .level-default-hint { font-size: 11px; color: var(--warning); margin-top: 2px; }
        .level-options {
            position: absolute; left: 0; right: 0; top: 100%;
            background: #fff; border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
            display: none; z-index: 100;
        }
        .level-options.open { display: block; }
        .level-option { display: flex; align-items: center; padding: 10px 12px; cursor: pointer; }
        .level-option:active { background: #f5f7fa; }
        .level-option.selected { background: #f5faff; }
        .level-option .icon {
            width: 28px; height: 28px; border-radius: 6px; background: var(--gradient-blue);
            display: flex; align-items: center; justify-content: center;
            margin-right: 10px; font-size: 12px; color: #fff; flex: 0 0 auto;
        }
        .level-option .info { flex: 1; }
        .level-option .name { font-size: 13px; font-weight: 500; color: var(--text); }
        .level-option .count { font-size: 11px; color: var(--text-3); margin-top: 1px; }
        .level-option .check { margin-left: auto; color: var(--primary); font-size: 14px; }

        /* 架构选择器紧凑 */
        .level-selector.arch-half { padding: 4px 0; }
        .level-selector.arch-half .level-dropdown .current .icon { width: 28px; height: 28px; font-size: 13px; }
        .level-selector.arch-half .level-dropdown .text { font-size: 13px; }
        .level-selector.arch-half .breadcrumb-inline { font-size: 10px; margin-top: 1px; }

        /* 通用箭头旋转 */
        .arrow { transition: transform .2s; }
        .arrow.open { transform: rotate(180deg); }
        .activity-more-btn .arrow { transition: transform .2s; }

        /* ===== 合同 / 任务统计（与「项目详情（进行中-新版）」v2 首屏优化一致） ===== */
        .stats-row { display: block; margin: 0 10px 8px; }
        .stats-row > .card { margin: 0 0 8px 0; padding: 8px 12px; }
        .stats-row > .card:last-child { margin-bottom: 0; }
        /* 今日动态与合同概览/任务统计保持一致的横向缩进 */
        .card.indent-card { margin: 0 10px 8px; }
        .contract-half { flex: 1.2; }
        .task-half { flex: 1; }
        /* 合同概览：2 统计横排（全宽，中间分隔线） */
        .card.contract-half .contract-summary { display: flex; flex-direction: row; align-items: center; padding: 2px 0; }
        .card.contract-half .contract-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
        .card.contract-half .contract-stat .value { font-size: 14px; font-weight: 700; color: var(--text); }
        .card.contract-half .contract-stat .value .separator { color: var(--text-3); margin: 0 1px; }
        .card.contract-half .contract-stat .value .total { font-size: 11px; color: var(--text-3); font-weight: 400; }
        .card.contract-half .contract-stat .label { font-size: 10px; color: var(--text-3); margin-top: 2px; }
        .card.contract-half .contract-list { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .card.contract-half .contract-list.show { max-height: 110px; overflow-y: auto; }
        .contract-item { display: flex; align-items: center; gap: 10px; padding: 7px 0; border-top: 1px solid #f0f0f0; cursor: pointer; transition: background .15s; }
        .contract-item:active { background: #f7faff; }
        .contract-item:first-child { border-top: none; }
        .contract-item .info { flex: 1; min-width: 0; }
        .contract-item .name { font-size: 13px; color: var(--text); font-weight: 500; }
        .contract-item .meta { font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .contract-item .meta-row { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .action-badge { font-size: 10px; padding: 1px 7px; border-radius: 8px; }
        .action-badge.green { background: var(--success-bg); color: var(--success); }
        .action-badge.orange { background: var(--warning-bg); color: var(--warning); }
        .progress-wrap { width: 64px; flex: 0 0 auto; text-align: right; }
        .progress-wrap .percent { font-size: 11px; color: var(--text-2); margin-bottom: 3px; }
        .progress-wrap .bar { height: 4px; background: #eef0f3; border-radius: 2px; overflow: hidden; }
        .progress-wrap .fill { height: 100%; background: var(--primary); border-radius: 2px; }
        /* 任务统计：3 项横排（全宽，icon 居左、数值+标签纵向居右，单行紧凑） */
        .card.task-half .task-stats { display: flex; flex-direction: row; gap: 6px; }
        .card.task-half .task-stat-item { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 5px; padding: 3px 2px; }
        .card.task-half .task-stat-item .icon-wrap { width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-bottom: 0; flex: 0 0 auto; }
        .icon-wrap.all { background: #e6f7ff; }
        .icon-wrap.accept { background: #fff7e6; }
        .icon-wrap.contract { background: #f6ffed; }
        .card.task-half .task-stat-item .info { flex: none; display: block; text-align: left; line-height: 1.1; }
        .card.task-half .task-stat-item .value { font-size: 14px; font-weight: 700; color: var(--text); }
        .card.task-half .task-stat-item .value .separator { color: var(--text-3); }
        .card.task-half .task-stat-item .value .total { font-size: 11px; color: var(--text-3); font-weight: 400; }
        .card.task-half .task-stat-item .label { font-size: 10px; color: var(--text-3); margin-top: 0; }
        /* 数据色彩化（与源页一致） */
        .card.contract-half .contract-stat:nth-of-type(1) .value { color: var(--primary); }
        .card.contract-half .contract-stat:nth-of-type(2) .value .current { color: var(--success); }
        .card.task-half .task-stat-item:nth-of-type(1) .value { color: var(--primary); }
        .card.task-half .task-stat-item:nth-of-type(2) .value { color: var(--warning); }
        .card.task-half .task-stat-item:nth-of-type(3) .value { color: var(--orange); }
        /* 非工人视角：合同概览卡高度略缩小（不影响工人视角） */
        .card.contract-half:not(.worker) { padding: 6px 12px; }
        .card.contract-half:not(.worker) .contract-summary { padding: 1px 0; }

        /* 工人视角：合同卡 与 任务统计卡 视觉协调、整体适度增高，便于年长用户查看；不影响非工人视角 */
        .card.contract-half.worker,
        .card.task-half.worker {
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .card.contract-half.worker .contract-list { padding: 2px 0; }
        .card.contract-half.worker .contract-item { padding: 5px 0; }
        .card.contract-half.worker .contract-item .name { font-size: 14px; margin-bottom: 2px; }
        .card.contract-half.worker .contract-item .meta-row { font-size: 12px; margin-top: 3px; }
        .card.contract-half.worker .progress-wrap .percent { font-size: 12px; margin-bottom: 4px; }
        .card.contract-half.worker .progress-wrap .bar { height: 5px; }
        .card.task-half.worker .task-stats { gap: 6px; }
        .card.task-half.worker .task-stat-item { flex-direction: column; align-items: center; justify-content: center; padding: 2px 2px; gap: 5px; }
        .card.task-half.worker .task-stat-item .icon-wrap { width: 26px; height: 26px; border-radius: 7px; font-size: 13px; }
        .card.task-half.worker .task-stat-item .info { text-align: center; line-height: 1.15; }
        .card.task-half.worker .task-stat-item .value { font-size: 15px; }
        .card.task-half.worker .task-stat-item .value .total { font-size: 12px; }
        .card.task-half.worker .task-stat-item .label { font-size: 11px; margin-top: 1px; }
        .todo-card.worker { margin-bottom: 12px; }
        .todo-card.worker .todo-item { padding: 10px 0; }

        /* ===== 我的任务（位于待办事项下方） ===== */
        .my-task-card { cursor: pointer; padding: 10px 14px; margin-bottom: 10px; }
        .my-task-card .card-title { margin-bottom: 6px; }
        .my-task-card .my-task-stats { display: flex; flex-direction: row; align-items: stretch; }
        .my-task-card .my-task-stat { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 2px 0; }
        .my-task-card .my-task-stat .value { font-size: 18px; font-weight: 700; color: var(--text); line-height: 1; }
        .my-task-card .my-task-stat .label { font-size: 11px; color: var(--text-3); margin-top: 1px; text-align: center; }
        .my-task-card .my-task-divider { width: 1px; background: #f0f0f0; margin: 4px 0; }
        .my-task-card .my-task-stat:first-child .value { color: var(--success, #52c41a); }
        .my-task-card.worker .card-title { color: #d46b08; }

        /* ===== 今日动态（与「项目详情（进行中-新版）」保持一致） ===== */
        .activity-role-tag {
            display: inline-block; font-size: 10px; padding: 0 6px; border-radius: 8px;
            margin-left: 4px; vertical-align: middle; line-height: 14px; height: 14px; font-weight: 500;
        }
        .activity-role-tag.supervisor { background-color: #E6F7FF; color: #1890FF; }
        .activity-role-tag.foreman { background-color: #F6FFED; color: #52C41A; }
        .activity-role-tag.worker { background-color: #FFF7E6; color: #FA8C16; }
        .activity-role-tag.designer { background-color: #F9F0FF; color: #722ED1; }
        .activity-role-tag.owner { background-color: #FFF1F0; color: #F5222D; }
        .activity-role-tag.project-manager { background-color: #E6F7FF; color: #1890FF; }
        .activity-role-tag.plumbing-worker { background-color: #E6FFFB; color: #13C2C2; }
        .activity-stage-tag {
            display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 4px;
            margin: 0 4px; font-weight: 500; line-height: 14px;
        }
        .activity-stage-tag.demolition { background-color: #FFF1F0; color: #F5222D; }
        .activity-stage-tag.plumbing { background-color: #E6F7FF; color: #1890FF; }
        .activity-stage-tag.carpentry { background-color: #FFF7E6; color: #FA8C16; }
        .activity-stage-tag.tiling { background-color: #F9F0FF; color: #722ED1; }
        .activity-stage-tag.painting { background-color: #FCFABE; color: #D4B106; }
        .activity-stage-tag.installation { background-color: #F0F5FF; color: #2F54EB; }
        .activity-stage-tag.cleanup { background-color: #F6FFED; color: #52C41A; }
        .activity-stage-tag.design { background-color: #F9F0FF; color: #722ED1; }
        .activity-list { max-height: 150px; overflow-y: auto; }
        .activity-list.expanded { max-height: 320px; }
        .activity-item { padding: 6px 0 6px 16px; position: relative; cursor: pointer; transition: background .15s; }
        .activity-item:active { background: #f7faff; }
        .activity-item::before { content: ''; position: absolute; left: 4px; top: 14px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }
        .activity-header { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
        .activity-avatar {
            width: 26px; height: 26px; border-radius: 50%; font-size: 11px; color: #fff;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 0 2px rgba(255,255,255,.85), 0 1px 4px rgba(0,0,0,.12); flex: 0 0 auto;
        }
        .activity-info { flex: 1; min-width: 0; }
        .activity-user { font-size: 12px; color: var(--text); }
        .activity-time { font-size: 10px; color: var(--text-3); }
        .activity-content { font-size: 12px; color: var(--text); margin-bottom: 3px; }
        .activity-media { display: flex; gap: 4px; margin-top: 3px; flex-wrap: wrap; }
        .activity-media-item { width: 48px; height: 48px; border-radius: 6px; flex: 0 0 auto; position: relative; }
        .activity-more-btn { padding: 5px; font-size: 12px; margin-top: 3px; text-align: center; color: var(--primary); }
        .hidden { display: none; }

        /* ===== 原型导航 ===== */
        .page-nav {
            width: 200px; background: #fff; border-radius: 12px; padding: 16px; box-shadow: 0 4px 16px rgba(0,0,0,.08);
            align-self: flex-start; max-height: 812px; overflow-y: auto;
        }
        .page-nav h3 { margin: 0 0 10px; font-size: 14px; color: #333; }
        .page-nav a { display: block; font-size: 13px; color: #555; text-decoration: none; padding: 6px 0; }
        .page-nav a.active { color: var(--primary); font-weight: 600; }
        .page-nav a:hover { color: var(--primary); }

        /* 小程序底部主导航（复用 common.css 语义，但本页自包含不依赖外部样式） */
        .tab-bar {
            height: 50px;
            background: var(--card);
            display: flex;
            border-top: 1px solid var(--border);
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
        }
        .tab-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .tab-item .icon { font-size: 20px; margin-bottom: 2px; }
        .tab-item .label { font-size: 10px; }
        .tab-item.active { color: var(--primary); }
        .tab-item:not(.active) { color: var(--text-3); }
    </style>
</head>
<body>
    <div class="page-nav">
        <h3>原型导航</h3>
        <a href="home.html">首页</a>
        <a href="project-list.html" class="active">项目列表</a>
        <a href="project-list-empty-demo.html">项目列表（空状态演示）</a>
        <a href="project-detail.html">项目详情</a>
        <a href="project-detail-new.html">初始项目详情页</a>
        <a href="project-info.html">项目信息</a>
        <a href="architecture.html">项目架构</a>
        <a href="create-project.html">创建项目</a>
        <a href="task-list.html">任务列表</a>
        <a href="contract-detail.html">合同详情</a>
    </div>

    <div class="stage">
    <div class="phone-frame">
        <div class="status-bar">
            <span class="time">9:41</span>
            <div class="icons">📶 🔋</div>
        </div>
        <div class="nav-bar">
            <a class="nb-back" href="project-list.html">&lsaquo;</a>
            <div class="title">项目及详情</div>
        </div>

        <!-- 顶部：项目切换条（角色切换已移至手机框外侧演示开关） -->
        <div class="topbar">
            <div class="proj-switch">
                <!-- 左侧：点击查看当前项目信息（跳转 project-info 页） -->
                <div class="proj-info-zone" onclick="viewProjectInfo()">
                    <div class="proj-switch-left">
                        <span class="proj-name" id="curProjName">—</span>
                        <span class="proj-status" id="curProjStatus">—</span>
                    </div>
                    <div class="proj-switch-hero" id="topHero"></div>
                    <span class="info-arrow">›</span>
                </div>
                <!-- 右侧：点击展开项目切换面板 -->
                <div class="proj-switch-right" onclick="togglePanel()">
                    <span class="switch-hint">切换</span>
                    <span class="switch-arrow" id="switchArrow">▾</span>
                </div>
            </div>
            <!-- 角色切换已移至手机框外侧「演示开关」 -->

            <!-- 项目下拉面板：置于 topbar 内，相对切换条定位展开 -->
            <div class="proj-panel" id="projPanel">
                <div class="proj-panel-filter" id="projPanelFilter">
                    <div class="pf-item active" data-filter="all" onclick="setPanelFilter('all', this)">全部</div>
                    <div class="pf-item" data-filter="ongoing" onclick="setPanelFilter('ongoing', this)">进行中</div>
                    <div class="pf-item" data-filter="done" onclick="setPanelFilter('done', this)">已完成</div>
                </div>
                <div class="proj-panel-inner" id="projPanelInner"></div>
                <div class="proj-panel-foot">
                    <button class="proj-new-btn" onclick="createProject()">＋ 新建项目</button>
                </div>
            </div>
        </div>

        <!-- 详情区 -->
        <div class="detail-scroll" id="detailArea"></div>

        <!-- 小程序主导航（项目为当前选中项） -->
        <div class="tab-bar">
            <div class="tab-item" onclick="location.href='home.html'">
                <div class="icon">🏠</div>
                <div class="label">首页</div>
            </div>
            <div class="tab-item active">
                <div class="icon">📋</div>
                <div class="label">项目</div>
            </div>
            <div class="tab-item" onclick="location.href='message.html'">
                <div class="icon">💬</div>
                <div class="label">消息</div>
            </div>
            <div class="tab-item" onclick="showToast('个人中心开发中')">
                <div class="icon">👤</div>
                <div class="label">我的</div>
            </div>
        </div>

        <!-- 角色认证提示弹窗（新建项目需先完成认证） -->
        <div class="app-modal" id="authRequiredModal">
            <div class="modal-box">
                <div class="modal-title">创建项目需先完成认证</div>
                <div class="modal-content">
                    <p>当前操作需先完成角色认证；</p>
                    <p>认证通过后方可继续创建；</p>
                </div>
                <div class="modal-actions">
                    <div class="modal-btn cancel" onclick="closeAuthModal()">取消</div>
                    <div class="modal-btn confirm" onclick="goToAuthPage()">立即认证</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 角色演示开关：置于手机框外侧，参考项目列表页「演示开关」效果 -->
    <div class="role-demo-switch">
        <div class="switch-title">演示开关</div>
        <div class="switch-item">
            <span class="switch-status" id="roleStatus">非工人</span>
            <label class="switch">
                <input type="checkbox" id="roleSwitch" onchange="toggleRoleSwitch(this.checked)">
                <span class="slider"></span>
            </label>
        </div>
        <div class="switch-hint">切换角色视角</div>
    </div>

    <!-- 认证状态演示开关：手机框右侧中间，对应「新建项目」，切换后点击新建项目验证不同效果 -->
    <div class="auth-demo-switch">
        <div class="switch-title">认证演示</div>
        <div class="switch-item">
            <span class="switch-status" id="authStatus">未认证</span>
            <label class="switch">
                <input type="checkbox" id="authSwitch" onchange="toggleAuthStatus(this.checked)">
                <span class="slider"></span>
            </label>
        </div>
        <div class="switch-hint">切换后点击新建项目</div>
    </div>
    </div>

    <script>
        /* ===================== 数据 ===================== */
        var SHARED = {
            nonworkerTodos: [
                { tag: 'contract', title: '泥瓦工班组服务合同确认', desc: '泥瓦工作组 | 待确认', status: '待确认', cls: 'urgent', icon: '🔵', bg: '#E6F7FF' },
                { tag: 'contract', title: '木作班组服务合同签约', desc: '木工工作组 | 待签约', status: '待签约', cls: 'pending', icon: '🔵', bg: '#E6F7FF' },
                { tag: 'task', title: '吊顶安装', desc: '木工工作组 | 张三待确认', status: '待确认', cls: 'pending', icon: '🟢', bg: '#F6FFED', link: 'task-detail.html' }
            ],
            workerTaskTodos: [
                { tag: 'contract', title: '泥瓦工班组服务合同确认', desc: '泥瓦工作组 | 待我确认', status: '待确认', cls: 'urgent', icon: '🔵', bg: '#E6F7FF' },
                { tag: 'task', title: '墙面基层处理', desc: '油漆工作组 | 李四待确认', status: '待确认', cls: 'pending', icon: '🟢', bg: '#F6FFED' },
                { tag: 'task', title: '地砖铺贴', desc: '泥瓦工作组 | 王五待确认', status: '待确认', cls: 'pending', icon: '🔵', bg: '#E6F7FF' }
            ],
            workerContractTodos: [
                { tag: 'contract', title: '泥瓦工班组服务合同确认', desc: '泥瓦工作组 | 待我确认', status: '待我确认', cls: 'urgent', icon: '🔵', bg: '#E6F7FF' },
                { tag: 'contract', title: '木作班组服务合同签约', desc: '木工工作组 | 待我签约', status: '待我签约', cls: 'pending', icon: '🔵', bg: '#E6F7FF' }
            ],
            contracts: [
                { name: '水电班组服务合同', meta: '水电工作组 | 金额：8万', percent: 65, badge: '已确认', badgeCls: 'green', detail: 'contract-detail.html?status=draft' },
                { name: '泥瓦工班组服务合同', meta: '泥瓦工作组 | 金额：12万', percent: 30, badge: '已确认', badgeCls: 'green', detail: 'contract-detail.html?status=confirming_sender' }
            ],
            levels: [
                { name: '项目部', count: '4个工作组 · 8份合同', selected: false },
                { name: '水电工作组', count: '3个施工组 · 2份合同', selected: false },
                { name: '泥瓦工作组', count: '2个施工组 · 1份合同', selected: false },
                { name: '木工工作组', count: '2个施工组 · 1份合同', selected: false },
                { name: '油漆工作组', count: '1个施工组 · 1份合同', selected: false }
            ],
            activities: [
                { text: '陈庄 上传了水电验收照片', time: '09:20' },
                { text: '泥瓦工作组 提交阶段确认', time: '11:05' },
                { text: '系统：合同「木作班组服务合同」进入待签约', time: '14:30' }
            ],
            // 「我的任务」区块：我（当前视角角色）作为执行人的任务统计（原型示例数据）
            myTasks: {
                nonworker: { done: 3, total: 7 }, // 我（项目总）作为执行人的任务：已完成/全部
                worker: { done: 4, total: 6 }      // 我（工人）作为执行人的任务：已完成/全部
            }
        };

        var PROJECTS = [
            { name: 'XX小区整体装修', status: '进行中', address: 'XX小区***号***室', days: 60, area: '75.0m² 2室1厅',
              contractSigned: 4, contractTotal: 5, taskDone: 18, taskTotal: 24, trade: '泥瓦', todoCount: 4 },
            { name: 'YY花园精装修', status: '进行中', address: 'YY花园***栋***单元', days: 35, area: '89.0m² 3室2厅',
              contractSigned: 2, contractTotal: 3, taskDone: 8, taskTotal: 15, trade: '水电', todoCount: 3 },
            { name: 'AA别墅装修', status: '已完工', address: 'AA别墅***号', days: 120, area: '200.0m² 别墅',
              contractSigned: 6, contractTotal: 6, taskDone: 32, taskTotal: 32, trade: '木工', todoCount: 0 }
        ];

        var currentIndex = 0;
        var currentRole = 'nonworker';
        var panelFilter = 'all'; // 切换面板筛选项：all / ongoing / done

        /* ===================== 渲染：项目切换条 ===================== */
        function renderSwitchBar() {
            var p = PROJECTS[currentIndex];
            document.getElementById('curProjName').textContent = p.name;
            var st = document.getElementById('curProjStatus');
            st.textContent = p.status;
            st.className = 'proj-status' + (p.status === '已完工' ? ' done' : '');
        }

        function renderPanel() {
            // 按切换面板筛选项过滤项目：全部 / 进行中 / 已完成（数据中"已完工"等同"已完成"）
            var list = PROJECTS.filter(function (p) {
                if (panelFilter === 'ongoing') return p.status === '进行中';
                if (panelFilter === 'done') return p.status === '已完工' || p.status === '已完成';
                return true;
            });
            if (list.length === 0) {
                document.getElementById('projPanelInner').innerHTML = '<div class="proj-empty">暂无匹配的项目</div>';
                return;
            }
            var html = list.map(function (p, i) {
                // 过滤后索引需回映射真实 PROJECTS 下标，以便 selectProject 正确选中
                var realIdx = PROJECTS.indexOf(p);
                var pct = Math.round(p.contractSigned / p.contractTotal * 100);
                var active = realIdx === currentIndex ? ' active' : '';
                var done = p.status === '已完工' ? ' done' : '';
                return '<div class="proj-option' + active + '" onclick="selectProject(' + realIdx + ')">' +
                    '<div class="po-top"><span class="po-name">' + p.name + '</span>' +
                    '<span class="po-status' + done + '">' + p.status + '</span></div>' +
                    '<div class="po-addr">📍 ' + p.address + '</div>' +
                    '<div class="po-stats"><span>合同 ' + p.contractSigned + '/' + p.contractTotal + '</span>' +
                    '<span>任务 ' + p.taskDone + '/' + p.taskTotal + '</span></div>' +
                    '<div class="po-bar"><div class="po-bar-fill" style="width:' + pct + '%"></div></div>' +
                    '</div>';
            }).join('');
            document.getElementById('projPanelInner').innerHTML = html;
        }

        /* ===================== 渲染：非工人详情 ===================== */
        function renderNonWorker(p) {
            var todos = p.todoCount === 0
                ? '<div class="empty-state" style="font-size:12px;color:#999;padding:10px 0;text-align:center;">项目已完工，暂无待办 ☕</div>'
                : SHARED.nonworkerTodos.map(function (t) {
                    return '<div class="todo-item"' + (t.link ? ' onclick="go(\'' + t.link + '\')" style="cursor:pointer"' : '') + '>' +
                        '<div class="icon" style="background-color:' + t.bg + ';">' + t.icon + '</div>' +
                        '<div class="content"><div class="title">' + t.title + ' <span class="task-tag ' + t.tag + '">' + (t.tag === 'contract' ? '合同' : '任务') + '</span></div>' +
                        '<div class="desc">' + t.desc + '</div></div>' +
                        '<div class="status ' + t.cls + '">' + t.status + '</div></div>';
                }).join('');

            var levels = SHARED.levels.map(function (l, i) {
                return '<div class="level-option' + (i === 0 ? ' selected' : '') + '" onclick="pickLevel(this, event)">' +
                    '<div class="icon">' + (i === 0 ? '🏢' : '⚡') + '</div>' +
                    '<div class="info"><div class="name">' + l.name + '</div><div class="count">' + l.count + '</div></div>' +
                    '<div class="check" style="visibility:' + (i === 0 ? 'visible' : 'hidden') + ';">✓</div></div>';
            }).join('');

            var contracts = SHARED.contracts.map(function (c) {
                return '<div class="contract-item" onclick="navigate(\'' + c.detail + '\')">' +
                    '<div class="info"><div class="name">' + c.name + '</div><div class="meta">' + c.meta + '</div></div>' +
                    '<div class="progress-wrap"><div class="percent">' + c.percent + '%</div>' +
                    '<div class="bar"><div class="fill" style="width:' + c.percent + '%"></div></div></div></div>';
            }).join('');

            return '<div class="detail-fade">' +
                '<div class="card"><div class="card-title"><span>📋 待办事项</span>' +
                    '<span class="badge-wrap"><span class="badge">' + p.todoCount + '</span></span>' +
                    '<span class="more" onclick="openPage(\'todo-list.html\')">查看全部 ></span></div>' +
                    '<div class="todo-content">' + todos + '</div></div>' +
                '<div class="card my-task-card" onclick="openPage(\'task-list.html?role=exec\')"><div class="card-title"><span>📌 我的任务</span><span class="more">查看全部 ></span></div>' +
                    '<div class="my-task-stats">' +
                        '<div class="my-task-stat"><div class="value">' + SHARED.myTasks.nonworker.done + '</div><div class="label">已完成</div></div>' +
                        '<div class="my-task-divider"></div>' +
                        '<div class="my-task-stat"><div class="value">' + SHARED.myTasks.nonworker.total + '</div><div class="label">我作为执行人的全部任务</div></div>' +
                    '</div></div>' +
                '<div class="sticky-header" id="stickyHeader">' +
                    '<div class="quick-nav" id="quickNavNon">' +
                        '<div class="quick-nav-item" onclick="go(\'architecture.html\')"><div class="icon structure">🏗️</div><div class="label">架构</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'member.html\')"><div class="icon member">👥</div><div class="label">成员</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'project-files.html\')"><div class="icon file">📁</div><div class="label">资料</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'statement-list.html\')"><div class="icon statement">💰</div><div class="label">对账单</div></div></div>' +
                    '<div class="level-selector arch-half" id="levelSelectorNon"><div class="level-dropdown" onclick="toggleLevelOpts(this)">' +
                        '<div class="current"><div class="icon">🏢</div><div>' +
                        '<div class="text-row"><div class="text">项目部</div><div class="type-badge project">项目部</div></div>' +
                        '<div class="breadcrumb-inline"><span class="breadcrumb-item active">项目部</span></div></div></div>' +
                        '<div class="arrow">▼</div></div>' +
                        '<div class="level-options">' + levels + '</div></div>' +
                '</div>' +
                '<div class="stats-row">' +
                    '<div class="card contract-half"><div class="card-title"><span>📄 合同概览</span><span class="more" onclick="toggleContractNW(this)">查看合同 <span class="arrow">▼</span></span></div>' +
                        '<div class="contract-summary"><div class="contract-stat"><div class="value"><span class="current">' + p.contractSigned + '</span><span class="separator">/</span><span class="total">' + p.contractTotal + '</span></div><div class="label">合同签约</div></div>' +
                        '<div class="contract-stat"><div class="value">' + Math.round(p.contractSigned / p.contractTotal * 100) + '<span class="total">%</span></div><div class="label">总进度</div></div></div>' +
                        '<div class="contract-list" id="contractListNW">' + contracts + '</div></div>' +
                    '<div class="card task-half"><div class="card-title"><span>📊 任务统计</span><span class="more" onclick="go(\'task-list.html\')">查看全部 ></span></div>' +
                        '<div class="task-stats">' +
                            '<div class="task-stat-item"><div class="icon-wrap all">📋</div><div class="info"><div class="value"><span class="current">' + p.taskDone + '</span><span class="separator">/</span><span class="total">' + p.taskTotal + '</span></div><div class="label">全部任务</div></div></div>' +
                            '<div class="task-stat-item"><div class="icon-wrap accept">⏳</div><div class="info"><div class="value">3</div><div class="label">确认中任务</div></div></div>' +
                            '<div class="task-stat-item"><div class="icon-wrap contract">▶</div><div class="info"><div class="value">2</div><div class="label">执行中任务</div></div></div>' +
                        '</div></div>' +
                '</div>' +
                '<div class="card indent-card"><div class="card-title"><span>📝 今日动态</span><span class="more" onclick="go(\'activity-list.html\')">查看全部 ></span></div>' +
                    '<div class="activity-list" id="activityList">' +
                        '<div class="activity-item" onclick="go(\'task-detail.html\')">' +
                            '<div class="activity-header"><div class="activity-avatar" style="background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);">陈</div>' +
                            '<div class="activity-info"><div class="activity-user">陈庄<span class="activity-role-tag project-manager">项目总</span></div><div class="activity-time">01-15 10:30</div></div></div>' +
                            '<div class="activity-content">确认了<span class="activity-stage-tag plumbing">水电</span>开槽布线</div>' +
                            '<div class="activity-media">' +
                                '<div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=120&h=120&fit=crop\') center/cover;"></div>' +
                                '<div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=120&h=120&fit=crop\') center/cover;"></div>' +
                                '<div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=120&h=120&fit=crop\') center/cover; position: relative;"><div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; background: rgba(0,0,0,0.5); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px;">▶</div></div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="activity-item secondary" onclick="go(\'task-detail.html\')">' +
                            '<div class="activity-header"><div class="activity-avatar" style="background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);">张</div>' +
                            '<div class="activity-info"><div class="activity-user">张工长<span class="activity-role-tag foreman">工长</span></div><div class="activity-time">01-15 09:15</div></div></div>' +
                            '<div class="activity-content">完成了<span class="activity-stage-tag plumbing">水电</span>开槽布线 的施工</div>' +
                            '<div class="activity-media">' +
                                '<div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=120&h=120&fit=crop\') center/cover;"></div>' +
                                '<div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1585232351009-aa654f89dfed?w=120&h=120&fit=crop\') center/cover;"></div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="activity-item hidden tertiary" onclick="go(\'task-detail.html\')">' +
                            '<div class="activity-header"><div class="activity-avatar" style="background: linear-gradient(135deg, #13C2C2 0%, #36CFC9 100%);">王</div>' +
                            '<div class="activity-info"><div class="activity-user">王水电<span class="activity-role-tag plumbing-worker">水电工</span></div><div class="activity-time">01-15 08:30</div></div></div>' +
                            '<div class="activity-content">水电改造 已完成</div>' +
                        '</div>' +
                        '<div class="activity-item hidden quaternary" onclick="go(\'contract-detail.html\')">' +
                            '<div class="activity-header"><div class="activity-avatar" style="background: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);">陈</div>' +
                            '<div class="activity-info"><div class="activity-user">陈设计<span class="activity-role-tag designer">设计师</span></div><div class="activity-time">01-15 08:00</div></div></div>' +
                            '<div class="activity-content">设计服务合同签约完成</div>' +
                            '<div class="activity-media"><div class="activity-media-item" style="background: url(\'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=120&h=120&fit=crop\') center/cover;"></div></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="activity-more-btn" id="activityMoreBtn" onclick="toggleActivityList()">' +
                        '<span id="activityMoreText">展开更多</span>' +
                        '<span class="arrow">▼</span>' +
                    '</div>' +
                '</div>' +
                '</div>';
        }

        /* ===================== 渲染：工人详情 ===================== */
        function renderWorker(p) {
            var taskTodos = SHARED.workerTaskTodos.map(function (t) {
                return '<div class="todo-item"' + (t.link ? ' onclick="go(\'' + t.link + '\')" style="cursor:pointer"' : '') + '>' +
                    '<div class="icon" style="background-color:' + t.bg + ';">' + t.icon + '</div>' +
                    '<div class="content"><div class="title">' + t.title + ' <span class="task-tag ' + t.tag + '">' + (t.tag === 'contract' ? '合同' : '任务') + '</span></div>' +
                    '<div class="desc">' + t.desc + '</div></div>' +
                    '<div class="status ' + t.cls + '">' + t.status + '</div></div>';
            }).join('');

            var levels = SHARED.levels.map(function (l, i) {
                var sel = l.name === p.trade + '工作组';
                var icon = l.name === '项目部' ? '🏢' : '⚡';
                return '<div class="level-option' + (sel ? ' selected' : '') + '" onclick="pickLevel(this, event)">' +
                    '<div class="icon">' + icon + '</div>' +
                    '<div class="info"><div class="name">' + l.name + '</div><div class="count">' + l.count + '</div></div>' +
                    '<div class="check" style="visibility:' + (sel ? 'visible' : 'hidden') + ';">✓</div></div>';
            }).join('');

            var contracts = SHARED.contracts.filter(function (c) { return c.name !== '水电班组服务合同'; }).map(function (c) {
                return '<div class="contract-item" onclick="navigate(\'' + c.detail + '\')">' +
                    '<div class="info"><div class="name">' + c.name + '</div><div class="meta-row">' +
                        '<span class="meta">' + c.meta + '</span><span class="action-badge ' + c.badgeCls + '">' + c.badge + '</span></div></div>' +
                    '<div class="progress-wrap"><div class="percent">' + c.percent + '%</div>' +
                    '<div class="bar"><div class="fill" style="width:' + c.percent + '%"></div></div></div></div>';
            }).join('');

            return '<div class="detail-fade">' +
                '<div class="card todo-card worker"><div class="card-title"><span>📋 待办事项</span>' +
                    '<span class="badge-wrap"><span class="badge">' + p.todoCount + '</span></span>' +
                    '<span class="more" onclick="openPage(\'todo-list.html\')">查看全部 ></span></div>' +
                    '<div class="todo-content">' +
                        (p.todoCount === 0 ? '<div class="empty-state" style="font-size:12px;color:#999;padding:8px 0;">暂无待办，休息一下 ☕</div>'
                            : taskTodos) +
                    '</div></div>' +
                '<div class="card my-task-card worker" onclick="openPage(\'task-list.html?role=exec\')"><div class="card-title"><span>📌 我的任务</span><span class="more">查看全部 ></span></div>' +
                    '<div class="my-task-stats">' +
                        '<div class="my-task-stat"><div class="value">' + SHARED.myTasks.worker.done + '</div><div class="label">已完成</div></div>' +
                        '<div class="my-task-divider"></div>' +
                        '<div class="my-task-stat"><div class="value">' + SHARED.myTasks.worker.total + '</div><div class="label">我作为执行人的全部任务</div></div>' +
                    '</div></div>' +
                '<div class="sticky-header" id="stickyHeader">' +
                    '<div class="quick-nav work-quick-nav" id="quickNavWork">' +
                        '<div class="quick-nav-item keep" onclick="go(\'activity-list.html\')"><div class="icon activity">📝</div><div class="label">项目动态</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'architecture.html\')"><div class="icon structure">🏗️</div><div class="label">架构</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'member.html\')"><div class="icon member">👥</div><div class="label">成员</div></div>' +
                        '<div class="quick-nav-item" onclick="go(\'project-files.html\')"><div class="icon file">📁</div><div class="label">资料</div></div></div>' +
                    '<div class="level-selector arch-half" id="levelSelectorWork"><div class="level-dropdown" onclick="toggleLevelOpts(this)">' +
                        '<div class="current"><div class="icon">⚡</div><div>' +
                        '<div class="text-row"><div class="text">' + p.trade + '工作组</div><div class="type-badge workgroup">工作组</div></div>' +
                        '<div class="breadcrumb-inline"><span class="breadcrumb-item">项目部</span><span class="separator">›</span><span class="breadcrumb-item active">' + p.trade + '工作组</span></div>' +
                        '<div class="level-default-hint">默认我的工作组</div></div></div>' +
                        '<div class="arrow">▼</div></div>' +
                        '<div class="level-options">' + levels + '</div></div>' +
                '</div>' +
                '<div class="stats-row"><div class="card contract-half worker"><div class="card-title"><span>📄 合同</span></div>' +
                    '<div class="contract-list show" id="contractListWorker">' + contracts + '</div></div>' +
                    '<div class="card task-half worker"><div class="card-title"><span>📊 任务统计</span><span class="more" onclick="go(\'task-list.html\')">查看全部 ></span></div>' +
                        '<div class="task-stats">' +
                            '<div class="task-stat-item"><div class="icon-wrap all">📋</div><div class="info"><div class="value"><span class="current">' + p.taskDone + '</span><span class="separator">/</span><span class="total">' + p.taskTotal + '</span></div><div class="label">全部任务</div></div></div>' +
                            '<div class="task-stat-item"><div class="icon-wrap accept">⏳</div><div class="info"><div class="value">3</div><div class="label">确认中任务</div></div></div>' +
                            '<div class="task-stat-item"><div class="icon-wrap contract">▶</div><div class="info"><div class="value">2</div><div class="label">执行中任务</div></div></div>' +
                        '</div></div>' +
                '</div>' +
                '</div>';
        }

        /* ===================== 顶部一行：项目名/切换 + 角色摘要 ===================== */
        function renderTopHero(p) {
            var el = document.getElementById('topHero');
            // 非工人视角与工人视角的 proj-info-zone 展示内容保持统一：均用「项目信息」引导文案（点击左侧查看项目信息），避免角色间不一致
            el.textContent = '项目信息';
        }

        /* ===================== 主渲染 ===================== */
        function renderDetail() {
            var p = PROJECTS[currentIndex];
            renderTopHero(p);
            var area = document.getElementById('detailArea');
            area.innerHTML = currentRole === 'nonworker' ? renderNonWorker(p) : renderWorker(p);
        }

        /* ===================== 交互 ===================== */
        function togglePanel() {
            var panel = document.getElementById('projPanel');
            var arrow = document.getElementById('switchArrow');
            var open = panel.classList.toggle('open');
            arrow.classList.toggle('open', open);
        }

        function selectProject(i) {
            currentIndex = i;
            renderSwitchBar();
            renderPanel();
            togglePanel(); // 收起
            renderDetail();
        }

        /* 切换面板：状态筛选（全部 / 进行中 / 已完成） */
        function setPanelFilter(f, el) {
            panelFilter = f;
            var items = document.querySelectorAll('#projPanelFilter .pf-item');
            items.forEach(function (it) { it.classList.remove('active'); });
            if (el) el.classList.add('active');
            renderPanel();
        }

        /* 新建项目：参考「项目列表」创建图标逻辑（认证后跳转 / 未认证弹窗） */
        var isUserCertified = false;
        function createProject() {
            if (isUserCertified) {
                location.href = 'create-project.html';
            } else {
                document.getElementById('authRequiredModal').classList.add('show');
            }
        }
        function closeAuthModal() {
            document.getElementById('authRequiredModal').classList.remove('show');
        }
        function goToAuthPage() {
            closeAuthModal();
            location.href = 'promoter-auth.html';
        }
        function toggleAuthStatus(certified) {
            isUserCertified = certified;
            var statusEl = document.getElementById('authStatus');
            if (certified) {
                statusEl.textContent = '已认证';
                statusEl.classList.add('certified');
            } else {
                statusEl.textContent = '未认证';
                statusEl.classList.remove('certified');
            }
        }

        function toggleRoleSwitch(checked) {
            currentRole = checked ? 'worker' : 'nonworker';
            var statusEl = document.getElementById('roleStatus');
            statusEl.textContent = currentRole === 'worker' ? '工人' : '非工人';
            statusEl.classList.toggle('worker', currentRole === 'worker');
            renderDetail();
        }

        function toggleLevelOpts(el) {
            var box = el.parentElement.querySelector('.level-options');
            var arrow = el.querySelector('.arrow');
            var open = box.classList.toggle('open');
            arrow.classList.toggle('open', open);
        }

        /* 滚动联动：仅维护吸顶阴影（快捷入口常驻一行，不随滚动隐藏） */
        (function initScrollFx() {
            var scroller = document.getElementById('detailArea');
            if (!scroller) return;
            scroller.addEventListener('scroll', function () {
                var top = scroller.scrollTop;
                var sh = document.getElementById('stickyHeader');
                if (sh) {
                    if (top > 4) sh.classList.add('with-shadow');
                    else sh.classList.remove('with-shadow');
                }
            }, { passive: true });
        })();

        function pickLevel(el, e) {
            if (e) e.stopPropagation();
            var opts = el.parentElement.querySelectorAll('.level-option');
            opts.forEach(function (o) {
                o.classList.remove('selected');
                var c = o.querySelector('.check');
                if (c) c.style.visibility = 'hidden';
            });
            el.classList.add('selected');
            var c = el.querySelector('.check');
            if (c) c.style.visibility = 'visible';

            /* 回写顶部「当前层级」展示，并收起下拉框。
               注意：.level-option 与 .level-dropdown 是 .level-selector 下的「兄弟」节点，
               因此不能用 el.closest('.level-dropdown') 查找（会返回 null），需沿 .level-selector 定位。 */
            var selector = el.closest('.level-selector');
            if (!selector) return;
            var dd = selector.querySelector('.level-dropdown');
            if (!dd) return;
            var icon = el.querySelector('.icon') ? el.querySelector('.icon').textContent : '';
            var name = el.querySelector('.info .name') ? el.querySelector('.info .name').textContent : '';
            var isProject = name === '项目部';
            var cur = dd.querySelector('.current');
            if (cur) {
                var ci = cur.querySelector('.icon'); if (ci) ci.textContent = icon;
                var tx = cur.querySelector('.text-row .text'); if (tx) tx.textContent = name;
                var badge = cur.querySelector('.text-row .type-badge');
                if (badge) { badge.textContent = isProject ? '项目部' : '工作组'; badge.className = 'type-badge ' + (isProject ? 'project' : 'workgroup'); }
                var bc = cur.querySelector('.breadcrumb-inline .breadcrumb-item.active'); if (bc) bc.textContent = name;
            }
            var box = selector.querySelector('.level-options');
            if (box) box.classList.remove('open');
            var arrow = dd.querySelector('.arrow');
            if (arrow) arrow.classList.remove('open');
        }

        /* 真实跳转至目标原型页（与「项目详情」页 data-href 机制一致：点击即跳转，不再仅弹提示） */
        function navigate(href) { if (href) window.location.href = href; }
        function go(href) { /* 统一走真实跳转（原占位提示已替换为实际页面导航） */ navigate(href); }
        function openPage(href) { /* 真实跳转至目标原型页（待办事项/我的任务 查看全部 专用） */ window.location.href = href; }

        /* 今日动态：展开 / 收起（与源页「展开更多」一致：默认显示 2 条，展开显示全部 4 条） */
        function toggleActivityList() {
            var list = document.getElementById('activityList');
            var btn = document.getElementById('activityMoreBtn');
            if (!list || !btn) return;
            var expanded = list.classList.toggle('expanded');
            var hidden = list.querySelectorAll('.activity-item.tertiary, .activity-item.quaternary');
            hidden.forEach(function (it) { it.classList.toggle('hidden', !expanded); });
            var txt = document.getElementById('activityMoreText');
            var arrow = btn.querySelector('.arrow');
            if (txt) txt.textContent = expanded ? '收起' : '展开更多';
            if (arrow) arrow.classList.toggle('open', expanded);
        }

        /* 合同概览：查看合同 ▼ 折叠 / 展开合同列表 */
        function toggleContractNW(el) {
            var list = document.getElementById('contractListNW');
            if (!list) return;
            var shown = list.classList.toggle('show');
            if (el) {
                var arrow = el.querySelector('.arrow');
                if (arrow) arrow.classList.toggle('open', shown);
            }
        }

        function viewProjectInfo() {
            // 恢复「点击查看项目信息」：跳转独立的项目信息原型页
            window.location.href = 'project-info.html';
        }

        function showToast(msg) {
            var t = document.createElement('div');
            t.textContent = msg;
            t.style.cssText = 'position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.8);color:#fff;font-size:13px;padding:10px 16px;border-radius:8px;z-index:200;white-space:nowrap;';
            document.querySelector('.phone-frame').appendChild(t);
            setTimeout(function () { t.remove(); }, 1600);
        }

        /* ===================== 点击面板外部自动收起 ===================== */
        document.addEventListener('click', function (e) {
            var panel = document.getElementById('projPanel');
            var topbar = document.querySelector('.topbar');
            if (panel.classList.contains('open') && !topbar.contains(e.target)) {
                togglePanel();
            }
        });

        /* ===================== 初始化 ===================== */
        renderSwitchBar();
        renderPanel();
        renderDetail();
    </script>
</body>
</html>
