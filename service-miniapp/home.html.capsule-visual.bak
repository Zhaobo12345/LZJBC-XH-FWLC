<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>服务方小程序 - 首页</title>
    <link rel="stylesheet" href="common.css">
    <style>
        .page-content {
            height: calc(100% - 44px - 44px - 50px);
        }

        .welcome-card {
            background: linear-gradient(135deg, var(--primary-color) 0%, #096DD9 100%);
            color: #FFFFFF;
        }

        .welcome-card .greeting {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .welcome-card .stats {
            font-size: 12px;
            opacity: 0.9;
        }

        .data-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .data-item {
            background-color: var(--bg-secondary);
            border-radius: 8px;
            padding: 12px;
            text-align: center;
        }

        .data-item .value {
            font-size: 24px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 4px;
        }

        .data-item .label {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .card .project-card {
            margin: 0 0 12px 0;
        }

        .todo-item {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
        }

        .todo-item:last-child {
            border-bottom: none;
        }

        .todo-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .todo-dot.urgent  { background-color: var(--error-color); }
        .todo-dot.warning { background-color: var(--warning-color); }
        .todo-dot.normal  { background-color: var(--success-color); }

        .todo-content { flex: 1; }

        .todo-title {
            font-size: 14px;
            color: var(--text-primary);
        }

        .todo-status {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .quick-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .quick-action .icon {
            width: 48px;
            height: 48px;
            background-color: var(--status-primary-bg);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
            font-size: 24px;
            transition: all 0.2s;
        }

        .quick-action:hover .icon {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .quick-action .label {
            font-size: 12px;
            color: var(--text-secondary);
        }
    </style>
<style>
/* 微信原生胶囊占位（样式参考真机效果，由微信客户端实际渲染） */
    .nav-bar .native-capsule {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        min-width: 56px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.7);
        color: rgba(0, 0, 0, 0.6);
        font-size: 12px;
        line-height: 1;
        user-select: none;
        box-sizing: border-box;
    }
    .nav-bar .native-capsule .nc-left,
    .nav-bar .native-capsule .nc-right {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        min-width: 16px;
    }
    .nav-bar .native-capsule .nc-right {
        font-size: 10px;
    }
    .nav-bar .native-capsule .nc-divider {
        width: 1px;
        height: 14px;
        background: rgba(0, 0, 0, 0.1);
        margin: 0 4px;
    }
</style>
</head>
<body>
    <div class="phone-frame">
        <div class="status-bar">
            <div class="time">9:41</div>
            <div class="icons">📶 🔋</div>
        </div>
        
        <div class="nav-bar">
            <div class="title">🏠 首页</div>
            
            
        
            <div class="actions"><div class="native-capsule" title="微信原生胶囊：由微信客户端渲染，开发者不可自定义其内容"><span class="nc-left">⋯</span><span class="nc-divider"></span><span class="nc-right">○</span></div></div>
        </div>
            

        
        <div class="page-content">
            <div class="card welcome-card">
                <div class="greeting">欢迎回来，张三</div>
                <div class="stats">今日待办：3项  |  本周验收：2项</div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span>📊 数据概览</span>
                </div>
                <div class="data-grid">
                    <div class="data-item">
                        <div class="value">5</div>
                        <div class="label">进行中项目</div>
                    </div>
                    <div class="data-item">
                        <div class="value">12</div>
                        <div class="label">已完成项目</div>
                    </div>
                    <div class="data-item">
                        <div class="value">3</div>
                        <div class="label">待确认任务</div>
                    </div>
                    <div class="data-item">
                        <div class="value">8</div>
                        <div class="label">本月验收</div>
                    </div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span>📋 我的项目</span>
                    <span class="more" onclick="location.href='project-list.html'">查看全部 ></span>
                </div>
                <div class="project-card" onclick="location.href='project-detail.html'">
                    <div class="project-header">
                        <div class="project-name">XX小区整体装修</div>
                        <div class="project-status">进行中</div>
                    </div>
                    <div class="project-info">预算：50万  |  工期：2024-01-01~03-31</div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 65%"></div>
                    </div>
                    <div class="progress-text">进度：65%</div>
                </div>
                <div class="project-card" onclick="location.href='project-detail.html'">
                    <div class="project-header">
                        <div class="project-name">YY花园精装修</div>
                        <div class="project-status">进行中</div>
                    </div>
                    <div class="project-info">预算：35万  |  工期：2024-02-01~04-30</div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 30%"></div>
                    </div>
                    <div class="progress-text">进度：30%</div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span>⏰ 待办事项</span>
                    <span class="more" onclick="location.href='todo-list.html'">查看全部 ></span>
                </div>
                <div class="todo-item" onclick="location.href='task-detail.html'">
                    <div class="todo-dot urgent"></div>
                    <div class="todo-content">
                        <div class="todo-title">水电工程-开槽布线</div>
                        <div class="todo-status">待验收</div>
                    </div>
                </div>
                <div class="todo-item" onclick="location.href='task-detail.html'">
                    <div class="todo-dot warning"></div>
                    <div class="todo-content">
                        <div class="todo-title">泥瓦工程-墙面贴砖</div>
                        <div class="todo-status">待验收</div>
                    </div>
                </div>
                <div class="todo-item" onclick="location.href='task-detail.html'">
                    <div class="todo-dot normal"></div>
                    <div class="todo-content">
                        <div class="todo-title">木工工程-吊顶安装</div>
                        <div class="todo-status">待执行</div>
                    </div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span>🚀 快捷入口</span>
                </div>
                <div class="quick-actions">
                    <div class="quick-action" onclick="location.href='create-project.html'">
                        <div class="icon">📝</div>
                        <div class="label">创建项目</div>
                    </div>
                    <div class="quick-action" onclick="location.href='task-acceptance.html'">
                        <div class="icon">✅</div>
                        <div class="label">申请验收</div>
                    </div>
                    <div class="quick-action" onclick="location.href='contract-detail.html'">
                        <div class="icon">📄</div>
                        <div class="label">查看合同</div>
                    </div>
                    <div class="quick-action" onclick="location.href='project-files.html'">
                        <div class="icon">📁</div>
                        <div class="label">资料库</div>
                    </div>
                </div>
            </div>
            
            <div style="height: 20px;"></div>
        </div>
        
        <div class="tab-bar">
            <div class="tab-item active">
                <div class="icon">🏠</div>
                <div class="label">首页</div>
            </div>
            <div class="tab-item" onclick="location.href='project-list.html'">
                <div class="icon">📋</div>
                <div class="label">项目</div>
            </div>
            <div class="tab-item" onclick="location.href='message.html'">
                <div class="icon">💬</div>
                <div class="label">消息</div>
            </div>
            <div class="tab-item" onclick="showToast('个人中心开发中')">
                <div class="icon">👤</div>
                <div class="label">我的</div>
            </div>
        </div>
    </div>

    <script src="js/page-nav.js"></script>
    <script>
        function showToast(message, duration) {
            duration = duration || 2000;
            var existingToast = document.querySelector('.app-toast');
            if (existingToast) {
                existingToast.remove();
            }
            
            var toast = document.createElement('div');
            toast.className = 'app-toast';
            toast.textContent = message;
            toast.style.cssText = 'position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); background-color: rgba(0, 0, 0, 0.7); color: #FFFFFF; padding: 8px 16px; border-radius: 20px; font-size: 13px; z-index: 10000; white-space: nowrap;';
            document.body.appendChild(toast);
            
            setTimeout(function() {
                toast.remove();
            }, duration);
        }
        
        
        
        function closeActionMenu() {
            var actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.remove('show');
            }
        }
        
        function shareToFriend() {
            showToast('分享给朋友');
            closeActionMenu();
        }
    </script>
</body>
</html>