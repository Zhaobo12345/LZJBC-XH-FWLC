                            </div>
                            <div style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 12px; padding-top: 12px; border-top: 1px dashed #E8E8E8;">
                                <span style="color: var(--success-color); margin-top: 3px;">●</span>
                                <div>
                                    <div style="color: #262626;">2024-02-20 第二次变更生效</div>
                                    <div style="color: #8C8C8C; font-size: 11px;">变更内容：合同金额调整¥10,000</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 12px;">
                                <span style="color: var(--error-color); margin-top: 3px;">●</span>
                                <div>
                                    <div style="color: #262626;">2024-02-10 变更失败</div>
                                    <div style="color: #8C8C8C; font-size: 11px;">对方驳回变更申请</div>
                                </div>
                            </div>
                            <div style="display: flex; align-items: flex-start; gap: 8px; margin-bottom: 12px; padding-top: 12px; border-top: 1px dashed #E8E8E8;">
                                <span style="color: var(--success-color); margin-top: 3px;">●</span>
                                <div>
                                    <div style="color: #262626;">2024-01-15 合同签约完成</div>
                                    <div style="color: #8C8C8C; font-size: 11px;">初始版本正式生效</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="btn confirm" onclick="closeChangeRecordModal()" style="width: 100%;">关闭</div>
                </div>
            </div>
        </div>

        <div class="custom-confirm-modal" id="customConfirmModal">
            <div class="modal-box">
                <div class="modal-header">
                    <div class="modal-title" id="customConfirmTitle">确认提示</div>
                </div>
                <div class="modal-body" id="customConfirmMessage">
                    确定要执行此操作吗？
                </div>
                <div class="modal-footer">
                    <div class="modal-btn cancel" id="customConfirmCancel" onclick="closeCustomConfirm()">取消</div>
                    <div class="modal-btn confirm" id="customConfirmOk" onclick="confirmCustomConfirm()">确定</div>
                </div>
            </div>
        </div>
        
        <div class="custom-toast-modal" id="customToastModal">
            <div class="modal-box">
                <div class="modal-body" id="customToastMessage">
                    操作成功
                </div>
                <div class="modal-footer">
                    <div class="modal-btn" onclick="closeCustomToast()">知道了</div>
                </div>
            </div>
        </div>
        
        <div class="pc-open-modal" id="pcOpenModal">
            <div class="modal-box">
                <div class="modal-header">
                    <div class="modal-title">💻 在电脑端打开</div>
                </div>
                <div class="modal-body">
                    <div class="qr-section">
                        <div class="qr-code">
                            <svg viewBox="0 0 100 100" width="140" height="140">
                                <rect x="10" y="10" width="25" height="25" fill="#333"/>
                                <rect x="65" y="10" width="25" height="25" fill="#333"/>
                                <rect x="10" y="65" width="25" height="25" fill="#333"/>
                                <rect x="15" y="15" width="15" height="15" fill="#fff"/>
                                <rect x="70" y="15" width="15" height="15" fill="#fff"/>
                                <rect x="15" y="70" width="15" height="15" fill="#fff"/>
                                <rect x="18" y="18" width="9" height="9" fill="#333"/>
                                <rect x="73" y="18" width="9" height="9" fill="#333"/>
                                <rect x="18" y="73" width="9" height="9" fill="#333"/>
                                <rect x="40" y="10" width="5" height="5" fill="#333"/>
                                <rect x="50" y="10" width="5" height="5" fill="#333"/>
                                <rect x="40" y="20" width="5" height="5" fill="#333"/>
                                <rect x="45" y="25" width="5" height="5" fill="#333"/>
                                <rect x="55" y="25" width="5" height="5" fill="#333"/>
                                <rect x="40" y="40" width="20" height="20" fill="#333"/>
                                <rect x="45" y="45" width="10" height="10" fill="#fff"/>
                                <rect x="48" y="48" width="4" height="4" fill="#333"/>
                                <rect x="10" y="40" width="5" height="5" fill="#333"/>
                                <rect x="20" y="45" width="5" height="5" fill="#333"/>
                                <rect x="25" y="50" width="5" height="5" fill="#333"/>
                                <rect x="65" y="40" width="5" height="5" fill="#333"/>
                                <rect x="75" y="45" width="5" height="5" fill="#333"/>
                                <rect x="80" y="50" width="5" height="5" fill="#333"/>
                                <rect x="65" y="65" width="5" height="5" fill="#333"/>
                                <rect x="75" y="70" width="5" height="5" fill="#333"/>
                                <rect x="80" y="75" width="5" height="5" fill="#333"/>
                                <rect x="85" y="80" width="5" height="5" fill="#333"/>
                            </svg>
                        </div>
                        <div class="qr-tip">使用微信扫一扫，在电脑端打开</div>
                    </div>
                    <div class="link-section">
                        <div class="link-label">或复制链接在浏览器中打开：</div>
                        <div class="link-box">
                            <div class="link-input" id="pcLink">https://zhaobo12345.github.io/LZJPro/pc-contract-list.html</div>
                            <div class="copy-btn" onclick="copyPcLink()">复制链接</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="modal-btn" onclick="closePcOpenModal()">取消</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="page-nav">
        <div class="page-nav-title">原型导航</div>
        <a href="home.html" class="page-nav-item">首页</a>
        <a href="project-list.html" class="page-nav-item">项目列表</a>
        <a href="project-detail.html" class="page-nav-item">项目详情</a>
        <a href="contract-detail.html" class="page-nav-item">合同详情</a>
        <a href="task-detail.html" class="page-nav-item">任务详情</a>
        <a href="contract-detail.html" class="page-nav-item active">合同详情（合规版）</a>
        <a href="worker-contract-detail.html" class="page-nav-item">工人合同详情（新流程）</a>
        <div style="margin-top: 16px; padding-top: 12px; border-top: 1px solid #E8E8E8;">
            <div class="page-nav-title">合同状态切换</div>
            
            <!-- 草稿阶段 -->
            <div class="status-group">
                <div class="status-group-header" onclick="toggleStatusGroup(this)">
                    <span class="status-group-icon">▼</span>
                    <span class="status-group-title">草稿阶段</span>
                    <span class="status-group-count">3</span>
                </div>
                <div class="status-group-content">
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('draft')">拟定中</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('draft_party_a')">拟定中（甲方）</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('draft_submittable')">拟定中(可提交)</div>
                </div>
            </div>
            
            <!-- 审核阶段 -->
            <div class="status-group">
                <div class="status-group-header" onclick="toggleStatusGroup(this)">
                    <span class="status-group-icon">▶</span>
                    <span class="status-group-title">审核阶段</span>
                    <span class="status-group-count">3</span>
                </div>
                <div class="status-group-content" style="display: none;">
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('platform_reviewing')">待平台审核</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('platform_rejected')">平台审核驳回</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('platform_rejected_modified')">平台驳回(已修改)</div>
                </div>
            </div>
            
            <!-- 确认阶段 -->
            <div class="status-group">
                <div class="status-group-header" onclick="toggleStatusGroup(this)">
                    <span class="status-group-icon">▶</span>
                    <span class="status-group-title">确认阶段</span>
                    <span class="status-group-count">4</span>
                </div>
                <div class="status-group-content" style="display: none;">
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('confirming_sender')">确认中(发起方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('confirming_receiver')">确认中(待确认方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('confirmed')">已确认</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('confirmed_party_a')">已确认（甲方）</div>
                </div>
            </div>
            
            <!-- 签约阶段 -->
            <div class="status-group">
                <div class="status-group-header" onclick="toggleStatusGroup(this)">
                    <span class="status-group-icon">▶</span>
                    <span class="status-group-title">签约阶段</span>
                    <span class="status-group-count">1</span>
                </div>
                <div class="status-group-content" style="display: none;">
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('signed')">已签约</div>
                </div>
            </div>
            
            <!-- 变更阶段 -->
            <div class="status-group">
                <div class="status-group-header" onclick="toggleStatusGroup(this)">
                    <span class="status-group-icon">▶</span>
                    <span class="status-group-title">变更阶段</span>
                    <span class="status-group-count">7</span>
                </div>
                <div class="status-group-content" style="display: none;">
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('changing')">变更中(发起方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_confirming')">变更中(待确认方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_platform_reviewing')">变更审核中</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_platform_rejected')">变更审核驳回</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_confirming_sender')">变更确认中(发起方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_confirming_receiver')">变更确认中(待确认方)</div>
                    <div class="status-switch-item" onclick="ContractDetailPage.updateContractStatus('change_signing_wait')">变更签约中</div>
                </div>
            </div>
        </div>
    </div>
    

    <script src="contract-store.js"></script>
    <script src="js/page-nav.js"></script>
    <script src="js/contract-detail.js"></script>
    <script>
        // 页内「更多」面板控制（v2 示范页专用，不写入任何共享 JS 文件）
        function toggleMoreOps() {
            var p = document.getElementById('moreOpsPanel');
            var b = document.getElementById('moreOpsBtn');
            if (!p) return;
            p.classList.toggle('show');
            if (b) b.classList.toggle('open');
        }

        function closeMoreOps() {
            var p = document.getElementById('moreOpsPanel');
            var b = document.getElementById('moreOpsBtn');
            if (p) p.classList.remove('show');
            if (b) b.classList.remove('open');
        }

        function toggleChangeMoreOps() {
            var p = document.getElementById('changeMoreOpsPanel');
            var b = document.getElementById('changeMoreOpsBtn');
            if (!p) return;
            p.classList.toggle('show');
            if (b) b.classList.toggle('open');
        }

        function closeChangeMoreOps() {
            var p = document.getElementById('changeMoreOpsPanel');
            var b = document.getElementById('changeMoreOpsBtn');
            if (p) p.classList.remove('show');
            if (b) b.classList.remove('open');
        }

        window.toggleMoreOps = toggleMoreOps;
        window.closeMoreOps = closeMoreOps;
        window.toggleChangeMoreOps = toggleChangeMoreOps;
        window.closeChangeMoreOps = closeChangeMoreOps;
    </script>
</body>
</html>
