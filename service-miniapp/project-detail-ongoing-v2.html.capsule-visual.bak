        <a href="task-detail.html" class="page-nav-item">任务详情</a>
    </div>

    <script src="js/page-nav.js"></script>
    <script>
        (function() {
            var pageContent = document.getElementById('pageContent');
            var quickNav = document.getElementById('quickNav');
            var quickNavToggle = document.getElementById('quickNavToggle');
            var toggleText = document.getElementById('toggleText');
            var toggleArrow = document.getElementById('toggleArrow');
            var pinBtn = document.getElementById('pinBtn');
            var levelSelector = document.getElementById('levelSelector');
            var levelOptions = document.getElementById('levelOptions');
            var levelArrow = document.getElementById('levelArrow');
            var levelDropdown = document.getElementById('levelDropdown');
            var levelText = document.getElementById('levelText');
            var levelIcon = document.getElementById('levelIcon');
            var levelType = document.getElementById('levelType');
            var breadcrumbInline = document.getElementById('breadcrumbInline');
            var actionMenu = document.getElementById('actionMenu');
            var customToastModal = document.getElementById('customToastModal');
            var customToastMessage = document.getElementById('customToastMessage');
            var toastCloseBtn = document.getElementById('toastCloseBtn');
            var activityMoreBtn = document.getElementById('activityMoreBtn');

            var quickNavExpanded = true;
            var activityExpanded = false;

            function showCustomToast(message) {
                if (customToastMessage && customToastModal) {
                    customToastMessage.textContent = message;
                    customToastModal.classList.add('show');
                }
            }

            function closeCustomToast() {
                if (customToastModal) customToastModal.classList.remove('show');
            }

            function toggleLevelDropdown() {
                if (!levelOptions || !levelArrow) return;
                if (levelOptions.classList.contains('show')) {
                    levelOptions.classList.remove('show');
                    levelArrow.classList.remove('open');
                    if (pageContent) pageContent.style.overflow = 'auto';
                } else {
                    levelOptions.classList.add('show');
                    levelArrow.classList.add('open');
                    if (pageContent) pageContent.style.overflow = 'hidden';
                }
            }

            function selectLevel(name) {
                if (!name) return;
                if (levelText) levelText.textContent = name;
                if (levelType) {
                    levelType.textContent = '工作组';
                    levelType.className = 'type-badge workgroup';
                }
                if (breadcrumbInline) {
                    breadcrumbInline.innerHTML = '<span class="breadcrumb-item">项目部</span><span class="separator">›</span><span class="breadcrumb-item active">' + name + '</span>';
                }
                var opts = levelOptions ? levelOptions.querySelectorAll('.level-option') : [];
                opts.forEach(function(opt) {
                    var chk = opt.querySelector('.check');
                    if (opt.dataset.level === name) {
                        opt.classList.add('selected');
                        if (chk) chk.style.visibility = 'visible';
                    } else {
                        opt.classList.remove('selected');
                        if (chk) chk.style.visibility = 'hidden';
                    }
                });
                toggleLevelDropdown();
            }

            function toggleQuickNav() {
                if (!quickNav) return;
                if (quickNavExpanded) {
                    quickNav.classList.add('collapsed');
                    if (toggleText) toggleText.textContent = '展开快捷入口';
                    if (toggleArrow) toggleArrow.classList.remove('expanded');
                    quickNavExpanded = false;
                } else {
                    quickNav.classList.remove('collapsed');
                    if (toggleText) toggleText.textContent = '收起快捷入口';
                    if (toggleArrow) toggleArrow.classList.add('expanded');
                    quickNavExpanded = true;
                }
            }

            function toggleActivityList() {
                var hiddenItems = document.querySelectorAll('.activity-item.hidden');
                if (activityExpanded) {
                    hiddenItems.forEach(function(item) { item.classList.add('hidden'); });
                    activityExpanded = false;
                } else {
                    document.querySelectorAll('.activity-item').forEach(function(item) { item.classList.remove('hidden'); });
                    activityExpanded = true;
                }
            }

            function navigate(href) {
                if (href) window.location.href = href;
            }

            // 事件绑定
            if (quickNav) {
                quickNav.addEventListener('click', function(e) {
                    var item = e.target.closest('.quick-nav-item');
                    if (item) { navigate(item.dataset.href); return; }
                    var pin = e.target.closest('.pin-btn');
                    if (pin) {
                        if (quickNav.classList.contains('pinned')) {
                            quickNav.classList.remove('pinned');
                            pin.textContent = '📌 固定';
                        } else {
                            quickNav.classList.add('pinned');
                            pin.textContent = '📌 取消固定';
                        }
                    }
                });
            }

            if (quickNavToggle) quickNavToggle.addEventListener('click', toggleQuickNav);

            if (levelSelector) {
                levelSelector.addEventListener('click', function(e) {
                    var dropdown = e.target.closest('.level-dropdown');
                    if (dropdown) { toggleLevelDropdown(); return; }
                    var opt = e.target.closest('.level-option');
                    if (opt) selectLevel(opt.dataset.level);
                });
            }

            if (actionMenu) {
                actionMenu.addEventListener('click', function(e) {
                    var item = e.target.closest('.action-menu-item');
                    if (item) showCustomToast(item.textContent.trim());
                });
            }

            if (toastCloseBtn) toastCloseBtn.addEventListener('click', closeCustomToast);

            ;

            var backBtn = document.querySelector('.nav-bar .back');
            if (backBtn) backBtn.addEventListener('click', function() { history.back(); });

            document.addEventListener('click', function(e) {
                if (levelSelector && !levelSelector.contains(e.target)) {
                    if (levelOptions) levelOptions.classList.remove('show');
                    if (levelArrow) levelArrow.classList.remove('open');
                }
                if (actionMenu && !e.target.closest('.actions') && !e.target.closest('.action-menu')) {
                    actionMenu.classList.remove('show');
                }
            });

            // data-href 跳转（合同项、待办项、动态项、更多链接）
            document.querySelectorAll('[data-href]').forEach(function(el) {
                el.addEventListener('click', function() { navigate(el.dataset.href); });
            });

            // 合同概览「查看合同」展开/收起
            var contractMore = document.querySelector('.card.contract-half .more');
            var contractList = document.getElementById('contractList');
            if (contractMore && contractList) {
                contractMore.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (contractList.classList.contains('show')) {
                        contractList.classList.remove('show');
                        var arr = contractMore.querySelector('.arrow');
                        if (arr) arr.classList.remove('expanded');
                    } else {
                        contractList.classList.add('show');
                        var arr = contractMore.querySelector('.arrow');
                        if (arr) arr.classList.add('expanded');
                    }
                });
            }

            if (activityMoreBtn) activityMoreBtn.addEventListener('click', toggleActivityList);
        })();
    </script>
</body>
</html>
