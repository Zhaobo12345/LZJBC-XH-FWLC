                    <span>📝 今日动态</span>
                    <span class="more" data-action="activity-list">查看全部 ></span>
                </div>
                <div class="activity-list" id="activityList">
                    <div class="activity-item" data-href="task-detail.html">
                        <div class="activity-header">
                            <div class="activity-avatar">李</div>
                            <div class="activity-info">
                                <div class="activity-user">李监理</div>
                                <div class="activity-time">01-15 10:30</div>
                            </div>
                        </div>
                        <div class="activity-content">完成了 开槽布线 的验收</div>
                        <div class="activity-media">
                            <div class="activity-media-item" style="background: url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=120&h=120&fit=crop') center/cover; border-radius: 6px;"></div>
                            <div class="activity-media-item" style="background: url('https://images.unsplash.com/photo-1621905252507-b35492cc74b4?w=120&h=120&fit=crop') center/cover; border-radius: 6px;"></div>
                            <div class="activity-media-item video" style="background: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=120&h=120&fit=crop') center/cover; border-radius: 6px; position: relative;">
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; background: rgba(0,0,0,0.5); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px;">▶</div>
                            </div>
                        </div>
                    </div>
                    <div class="activity-item secondary" data-href="task-detail.html">
                        <div class="activity-header">
                            <div class="activity-avatar" style="background: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);">张</div>
                            <div class="activity-info">
                                <div class="activity-user">张工长</div>
                                <div class="activity-time">01-15 09:15</div>
                            </div>
                        </div>
                        <div class="activity-content">提交了 开槽布线 的验收申请</div>
                        <div class="activity-media">
                            <div class="activity-media-item" style="background: url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=120&h=120&fit=crop') center/cover; border-radius: 6px;"></div>
                            <div class="activity-media-item" style="background: url('https://images.unsplash.com/photo-1585232351009-aa654f89dfed?w=120&h=120&fit=crop') center/cover; border-radius: 6px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div style="height: 20px;"></div>
        </div>

        <div class="custom-toast-modal" id="customToastModal">
            <div class="modal-box">
                <div class="modal-body" id="customToastMessage">
                    操作成功
                </div>
                <div class="modal-footer">
                    <div class="modal-btn" id="toastCloseBtn">知道了</div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-nav">
        <div class="page-nav-title">原型导航</div>
        <a href="home.html" class="page-nav-item">首页</a>
        <a href="project-list.html" class="page-nav-item">项目列表</a>
        <a href="project-detail.html" class="page-nav-item">项目详情（进行中）</a>
        <a href="project-detail-ongoing-v2.html" class="page-nav-item active">项目详情（进行中-新版）</a>
        <a href="project-detail-completed.html" class="page-nav-item">项目详情（已完成）</a>
        <a href="project-info.html" class="page-nav-item">项目信息</a>
        <a href="architecture.html" class="page-nav-item">项目架构</a>
        <a href="create-project.html" class="page-nav-item">创建项目</a>
