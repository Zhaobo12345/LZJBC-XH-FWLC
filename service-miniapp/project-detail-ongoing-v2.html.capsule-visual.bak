<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>家装平台小程序原型 - 项目详情（进行中-新版）</title>
    <link rel="stylesheet" href="common.css">
    <link rel="stylesheet" href="css/project-detail.css">
    <style>
        /* 项目基本信息头部（参考上传图片效果：左「新家已开工 N 天」、右「面积户型」） */
        .project-basic-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
        }

        .project-basic-header .left-info {
            font-size: 14px;
            color: var(--text-primary);
            font-weight: 500;
        }

        .project-basic-header .left-info .highlight {
            color: var(--orange-color);
            font-weight: 700;
            font-size: 18px;
            margin: 0 2px;
        }

        .project-basic-header .right-wrap {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .project-basic-header .right-info {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            font-size: 12px;
            color: var(--text-secondary);
            background-color: var(--bg-secondary);
        }

        /* 整块可点击跳转「项目信息」页 */
        .project-basic-header.clickable {
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .project-basic-header.clickable:active {
            background-color: var(--bg-secondary);
        }

        .project-basic-header .enter-arrow {
            font-size: 18px;
            line-height: 1;
            color: var(--text-tertiary, #C0C4CC);
            font-weight: 400;
        }

        /* 快捷入口改为 4 项（「项目信息」入口已由顶部基本信息区承载，避免重复） */
        .quick-nav {
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            padding-left: 20px;
            padding-right: 20px;
        }

        /* 架构选择区域（level-selector）高度减少一半 */
        .level-selector.arch-half {
            padding: 4px 12px;
        }

        .level-selector.arch-half .level-dropdown .current .icon {
            width: 24px;
            height: 24px;
            font-size: 12px;
        }

        .level-selector.arch-half .level-dropdown .text {
            font-size: 13px;
        }

        /* 合同概览卡片高度减少一半（统计项改为横向排列，内容自适应总高度） */
        .card.contract-half {
            padding: 6px 8px;
            margin-bottom: 8px;
        }

        .card.contract-half .card-title {
            margin-bottom: 0;
            font-size: 13px;
        }

        .card.contract-half .contract-summary {
            padding: 2px 0;
        }

        .card.contract-half .contract-stat {
            flex-direction: row;
            align-items: baseline;
            justify-content: center;
            gap: 4px;
        }

        .card.contract-half .contract-stat .value {
            font-size: 13px;
            line-height: 1.1;
        }

        .card.contract-half .contract-stat .label {
            font-size: 10px;
            margin-top: 0;
        }

        .card.contract-half .contract-list.show {
            max-height: 88px;
            overflow-y: auto;
        }

        .card.contract-half .contract-item {
            padding: 3px 0;
        }

        .card.contract-half .contract-item .name {
            font-size: 12px;
            line-height: 1.2;
        }

        .card.contract-half .contract-item .meta {
            font-size: 10px;
            margin-top: 0;
        }

        .card.contract-half .contract-item .percent {
            font-size: 12px;
            line-height: 1.2;
        }

        .card.contract-half .contract-item .bar {
            margin-top: 1px;
        }

        /* 任务统计卡片高度减少一半（图标与文字改为横向排列，内容自适应总高度） */
        .card.task-half {
            padding: 6px 8px;
            margin-bottom: 8px;
        }

        .card.task-half .card-title {
            margin-bottom: 0;
            font-size: 13px;
        }

        .card.task-half .task-stats {
            gap: 4px;
        }

        .card.task-half .task-stat-item {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 2px;
        }

        .card.task-half .task-stat-item .icon-wrap {
            width: 20px;
            height: 20px;
            font-size: 10px;
            margin-bottom: 0;
        }

        .card.task-half .task-stat-item .info {
            flex: 0 1 auto;
            text-align: left;
        }

        .card.task-half .task-stat-item .value {
            font-size: 12px;
            line-height: 1.1;
        }

        .card.task-half .task-stat-item .label {
            font-size: 9px;
            margin-top: 0;
        }
    </style>
<style>
/* 微信原生胶囊占位（样式参考真机效果，由微信客户端实际渲染） */
    .nav-bar .native-capsule {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        min-width: 56px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.7);
        color: rgba(0, 0, 0, 0.6);
        font-size: 12px;
        line-height: 1;
        user-select: none;
        box-sizing: border-box;
    }
    .nav-bar .native-capsule .nc-left,
    .nav-bar .native-capsule .nc-right {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        min-width: 16px;
    }
    .nav-bar .native-capsule .nc-right {
        font-size: 10px;
    }
    .nav-bar .native-capsule .nc-divider {
        width: 1px;
        height: 14px;
        background: rgba(0, 0, 0, 0.1);
        margin: 0 4px;
    }
</style>
</head>
<body>
    <div class="phone-frame">
        <div class="status-bar">
            <div class="time">9:41</div>
            <div class="icons">📶 🔋</div>
        </div>

        <div class="nav-bar">
            <div class="back">← 返回</div>
            <div class="title centered">XX小区整体装修</div>
            
            
        
            <div class="actions"><div class="native-capsule" title="微信原生胶囊：由微信客户端渲染，开发者不可自定义其内容"><span class="nc-left">⋯</span><span class="nc-divider"></span><span class="nc-right">○</span></div></div>
        </div>
            


        <div class="page-content" id="pageContent">
            <div class="loading-overlay" id="loadingOverlay" style="display:none;">
                <div class="loading-spinner"></div>
                <div class="loading-text">加载中...</div>
            </div>

            <!-- 项目基本信息（参考图片效果，置于最上方；整块可点击跳转项目信息页） -->
            <div class="project-basic-header clickable" data-href="project-info.html">
                <div class="left-info">
                    新家已开工<span class="highlight">60</span>天
                </div>
                <div class="right-wrap">
                    <div class="right-info">
                        75.0m² 2室1厅
                    </div>
                    <span class="enter-arrow">›</span>
                </div>
            </div>

            <!-- 快捷入口：架构、成员、资料库、对账单 -->
            <div class="sticky-header" id="stickyHeader">
                <div class="quick-nav" id="quickNav">
                    <div class="pin-btn" id="pinBtn">📌 固定</div>
                    <div class="quick-nav-item" data-href="architecture.html">
                        <div class="icon structure">🏗️</div>
