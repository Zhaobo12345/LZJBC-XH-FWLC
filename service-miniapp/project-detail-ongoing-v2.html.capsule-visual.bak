                                <div class="count">4个工作组 · 8份合同</div>
                            </div>
                            <div class="check" style="visibility:visible;">✓</div>
                        </div>
                        <div class="level-option" data-level="水电工作组">
                            <div class="icon">⚡</div>
                            <div class="info">
                                <div class="name">水电工作组</div>
                                <div class="count">3个施工组 · 2份合同</div>
                            </div>
                            <div class="check" style="visibility:hidden;">✓</div>
                        </div>
                        <div class="level-option" data-level="泥瓦工作组">
                            <div class="icon">⚡</div>
                            <div class="info">
                                <div class="name">泥瓦工作组</div>
                                <div class="count">2个施工组 · 1份合同</div>
                            </div>
                            <div class="check" style="visibility:hidden;">✓</div>
                        </div>
                        <div class="level-option" data-level="木工工作组">
                            <div class="icon">⚡</div>
                            <div class="info">
                                <div class="name">木工工作组</div>
                                <div class="count">2个施工组 · 1份合同</div>
                            </div>
                            <div class="check" style="visibility:hidden;">✓</div>
                        </div>
                        <div class="level-option" data-level="油漆工作组">
                            <div class="icon">⚡</div>
                            <div class="info">
                                <div class="name">油漆工作组</div>
                                <div class="count">1个施工组 · 1份合同</div>
                            </div>
                            <div class="check" style="visibility:hidden;">✓</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 待办事项（置于合同概览上方，默认展示三条） -->
            <div class="card">
                <div class="card-title">
                    <span>📋 待办事项</span>
                    <span class="badge-wrap"><span class="badge" id="todoBadge">3</span></span>
                    <span class="more" data-href="todo-list.html">查看全部 ></span>
                </div>
                <div class="todo-content show" id="todoContent">
                    <div class="todo-item" data-href="contract-detail.html?status=confirming_receiver">
                        <div class="icon" style="background-color: #E6F7FF;">🔵</div>
                        <div class="content">
                            <div class="title">泥瓦分包合同确认 <span class="task-tag contract">合同</span></div>
                            <div class="desc">泥瓦工作组 | 待确认</div>
                        </div>
                        <div class="status urgent">待确认</div>
                    </div>
                    <div class="todo-item" data-href="contract-detail.html?status=signing">
                        <div class="icon" style="background-color: #E6F7FF;">🔵</div>
                        <div class="content">
                            <div class="title">木工分包合同签约 <span class="task-tag contract">合同</span></div>
                            <div class="desc">木工工作组 | 待签约</div>
                        </div>
                        <div class="status pending">待确认</div>
                    </div>
                    <div class="todo-item" data-href="task-detail.html?status=in_progress">
                        <div class="icon" style="background-color: #FFF7E6;">🟡</div>
                        <div class="content">
                            <div class="title">吊顶安装 <span class="task-tag task">任务</span></div>
                            <div class="desc">木工工作组 | 张三执行中</div>
                        </div>
                        <div class="status in-progress">执行中</div>
                    </div>
                </div>
            </div>

            <!-- 合同概览（高度减半） -->
            <div class="card contract-half">
                <div class="card-title">
                    <span>📄 合同概览</span>
                    <span class="more">
                        查看合同
                        <span class="arrow">▼</span>
                    </span>
                </div>
                <div class="contract-summary">
                    <div class="contract-stat">
                        <div class="value"><span class="current">6</span><span class="separator">/</span><span class="total">8</span></div>
                        <div class="label">合同签约</div>
                    </div>
                    <div class="contract-stat">
                        <div class="value"><span class="current">65</span><span class="total">%</span></div>
                        <div class="label">总进度</div>
                    </div>
                </div>
                <div class="contract-list" id="contractList">
                    <div style="margin-top: 2px; padding-top: 2px; border-top: 1px solid #E8E8E8;">
                        <div class="contract-item" data-href="contract-detail.html?status=draft">
                            <div class="info">
                                <div class="name">水电分包合同</div>
                                <div class="meta">水电工作组 | 金额：8万</div>
                            </div>
                            <div class="progress-wrap">
                                <div class="percent">65%</div>
                                <div class="bar"><div class="fill" style="width: 65%;"></div></div>
                            </div>
                        </div>
                        <div class="contract-item" data-href="contract-detail.html?status=confirming_sender">
                            <div class="info">
                                <div class="name">泥瓦分包合同</div>
                                <div class="meta">泥瓦工作组 | 金额：12万</div>
                            </div>
                            <div class="progress-wrap">
                                <div class="percent">30%</div>
                                <div class="bar"><div class="fill" style="width: 30%;"></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 任务统计（高度减半） -->
            <div class="card task-half">
                <div class="card-title">
                    <span>📊 任务统计</span>
                    <span class="more" data-href="task-list.html">查看全部 ></span>
                </div>
                <div class="task-stats">
                    <div class="task-stat-item">
                        <div class="icon-wrap all">📋</div>
                        <div class="info">
                            <div class="value"><span class="current" id="overallCompleted">18</span><span class="separator">/</span><span class="total" id="overallTotal">24</span></div>
                            <div class="label">全部任务</div>
                        </div>
                    </div>
                    <div class="task-stat-item">
                        <div class="icon-wrap accept">⏳</div>
                        <div class="info">
