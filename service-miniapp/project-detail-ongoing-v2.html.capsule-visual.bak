                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                        </div>
                        <span id="toggleText">展开快捷入口</span>
                        <span class="arrow" id="toggleArrow">▼</span>
                    </div>
                </div>

                <!-- 架构选择区域（高度减半） -->
                <div class="level-selector arch-half" id="levelSelector">
                    <div class="level-dropdown" id="levelDropdown">
