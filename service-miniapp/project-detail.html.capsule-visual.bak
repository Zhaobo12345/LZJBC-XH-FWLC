    </div>
    
    <div class="demo-control-panel" id="statementDemoPanel">
        <div class="panel-title">对账单演示控制</div>
        <div class="control-label">是否有全部权限</div>
        <div class="segmented-control" id="permSeg">
            <div class="segment active" data-perm="no" onclick="setStatementPermission(false)">否</div>
            <div class="segment" data-perm="yes" onclick="setStatementPermission(true)">是</div>
        </div>
        <div class="status-text denied" id="permStatus">否：无权限查看对账单</div>
    </div>
    <script>
        // 对账单权限演示控制：默认无全部权限
        window.statementDemoEnabled = true;
        window.hasFullPermission = false;
        function setStatementPermission(hasAll) {
            window.hasFullPermission = hasAll;
            var segs = document.querySelectorAll('#permSeg .segment');
            for (var i = 0; i < segs.length; i++) {
                segs[i].classList.toggle('active', (segs[i].dataset.perm === 'yes') === hasAll);
            }
            var status = document.getElementById('permStatus');
            if (hasAll) {
                status.textContent = '是：可查看对账单';
                status.className = 'status-text granted';
            } else {
                status.textContent = '否：无权限查看对账单';
                status.className = 'status-text denied';
            }
        }
    </script>

