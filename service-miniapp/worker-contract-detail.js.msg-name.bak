                { name: '布管布线阶段', order: '顺序执行', tasks: [ { name: '开槽布管', exec: '张水电', conf: '陈业主' }, { name: '穿线接线', exec: '张水电', conf: '陈业主' }, { name: '阶段确认', exec: '张水电', conf: '陈业主' } ] },
