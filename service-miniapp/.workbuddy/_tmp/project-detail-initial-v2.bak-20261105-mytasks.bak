<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="VGBHf9cHswZjsVX36iuS6z">
<head data-page-node-id="RUl6HTP7NPFTy4EizYDyFW">
    <meta charset="UTF-8" data-page-node-id="8J4FSQNBUbXynVCHO3UHOT">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" data-page-node-id="mBcy1pxXdh31EeMShoNldl">
    <title>家装平台小程序原型 - 项目详情（初始-新版）</title>
    <style>
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        /* 手机端小程序规范：隐藏所有滚动条（手机框内详情滚动、下拉面板、原型导航等） */
        ::-webkit-scrollbar { width: 0 !important; height: 0 !important; display: none !important; }
        * { -ms-overflow-style: none; scrollbar-width: none; }
        :root {
            --primary: #1677ff; --primary-bg: #e8f1ff; --primary-light: #4096ff;
            --success: #2f9e2f; --success-bg: #eaf7e8; --warning: #fa8c16; --warning-bg: #fff7e6;
            --danger: #f5544f; --danger-bg: #fff2f0; --orange: #fa541c;
            --text: #1f2a3d; --text-2: #5a6b85; --text-3: #93a1b5; --bg: #eef4ff;
            --card: #fff; --border: #e2eaf8; --shadow: 0 2px 12px rgba(22,119,255,.07);
            /* 原型导航（common.css）规范变量，用于与其他页面原型导航样式统一 */
            --primary-color: #1890FF; --bg-primary: #FFFFFF; --bg-secondary: #f3f7ff;
            --text-primary: #262626; --text-secondary: #595959; --text-tertiary: #8C8C8C; --shadow-md: rgba(0,0,0,0.1);
            /* 与 project-detail.css 对齐的渐变色（快捷入口图标用） */
            --gradient-blue: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
            --gradient-green: linear-gradient(135deg, #52C41A 0%, #73D13D 100%);
            --gradient-orange: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
            --gradient-purple: linear-gradient(135deg, #722ED1 0%, #9254DE 100%);
            --gradient-gold: linear-gradient(135deg, #FAAD14 0%, #FFC53D 100%);
            --gradient-cyan: linear-gradient(135deg, #13C2C2 0%, #36CFC9 100%);
            /* 新版服务流程模块（移植自 project-list.html SSOT）所需令牌 */
            --primary-deep: #0b57d0;
            --grad-brand: linear-gradient(135deg, #1e7dff 0%, #0b57d0 100%);
            --line-light: #eef3fb; --flow-bg: #f6faff; --dot-ring: #d8e3f5; --demo-blue: #1677ff;
            --r-card: 12px; --r-block: 8px; --r-pill: 999px;
            --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 20px;
            --fs-11: 11px; --fs-12: 12px; --fs-13: 13px; --fs-15: 15px; --fs-17: 17px;
        
            --bg-grad: linear-gradient(180deg, #e8f1ff 0%, #f2f6ff 26%, #f7faff 100%);
            --shadow-2: 0 8px 24px rgba(22,119,255,.14);
}
        body {
            margin: 0; background: linear-gradient(160deg, #d7e1f2 0%, #e9eef8 100%); color: var(--text); min-height: 100vh;
            font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
            display: flex; align-items: flex-start; justify-content: center; padding: 24px; gap: 16px;
        }

        /* ===== 手机框 ===== */
        .phone-frame {
            width: 375px; height: 812px; background: var(--bg-grad);
            border-radius: 40px; overflow: hidden; position: relative; flex-shrink: 0;
            border: 10px solid #1a1a1a;
            box-shadow: 0 12px 40px rgba(0,0,0,.25); display: flex; flex-direction: column;
        }
        .stage { position: relative; flex-shrink: 0; }
        .status-bar {
            height: 44px; background: var(--grad-brand); display: flex; align-items: center;
            justify-content: space-between; padding: 0 22px; font-size: 14px;
            font-weight: 600; color: #fff; flex-shrink: 0;
        }
.status-bar .icons { filter: grayscale(1) brightness(0) invert(1); opacity: .95; }
        .nav-bar {
            height: 44px; background: var(--grad-brand); display: flex; align-items: center;
            position: relative; box-shadow: 0 2px 10px rgba(11,87,208,.18); flex-shrink: 0;
        }
        .nav-bar .nb-back { position: absolute; left: 14px; font-size: 26px; line-height: 1; color: #1a1a1a; text-decoration: none; }
        .nav-bar .title { flex: 1; text-align: center; font-size: 17px; font-weight: 600; color: #fff;  padding: 0 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .nav-bar .nb-actions { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; }
        /* 微信原生胶囊占位（与项目列表页一致：由微信客户端渲染，开发者不可自定义其内容） */
        .nav-bar .native-capsule {
            display: inline-flex; align-items: center; justify-content: space-between;
            min-width: 56px; height: 28px; padding: 0 10px;
            border: 1px solid rgba(255,255,255,.5); border-radius: 14px;
            background: rgba(255,255,255,.22); color: #fff;
            font-size: 12px; line-height: 1; user-select: none; box-sizing: border-box;
        }
        .nav-bar .native-capsule .nc-left,
        .nav-bar .native-capsule .nc-right { display: inline-flex; align-items: center; justify-content: center; flex: 1; min-width: 16px; }
        .nav-bar .native-capsule .nc-right { font-size: 10px; }
        .nav-bar .native-capsule .nc-divider { width: 1px; height: 14px; background: rgba(255,255,255,.45); margin: 0 4px; }

        /* ===== 顶部：项目切换条 + 角色分段 ===== */
        .topbar {
            flex-shrink: 0; background: #fff; border-bottom: 1px solid var(--line-light);
            padding: 8px 12px; display: flex; align-items: center; gap: 10px; position: relative; z-index: 30;
        }
        .proj-switch {
            flex: 1; display: flex; align-items: stretch;
            background: #f5f7fa; border: 1px solid #e8edf3; border-radius: 12px; overflow: hidden;
        }
        .proj-info-zone {
            flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; cursor: pointer;
            padding: 8px 10px; transition: background .15s;
        }
        .proj-info-zone:active { background: #eef2f7; }
        .proj-info-zone .info-arrow { font-size: 18px; color: var(--text-3); flex: 0 0 auto; line-height: 1; }
        .proj-switch-left { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 0 1 auto; }
        .proj-name { font-size: 14px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 110px; }
        .proj-status { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--primary-bg); color: var(--primary); flex: 0 0 auto; }
        .proj-switch-hero { flex: 1 1 auto; min-width: 0; text-align: right; font-size: 12px; color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
        .proj-switch-hero b { color: var(--primary); font-weight: 700; font-size: 14px; }
        .proj-status.done { background: var(--success-bg); color: var(--success); }
        .proj-switch-right {
            display: flex; align-items: center; gap: 4px; flex: 0 0 auto; cursor: pointer;
            padding: 8px 12px; border-left: 1px solid #e3e8ef; background: #fafbfc; transition: background .15s;
        }
        .proj-switch-right:active { background: #eef2f7; }
        .switch-hint { font-size: 11px; color: var(--text-3); }
        .switch-arrow { font-size: 12px; color: var(--text-3); transition: transform .25s; }
        .switch-arrow.open { transform: rotate(180deg); }

        /* ===== 项目下拉面板 ===== */
        .proj-panel {
            position: absolute; left: 0; right: 0; top: 100%; background: #fff;
            max-height: 0; overflow: hidden; transition: max-height .3s ease; z-index: 25;
            box-shadow: 0 8px 20px rgba(0,0,0,.12); border-radius: 0 0 16px 16px;
        }
        .proj-panel.open { max-height: 460px; display: flex; flex-direction: column; overflow: hidden; }
        .proj-panel-inner { flex: 1; min-height: 0; overflow-y: auto; padding: 8px 12px 12px; }
        .proj-option {
            border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; cursor: pointer;
            transition: all .15s; background: #fff;
        }
        .proj-option:active { background: #f5f7fa; }
        .proj-option.active { border-color: var(--primary); background: #f5faff; }
        .po-top { display: flex; align-items: center; justify-content: space-between; }
        .po-name { font-size: 14px; font-weight: 600; color: var(--text); }
        .po-status { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: var(--primary-bg); color: var(--primary); }
        .po-status.done { background: var(--success-bg); color: var(--success); }
        .po-addr { font-size: 12px; color: var(--text-3); margin: 4px 0; }
        .po-stats { display: flex; gap: 14px; font-size: 12px; color: var(--text-2); margin-bottom: 6px; }
        .po-bar { height: 4px; background: #eef0f3; border-radius: 2px; overflow: hidden; }
        .po-bar-fill { height: 100%; background: var(--primary); border-radius: 2px; }
        /* ===== 切换面板：状态筛选胶囊 + 新建项目 ===== */
        .proj-panel-filter { flex-shrink: 0; display: flex; gap: 6px; padding: 8px 12px 6px; border-bottom: 1px solid var(--border); background: #fff; }
        .pf-item {
            flex: 1; text-align: center; font-size: 12px; padding: 5px 0; border-radius: 8px;
            background: #f2f4f7; color: var(--text-2); cursor: pointer; transition: all .15s;
        }
        .pf-item.active { background: #333; color: #fff; font-weight: 600; }
        .proj-panel-foot {
            flex-shrink: 0; padding: 8px 12px 10px;
            border-top: 1px solid var(--border); background: #fff;
            box-shadow: 0 -2px 8px rgba(0,0,0,.04);
        }
        .proj-new-btn {
            width: 100%; padding: 9px; border: none; border-radius: 10px;
            background: var(--primary); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
            transition: opacity .15s;
        }
        .proj-new-btn:active { opacity: .85; }
        .proj-empty { text-align: center; font-size: 12px; color: #999; padding: 18px 0; }

        /* ===== 详情滚动区 ===== */
        .detail-scroll { flex: 1; overflow-y: auto; padding: 10px 12px 56px; position: relative; }
        .detail-fade { animation: fadeUp .28s ease both; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

        /* ===== 项目基本信息头（沿用项目列表页规范，状态徽标取自项目主体状态） ===== */
        .project-basic-header {
            background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%); color: #fff; border-radius: 14px;
            padding: 10px 14px; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; cursor: pointer;
            box-shadow: 0 4px 14px rgba(22,119,255,.25);
        }
        .project-basic-header.new-project {
            background: linear-gradient(135deg, #FFF7E6 0%, #FFE4BA 100%);
            box-shadow: 0 4px 14px rgba(250,140,22,.18);
        }
        .project-basic-header .left-info { font-size: 14px; font-weight: 500; }
        .project-basic-header .left-info .highlight { font-size: 18px; font-weight: 800; color: var(--primary); margin: 0 2px; }
        .project-basic-header.new-project .left-info { color: #874D00; font-weight: 600; }
        .project-basic-header.new-project .left-info .highlight { color: #FA8C16; }
        .project-basic-header .right-wrap { display: flex; align-items: center; gap: 6px; }
        .project-basic-header .right-info { font-size: 13px; opacity: .95; }
        .project-basic-header.new-project .right-info { color: #874D00; }
        .project-basic-header .enter-arrow { font-size: 18px; opacity: .9; }
        .project-basic-header.new-project .enter-arrow { color: #FA8C16; }

        /* ===== 通用卡片 ===== */
        .card {
            background: var(--card); border: 1px solid var(--border); border-radius: var(--r-card); padding: 10px 12px; margin-bottom: 8px; box-shadow: var(--shadow);
        }
        .card-title {
            display: flex; align-items: center; font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 7px; gap: 6px;
        }
        .card-title .badge-wrap { display: inline-flex; }
        .card-title .badge {
            background: var(--danger-bg); color: var(--danger); font-size: 11px; font-weight: 600;
            min-width: 18px; height: 18px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; padding: 0 5px;
        }
        .card-title .more { margin-left: auto; font-size: 12px; color: var(--text-3); font-weight: 400; }

        /* ===== 待办 ===== */
        .todo-content { }
        .todo-item { display: flex; align-items: center; gap: 10px; padding: 7px 0; border-bottom: 1px solid #f5f5f5; }
        .todo-item:last-child { border-bottom: none; }
        .todo-item .icon { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex: 0 0 auto; }
        .todo-item .content { flex: 1; min-width: 0; }
        .todo-item .title { font-size: 13px; color: var(--text); font-weight: 500; display: flex; align-items: center; gap: 6px; }
        .todo-item .desc { font-size: 11px; color: var(--text-3); margin-top: 3px; }
        .todo-item .status { font-size: 11px; padding: 3px 9px; border-radius: 10px; flex: 0 0 auto; font-weight: 500; }
        .status.urgent { background: var(--danger-bg); color: var(--danger); }
        .status.pending { background: var(--warning-bg); color: var(--warning); }
        .status.in-progress { background: var(--primary-bg); color: var(--primary); }
        .task-tag { font-size: 10px; padding: 1px 6px; border-radius: 4px; font-weight: 500; }
        .task-tag.contract { background: #e6f7ff; color: #1677ff; }
        .task-tag.task { background: #f6ffed; color: #52c41a; }

        /* ===== 吸顶快捷入口 + 架构（与 project-list 对齐） ===== */
        .sticky-header {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.92);
            -webkit-backdrop-filter: saturate(180%) blur(12px);
            backdrop-filter: saturate(180%) blur(12px);
            border-radius: 0 0 14px 14px;
            padding: 5px 10px; margin-bottom: 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,.06);
            transition: box-shadow .25s;
        }
        .sticky-header.with-shadow { box-shadow: 0 4px 16px rgba(0,0,0,.08); }

        /* ===== 快捷入口：4 项，与项目主页（进行中）一致 ===== */
        .quick-nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); }
        .quick-nav .qn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: 40px; border-radius: var(--r-block); background: #fff; border: 1px solid var(--line-light); box-shadow: 0 1px 4px rgba(22,119,255,.05); }
        .quick-nav .qn .qn-ic { width: 22px; height: 22px; border-radius: 7px; background: linear-gradient(135deg,#4096ff,#0b57d0); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 500; box-shadow: 0 2px 6px rgba(22,119,255,.25); }
        .quick-nav .qn:nth-child(2) .qn-ic { background: linear-gradient(135deg,#36cfc9,#08979c); box-shadow: 0 2px 6px rgba(8,151,156,.25); }
        .quick-nav .qn:nth-child(3) .qn-ic { background: linear-gradient(135deg,#9254de,#531dab); box-shadow: 0 2px 6px rgba(83,29,171,.25); }
        .quick-nav .qn:nth-child(4) .qn-ic { background: linear-gradient(135deg,#73d13d,#237804); box-shadow: 0 2px 6px rgba(35,120,4,.25); }
        .quick-nav .qn .qn-tx { font-size: var(--fs-11); color: var(--text-2); }


        /* 通用箭头旋转 */
        .arrow { transition: transform .2s; }
        .arrow.open { transform: rotate(180deg); }

        /* ===== 合同 / 任务统计（与「项目详情（进行中-新版）」v2 首屏优化一致） ===== */
        .stats-row { display: block; margin: 0 10px 8px; }
        .stats-row > .card { margin: 0 0 6px 0; padding: 6px 10px; }
        .stats-row > .card:last-child { margin-bottom: 0; }
        .card.indent-card { margin: 0 10px 8px; }
        .contract-half { flex: 1.2; }
        .task-half { flex: 1; }
        /* 合同概览：2 统计横排（全宽，中间分隔线） */
        .card.contract-half .contract-summary { display: flex; flex-direction: row; align-items: center; padding: 2px 0; }
        .card.contract-half .contract-stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
        .card.contract-half .contract-stat .value { font-size: 14px; font-weight: 700; color: var(--text); }
        .card.contract-half .contract-stat .value .separator { color: var(--text-3); margin: 0 1px; }
        .card.contract-half .contract-stat .value .total { font-size: 11px; color: var(--text-3); font-weight: 400; }
        .card.contract-half .contract-stat .label { font-size: 10px; color: var(--text-3); margin-top: 2px; }
        .card.contract-half .contract-list { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .card.contract-half .contract-list.show { max-height: 110px; overflow-y: auto; }
        .contract-item { display: flex; align-items: center; gap: 10px; padding: 7px 0; border-top: 1px solid #f0f0f0; cursor: pointer; transition: background .15s; }
        .contract-item:active { background: #f7faff; }
        .contract-item:first-child { border-top: none; }
        .contract-item .info { flex: 1; min-width: 0; }
        .contract-item .name { font-size: 13px; color: var(--text); font-weight: 500; }
        .contract-item .meta { font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .contract-item .meta-row { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-3); margin-top: 2px; }
        .action-badge { font-size: 10px; padding: 1px 7px; border-radius: 8px; }
        .action-badge.green { background: var(--success-bg); color: var(--success); }
        .action-badge.orange { background: var(--warning-bg); color: var(--warning); }
        .progress-wrap { width: 64px; flex: 0 0 auto; text-align: right; }
        .progress-wrap .percent { font-size: 11px; color: var(--text-2); margin-bottom: 3px; }
        .progress-wrap .bar { height: 4px; background: #eef0f3; border-radius: 2px; overflow: hidden; }
        .progress-wrap .fill { height: 100%; background: var(--primary); border-radius: 2px; }
        /* 任务统计：3 项横排（全宽，icon 居左、数值+标签纵向居右，单行紧凑） */
        .card.task-half .task-stats { display: flex; flex-direction: row; gap: 6px; }
        .card.task-half .task-stat-item { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 5px; padding: 3px 2px; }
        .card.task-half .task-stat-item .icon-wrap { width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-bottom: 0; flex: 0 0 auto; }
        .icon-wrap.all { background: #e6f7ff; }
        .icon-wrap.accept { background: #fff7e6; }
        .icon-wrap.contract { background: #f6ffed; }
        .card.task-half .task-stat-item .info { flex: none; display: block; text-align: left; line-height: 1.1; }
        .card.task-half .task-stat-item .value { font-size: 14px; font-weight: 700; color: var(--text); }
        .card.task-half .task-stat-item .value .separator { color: var(--text-3); }
        .card.task-half .task-stat-item .value .total { font-size: 11px; color: var(--text-3); font-weight: 400; }
        .card.task-half .task-stat-item .label { font-size: 10px; color: var(--text-3); margin-top: 0; }
        /* 数据色彩化（与源页一致） */
        .card.contract-half .contract-stat:nth-of-type(1) .value { color: var(--primary); }
        .card.contract-half .contract-stat:nth-of-type(2) .value .current { color: var(--success); }
        .card.task-half .task-stat-item:nth-of-type(1) .value { color: var(--primary); }
        .card.task-half .task-stat-item:nth-of-type(2) .value { color: var(--warning); }
        .card.task-half .task-stat-item:nth-of-type(3) .value { color: var(--orange); }

        /* ===== 我的任务（位于待办事项下方） ===== */
        .my-task-card { cursor: pointer; padding: 8px 12px; margin-bottom: 8px; }
        .my-task-card .card-title { margin-bottom: 4px; }
        .my-task-card .my-task-stats { display: flex; flex-direction: row; align-items: stretch; }
        .my-task-card .my-task-stat { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 2px 0; }
        .my-task-card .my-task-stat .value { font-size: 18px; font-weight: 700; color: var(--text); line-height: 1; }
        .my-task-card .my-task-stat .label { font-size: 11px; color: var(--text-3); margin-top: 1px; text-align: center; }
        .my-task-card .my-task-divider { width: 1px; background: #f0f0f0; margin: 4px 0; }
        .my-task-card .my-task-stat:first-child .value { color: var(--success, #52c41a); }

        /* ===== 工人视角（与 project-list 工人视角统一） ===== */
        .todo-card.worker { border-left: 3px solid var(--warning); }
        .todo-card.worker .card-title { color: #d46b08; }
        .level-default-hint { font-size: 11px; color: var(--warning); margin-top: 2px; }

        /* ===== 今日动态 ===== */
        .activity-role-tag {
            display: inline-block; font-size: 10px; padding: 0 6px; border-radius: 8px;
            margin-left: 4px; vertical-align: middle; line-height: 14px; height: 14px; font-weight: 500;
        }
        .activity-role-tag.supervisor { background-color: #E6F7FF; color: #1890FF; }
        .activity-role-tag.foreman { background-color: #F6FFED; color: #52C41A; }
        .activity-role-tag.worker { background-color: #FFF7E6; color: #FA8C16; }
        .activity-role-tag.designer { background-color: #F9F0FF; color: #722ED1; }
        .activity-role-tag.owner { background-color: #FFF1F0; color: #F5222D; }
        .activity-role-tag.project-manager { background-color: #E6F7FF; color: #1890FF; }
        .activity-role-tag.plumbing-worker { background-color: #E6FFFB; color: #13C2C2; }
        .activity-stage-tag {
            display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 4px;
            margin: 0 4px; font-weight: 500; line-height: 14px;
        }
        .activity-stage-tag.demolition { background-color: #FFF1F0; color: #F5222D; }
        .activity-stage-tag.plumbing { background-color: #E6F7FF; color: #1890FF; }
        .activity-stage-tag.carpentry { background-color: #FFF7E6; color: #FA8C16; }
        .activity-stage-tag.tiling { background-color: #F9F0FF; color: #722ED1; }
        .activity-stage-tag.painting { background-color: #FCFABE; color: #D4B106; }
        .activity-stage-tag.installation { background-color: #F0F5FF; color: #2F54EB; }
        .activity-stage-tag.cleanup { background-color: #F6FFED; color: #52C41A; }
        .activity-stage-tag.design { background-color: #F9F0FF; color: #722ED1; }
        .activity-list { max-height: 150px; overflow-y: auto; }
        .activity-item { padding: 6px 0 6px 16px; position: relative; cursor: pointer; transition: background .15s; }
        .activity-item:active { background: #f7faff; }
        .activity-item::before { content: ''; position: absolute; left: 4px; top: 14px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }
        .activity-header { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
        .activity-avatar {
            width: 26px; height: 26px; border-radius: 50%; font-size: 11px; color: #fff;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 0 2px rgba(255,255,255,.85), 0 1px 4px rgba(0,0,0,.12); flex: 0 0 auto;
        }
        .activity-info { flex: 1; min-width: 0; }
        .activity-user { font-size: 12px; color: var(--text); }
        .activity-time { font-size: 10px; color: var(--text-3); }
        .activity-content { font-size: 12px; color: var(--text); margin-bottom: 3px; }
        .activity-media { display: flex; gap: 4px; margin-top: 3px; flex-wrap: wrap; }
        .activity-media-item { width: 48px; height: 48px; border-radius: 6px; flex: 0 0 auto; position: relative; }
        .activity-more-btn { padding: 5px; font-size: 12px; margin-top: 3px; text-align: center; color: var(--primary); }
        .hidden { display: none; }

        /* ===== 空状态提示（初始项目） ===== */
        .empty-tip { padding: 14px 4px; text-align: center; color: #999; font-size: 12px; line-height: 1.6; }
        .empty-tip .emoji { font-size: 22px; display: block; margin-bottom: 4px; opacity: .7; }

        /* 创建工作组 / 施工组 引导按钮（初始项目专属） */
        .add-arch-btn {
            display: flex; align-items: center; justify-content: center; gap: 6px;
            width: 100%; margin-top: 8px; padding: 10px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: #fff; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer;
            box-shadow: 0 4px 12px rgba(22,119,255,.25);
        }
        .add-arch-btn:active { transform: scale(.98); }

        /* ===== 原型导航 ===== */
        .page-nav {
            position: fixed; top: 20px; right: 20px; z-index: 1000;
            width: 190px; background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.12);
            max-height: calc(100vh - 40px); overflow-y: auto; transition: max-height .3s;
        }
        .page-nav-title { font-size: var(--fs-13); font-weight: 500; margin: 0 0 12px; color: var(--text); display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; }
        .page-nav-title .toggle-btn { font-size: 12px; color: var(--text-tertiary); transition: transform .3s; display: inline-block; }
        .page-nav-title .toggle-btn.collapsed { transform: rotate(-90deg); }
        .page-nav.collapsed { max-height: 52px; overflow: hidden; }
        .page-nav.collapsed .page-nav-title { margin-bottom: 0; }
        .page-nav a { display: block; padding: 8px 10px; margin: 4px 0; background-color: var(--bg-secondary); border-radius: 6px; text-decoration: none; color: var(--text-2); font-size: var(--fs-11); transition: all .2s; }
        .page-nav a.active { background: var(--primary); color: #fff; }
        .page-nav a:hover { background: var(--primary); color: #fff; }

        /* 小程序底部主导航（复用 common.css 语义，但本页自包含不依赖外部样式） */
        .tab-bar {
            height: 52px;
            background: #fff;
            display: flex;
            border-top: 1px solid var(--line-light);
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
        }
        .tab-item {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer; gap: 1px; color: var(--text-3);
            transition: all 0.2s;
        }
        .tab-item .icon { font-size: 20px; margin-bottom: 2px; }
        .tab-item .label { font-size: 10px; }
        .tab-item.active { color: var(--primary); }
        .tab-item:not(.active) { color: var(--text-3); }

        /* ===== 角色演示开关（与项目列表页「演示开关」同源，置于手机框外侧右侧） ===== */
        .role-demo-switch {
            position: absolute; left: calc(100% + 16px); top: 80px;
            background: #fff; border: 1px solid #ffe7ba; border-radius: 12px;
            padding: 12px 14px; box-shadow: 0 4px 16px rgba(0,0,0,.1); z-index: 100; width: 132px;
        }
        .role-demo-switch .switch-title { font-size: 12px; font-weight: 600; color: #333; margin-bottom: 8px; text-align: center; }
        .role-demo-switch .switch-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
        .role-demo-switch .switch-status { color: var(--primary); font-weight: 600; font-size: 12px; white-space: nowrap; }
        .role-demo-switch .switch-status.worker { color: var(--warning); }
        .role-demo-switch .switch-hint { font-size: 10px; color: #999; text-align: center; line-height: 1.3; }
        .switch { position: relative; display: inline-block; width: 36px; height: 20px; }
        .switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ccc; transition: .3s; border-radius: 20px;
        }
        .slider:before {
            position: absolute; content: ""; height: 16px; width: 16px; left: 2px; bottom: 2px;
            background-color: #fff; transition: .3s; border-radius: 50%;
        }
        .switch input:checked + .slider { background-color: var(--warning); }
        .switch input:checked + .slider:before { transform: translateX(16px); }

        /* ===== 服务流程（横向流程条 + 内联明细；回迁自 demo，对齐项目详情原型） ===== */
        .qn-card { padding: 4px 12px; }
/* ===== 服务流程卡（核心） ===== */
.flow-card { background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow); border-radius: var(--r-card); margin: 0 var(--sp-3) var(--sp-2); overflow: hidden; }
.flow-sticky { position: sticky; top: 0; z-index: 20; overflow: visible; background: linear-gradient(180deg,#f8fbff 0%,#ffffff 100%); padding: 8px var(--sp-3) 0; border-bottom: 1px solid transparent; transition: border-color 120ms ease-out, box-shadow 160ms ease-out; }
.flow-sticky.stuck { border-bottom-color: var(--line-light); box-shadow: 0 4px 14px rgba(22,119,255,.08); }
.flow-head { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
.flow-head .fh-t { font-size: var(--fs-15); font-weight: 600; color: var(--text); }
.flow-head .fh-n { font-size: var(--fs-11); color: var(--primary-deep); background: var(--primary-bg); padding: 1px 7px; border-radius: var(--r-pill); }
/* 流程配置入口：仅非工人且有配置权限时出现 */
.flow-head .fh-cfg { margin-left: auto; font-size: var(--fs-11); color: var(--primary); background: #fff; border: 1px solid #cfe1fb; border-radius: var(--r-pill); padding: 4px 9px; display: flex; align-items: center; gap: 3px; flex-shrink: 0; }
.flow-head .fh-cfg:active { background: var(--primary-bg); }
.flow-stats { display: flex; align-items: center; gap: var(--sp-3); background: linear-gradient(90deg,#eef5ff,#f8fbff); border: 1px solid #e2eaf8; border-radius: var(--r-block); padding: 4px 10px; margin-bottom: 5px; }
.flow-stats .fs-seg { display: flex; align-items: baseline; gap: 4px; }
.flow-stats .fs-num { font-size: var(--fs-13); font-weight: 600; color: var(--primary-deep); }
.flow-stats .fs-lab { font-size: var(--fs-11); color: var(--text-2); }
.flow-stats .fs-div { width: 1px; height: 12px; background: var(--dot-ring); }

/* 横滑流程条 */
.rail-wrap { position: relative; margin-bottom: 5px; }
.flow-rail { position: relative; display: flex; gap: var(--sp-2); overflow-x: auto; overflow-y: hidden; scroll-behavior: smooth; scroll-snap-type: x proximity; padding-bottom: 2px; }
.flow-rail.centerable::before, .flow-rail.centerable::after { content: ''; flex: 0 0 calc(50% - 42px); }
.flow-item { flex: 0 0 auto; min-width: 50px; min-height: 38px; scroll-snap-align: center; border-radius: 10px; padding: 5px 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: #fff; border: 1px solid #e6edf9; box-shadow: 0 1px 4px rgba(22,119,255,.05); transition: transform 160ms ease-out, background-color 160ms ease-out, box-shadow 160ms ease-out; }
.flow-item:active { background: #f1f6ff; }
.flow-item.on { min-width: 84px; background: var(--grad-brand); border-color: transparent; transform: scale(1.02); box-shadow: 0 6px 16px rgba(22,119,255,.32); }
.flow-item .fi-dot { width: 10px; height: 10px; border-radius: 50%; }
.flow-item.on .fi-dot { box-shadow: 0 0 0 2px rgba(255,255,255,.9); }
.flow-item .fi-name { font-size: var(--fs-11); color: var(--text-2); line-height: 1.2; text-align: center; }
.flow-item.on .fi-name { font-size: var(--fs-13); font-weight: 600; color: #fff; }
.flow-item .fi-bar { width: 100%; height: 3px; border-radius: 2px; background: #e3ebf8; overflow: hidden; }
.flow-item.on .fi-bar { background: rgba(255,255,255,.35); }
.flow-item .fi-bar i { display: block; height: 100%; border-radius: 2px; }
.flow-item .fi-prog { font-size: var(--fs-11); color: var(--text-3); line-height: 1.2; }
.flow-item.on .fi-prog { color: rgba(255,255,255,.88); }
.rail-mask { position: absolute; right: 0; top: 0; bottom: 2px; width: 24px; background: linear-gradient(to left, #fff, rgba(255,255,255,0)); pointer-events: none; display: none; }

/* 内联明细 */
.flow-detail { background: var(--flow-bg); border-radius: 0 0 var(--r-card) var(--r-card); }
.flow-detail.collapsed { display: none; }
.detail-inner { padding: var(--sp-3); border-left: 2px solid var(--primary); }
.detail-title { font-size: var(--fs-13); font-weight: 500; color: var(--text); margin-bottom: var(--sp-2); }
.d-sec { margin-bottom: var(--sp-3); }
.d-sec:last-child { margin-bottom: 0; }
.d-sec-h { font-size: var(--fs-11); color: var(--text-2); margin-bottom: 6px; }
.d-row { display: flex; align-items: center; gap: var(--sp-2); min-height: 44px; padding: 6px 0; border-top: 1px solid var(--line-light); }
.d-row:first-of-type { border-top: none; }
.d-row:active { background: #f1f6ff; }
.d-row .d-name { flex: 1; min-width: 0; font-size: var(--fs-12); color: var(--text); line-height: 1.4; }
.d-row .d-meta { font-size: var(--fs-11); color: var(--text-2); line-height: 1.4; }
.d-row .d-go { font-size: var(--fs-11); color: var(--primary); flex-shrink: 0; }
.badge { font-size: var(--fs-11); font-weight: 500; border-radius: var(--r-pill); padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.b-go { color: var(--primary); background: var(--primary-bg); }
.b-done { color: var(--success); background: var(--success-bg); }
.b-wait { color: var(--text-2); background: var(--bg-secondary); }
.b-stop { color: var(--danger); background: var(--danger-bg); }
.detail-empty { text-align: center; padding: var(--sp-5) var(--sp-3); }
.detail-empty .de-t { font-size: var(--fs-12); color: var(--text-2); line-height: 1.5; margin-bottom: var(--sp-3); }
.add-btn { display: inline-block; border: 1px dashed var(--primary-light); color: var(--primary); font-size: var(--fs-12); border-radius: var(--r-block); padding: 8px 16px; }

/* ===== 今日动态（对齐服务端原型页） ===== */
.activity-card .card-head { margin-bottom: 4px; }
.activity-item { padding: 8px 0 8px 16px; position: relative; cursor: pointer; transition: background .15s; border-top: 1px solid var(--line-light); }
.activity-item:first-child { border-top: none; }
.activity-item:active { background: #f7faff; }
.activity-item.hidden { display: none; }
.activity-item::before { content: ''; position: absolute; left: 4px; top: 14px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }
.activity-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.activity-avatar { width: 26px; height: 26px; border-radius: 50%; font-size: 11px; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 0 0 2px rgba(255,255,255,.85), 0 1px 4px rgba(0,0,0,.12); }
.activity-info { flex: 1; min-width: 0; }
.activity-user { font-size: 13px; color: var(--text); font-weight: 500; }
.activity-role-tag { display: inline-block; font-size: 10px; padding: 0 6px; border-radius: 8px; margin-left: 4px; vertical-align: middle; line-height: 14px; height: 14px; font-weight: 500; }
.activity-role-tag.project-manager { background-color: #E6F7FF; color: #1890FF; }
.activity-role-tag.foreman { background-color: #F6FFED; color: #52C41A; }
.activity-role-tag.worker { background-color: #FFF7E6; color: #FA8C16; }
.activity-role-tag.designer { background-color: #F9F0FF; color: #722ED1; }
.activity-role-tag.owner { background-color: #FFF1F0; color: #F5222D; }
.activity-time { font-size: 10px; color: var(--text-3); margin-top: 2px; }
.activity-content { font-size: 12px; color: var(--text); margin-bottom: 4px; line-height: 1.5; }
.activity-content .hl { color: var(--primary); background: var(--primary-bg); border-radius: 3px; padding: 0 3px; }
.activity-media { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
.activity-media-item { width: 48px; height: 48px; border-radius: 6px; flex: 0 0 auto; position: relative; background: #dfe6f2; overflow: hidden; }
.activity-media-item .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.activity-media-item .play::after { content: ''; width: 0; height: 0; border-left: 12px solid rgba(255,255,255,.95); border-top: 8px solid transparent; border-bottom: 8px solid transparent; margin-left: 3px; filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
.activity-more-btn { padding: 8px 0 2px; font-size: 12px; text-align: center; color: var(--primary); cursor: pointer; }

/* ===== Toast ===== */
.toast { position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%); background: rgba(0,0,0,.8); color: #fff; font-size: var(--fs-12); padding: 8px 16px; border-radius: var(--r-block); z-index: 100; opacity: 0; transition: opacity 160ms ease-out; pointer-events: none; }
.toast.show { opacity: 1; }

/* ===== 演示控制（框外） ===== */
.demo-panel { width: 220px; flex-shrink: 0; background: #fff; border-left: 2px dashed var(--demo-blue); border-radius: var(--r-block); padding: var(--sp-3); align-self: flex-start; box-shadow: var(--shadow); }
.demo-panel h4 { font-size: var(--fs-13); font-weight: 500; color: var(--text); margin-bottom: var(--sp-2); }
.demo-panel .dp-group { margin-bottom: var(--sp-4); }
.demo-panel .dp-lab { font-size: var(--fs-11); color: var(--text-2); margin-bottom: var(--sp-2); }
.demo-panel .dp-opts { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
.demo-panel .dp-opt { font-size: var(--fs-11); color: var(--text-2); border: 1px solid var(--border); border-radius: var(--r-pill); padding: 6px 10px; min-height: 32px; display: flex; align-items: center; cursor: pointer; }
.demo-panel .dp-opt.on { color: var(--primary); border-color: var(--primary); background: var(--primary-bg); font-weight: 500; }

/* ===== 右侧「服务流程项」浮窗（参考 owner 项目导航） ===== */
/* 右缘常驻触发条 */
.flow-trigger {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  z-index: 30; background: var(--grad-brand); color: #fff; cursor: pointer;
  padding: 14px 6px; border-radius: 12px 0 0 12px;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  box-shadow: -2px 2px 14px rgba(22,119,255,.35); transition: opacity 160ms ease-out;
}
.flow-trigger .ft-arrow { font-size: 13px; line-height: 1; }
.flow-trigger .ft-text { writing-mode: vertical-rl; font-size: 12px; font-weight: 600; letter-spacing: 3px; }

/* 遮罩 + 抽屉 */
.flow-drawer-mask {
  position: absolute; inset: 44px 0 0 0; background: rgba(0,0,0,.35); z-index: 50;
  opacity: 0; visibility: hidden; transition: opacity 200ms ease-out, visibility 200ms;
}
.flow-drawer-mask.open { opacity: 1; visibility: visible; }
.flow-drawer {
  position: absolute; top: 44px; right: 0; height: calc(100% - 44px); width: 300px; max-width: 86%;
  background: #fff; z-index: 60; transform: translateX(100%);
  transition: transform 240ms cubic-bezier(.22,.61,.36,1);
  display: flex; flex-direction: column; box-shadow: -6px 0 24px rgba(0,0,0,.18);
}
.flow-drawer.open { transform: translateX(0); }

/* 深色头部栏（仿 owner drawer-header-bar） */
.fd-header { background: var(--grad-brand); color: #fff; padding: 12px 14px; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.fd-header .fd-ic { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,.22); display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
.fd-header .fd-title { font-size: 15px; font-weight: 600; }
.fd-header .fd-tag { font-size: 10px; background: rgba(255,255,255,.2); padding: 2px 8px; border-radius: 999px; }
.fd-header .fd-right { margin-left: auto; display: flex; align-items: center; gap: 12px; font-size: 12px; }
.fd-header .fd-cfg { font-size: 11px; color: #fff; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; padding: 2px 8px; cursor: pointer; }
.fd-header .fd-close { cursor: pointer; font-size: 20px; line-height: 1; }

/* 信息栏 */
.fd-info { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: linear-gradient(90deg,#eef5ff,#f8fbff); border-bottom: 1px solid var(--border); flex-shrink: 0; }
.fd-info .fd-badge { font-size: 12px; color: var(--text); flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fd-info .fd-badge b { color: var(--primary); font-weight: 600; }
.fd-info .fd-act { font-size: 11px; padding: 4px 10px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
.fd-info .fd-act.create { background: var(--primary); color: #fff; }
.fd-info .fd-act.view { background: #fff; color: var(--primary); border: 1px solid rgba(22,119,255,.35); }
.fd-info .fd-locate { font-size: 11px; color: var(--primary); background: var(--primary-bg); padding: 4px 10px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }

/* 内容区（顶部 padding 归零：首子元素即吸顶 Tab 条，避免吸顶后上方留透明缝） */
.fd-content { flex: 1; overflow-y: auto; padding: 0 14px 16px; -webkit-overflow-scrolling: touch; background: linear-gradient(180deg,#ffffff 0%,#f8fbff 100%); }
.fd-sec { margin-bottom: 14px; }
.fd-sec-h { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.fd-sec-h .fd-count { font-size: 11px; color: var(--text-2); font-weight: 500; }
.fd-item { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; border-top: 1px solid var(--line-light); cursor: pointer; }
.fd-item:first-child { border-top: none; }
.fd-item.active { background: linear-gradient(90deg, var(--primary-bg), transparent); margin: 0 -14px; padding: 8px 14px; border-radius: 8px; }
.fd-item .fd-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-item .fd-name { flex: 1; min-width: 0; font-size: 13px; color: var(--text); }
.fd-item .fd-meta { font-size: 11px; color: var(--text-2); }
.fd-item .fd-badge { font-size: 11px; font-weight: 500; border-radius: 999px; padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.fd-item.active .fd-name { color: var(--primary); font-weight: 600; }
.fd-empty { text-align: center; color: var(--text-3); font-size: 12px; padding: 14px 0; }
.fd-footer { flex-shrink: 0; padding: 10px 14px; font-size: 11px; color: var(--text-3); text-align: center; border-top: 1px solid var(--line-light); background: #f5f9ff; }
/* ===== 初始项目：服务流程「第一步引导创建」空态 ===== */
.flow-empty-body { padding: 14px 12px 16px; text-align: center; cursor: pointer; }
.flow-empty-body .fe-ic { width: 46px; height: 46px; margin: 0 auto 8px; border-radius: 14px; background: linear-gradient(135deg,#e8f1ff,#f5f9ff); display: flex; align-items: center; justify-content: center; font-size: 22px; }
.flow-empty-body .fe-t { font-size: var(--fs-13); font-weight: 600; color: var(--text); margin-bottom: 4px; }
.flow-empty-body .fe-d { font-size: var(--fs-11); color: var(--text-2); line-height: 1.6; margin-bottom: 12px; }
.flow-empty-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 20px; border-radius: var(--r-pill); background: var(--grad-brand); color: #fff; font-size: var(--fs-13); font-weight: 600; box-shadow: 0 4px 12px rgba(22,119,255,.24); cursor: pointer; }
.flow-empty-btn:active { opacity: .88; }
/* 浮窗内「无服务流程项」引导态 */
.fd-empty-state { padding: 46px 20px 34px; text-align: center; }
.fd-empty-state .fes-ic { width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 18px; background: linear-gradient(135deg,#e8f1ff,#f5f9ff); display: flex; align-items: center; justify-content: center; font-size: 26px; }
.fd-empty-state .fes-t { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
.fd-empty-state .fes-d { font-size: 12px; color: var(--text-2); line-height: 1.7; margin-bottom: 18px; }
.fd-empty-state .fes-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 22px; border-radius: var(--r-pill); background: var(--grad-brand); color: #fff; font-size: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(22,119,255,.24); cursor: pointer; }
.fd-empty-state .fes-btn:active { opacity: .88; }

/* ===== 指派任务（临时任务）：明细区底部吸底入口 + 轻量表单弹窗 ===== */
.fd-assignbar { position: sticky; bottom: 0; z-index: 4; margin: 4px 0 0; padding: 10px 0 2px; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, #fff 42%); }
.fd-ext-add { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 4px; border: none; border-radius: 10px; background: var(--grad-brand); color: #fff; font-size: 14px; font-weight: 500; font-family: inherit; cursor: pointer; box-shadow: 0 4px 12px rgba(22,119,255,.24); user-select: none; }
.fd-ext-add:active { opacity: .92; }
.assign-modal { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15,23,42,.5); z-index: 80; display: none; align-items: center; justify-content: center; }
.assign-modal.show { display: flex; }
.assign-modal .am-content { background: #fff; border-radius: 12px; width: 88%; max-width: 340px; max-height: 82%; overflow-y: auto; box-shadow: 0 12px 40px rgba(22,119,255,.2); }
.am-header { padding: 14px 16px; border-bottom: 1px solid var(--line-light); display: flex; justify-content: space-between; align-items: center; }
.am-title { font-size: 16px; font-weight: 600; color: var(--text); }
.am-close { font-size: 18px; color: var(--text-3); cursor: pointer; padding: 2px 6px; }
.am-body { padding: 14px 16px; }
.am-group { margin-bottom: 14px; }
.am-group:last-child { margin-bottom: 0; }
.am-label { display: block; font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
.am-required { color: var(--danger); }
.am-input, .am-textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--dot-ring); border-radius: 8px; font-size: 13px; box-sizing: border-box; font-family: inherit; background: #fff; color: var(--text); }
.am-textarea { min-height: 56px; resize: vertical; }
.am-input:focus, .am-textarea:focus { outline: none; border-color: var(--primary); }
.am-err { color: var(--danger); font-size: 11px; margin-top: 4px; display: none; }
.am-select { position: relative; }
.am-select-btn { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 9px 10px; border: 1px solid var(--dot-ring); border-radius: 8px; font-size: 13px; color: var(--text-2); cursor: pointer; background: #fff; min-height: 40px; }
.am-select-btn .arr { font-size: 10px; color: var(--text-3); transition: transform .15s ease; flex-shrink: 0; }
.am-select.open .am-select-btn { border-color: var(--primary); }
.am-select.open .am-select-btn .arr { transform: rotate(180deg); }
.am-dropdown { display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #fff; border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 6px 20px rgba(22,119,255,.15); max-height: 180px; overflow-y: auto; z-index: 10; }
.am-select.open .am-dropdown { display: block; }
.am-opt { padding: 10px 12px; font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 8px; cursor: pointer; }
.am-opt:active { background: var(--primary-bg); }
.am-opt .role { font-size: 11px; color: var(--text-3); margin-left: auto; flex-shrink: 0; }
.am-opt .ck { font-size: 12px; color: var(--primary); margin-left: 6px; flex-shrink: 0; font-weight: 600; }
.am-opt.checked { background: var(--primary-bg); color: var(--primary); font-weight: 500; }
.am-select-btn > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.am-footer { padding: 12px 16px; border-top: 1px solid var(--line-light); }
.am-submit { width: 100%; padding: 11px; background: var(--grad-brand); color: #fff; border: none; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; }
.am-submit:active { opacity: .9; }

/* 流程项：横向鱼眼 Tab（Q · 选中放大、邻项按距离缩小、两端渐隐） */
/* 浮窗内流程项 Tab 吸顶：滚动看任务时保持「当前流程项」上下文（紧凑：顶部留白 2px，仅为鱼眼放大溢出预留） */
#fdFlowList { position: sticky; top: 0; z-index: 6; background: #fff; padding-top: 2px; }
#fdFlowList.stuck { box-shadow: 0 4px 14px rgba(22,119,255,.08); }
.fd-rail { position: relative; display: flex; gap: 6px; overflow-x: auto; padding: 4px 0 2px; scroll-behavior: smooth; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%); }
.fd-rail::before, .fd-rail::after { content: ''; flex: 0 0 calc(50% - 28px); }
.fd-rail-item { flex: 0 0 auto; min-width: 56px; border-radius: 10px; padding: 6px; background: #fff; border: 1px solid #e6edf9; box-shadow: 0 1px 4px rgba(22,119,255,.05); display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; transform-origin: center bottom; transition: transform .28s cubic-bezier(.34,1.3,.64,1), opacity .2s ease, background-color .2s ease, box-shadow .2s ease; }
.fd-rail-item.active { background: var(--grad-brand); border-color: transparent; position: relative; z-index: 1; box-shadow: 0 6px 16px rgba(22,119,255,.32); }
.fd-ri-d0 { transform: scale(1.16); }
.fd-ri-d1 { transform: scale(1.04); }
.fd-ri-d2 { transform: scale(.94); opacity: .92; }
.fd-ri-d3 { transform: scale(.88); opacity: .75; }
.fd-ri-name { font-size: 11px; color: var(--text-2); line-height: 1.2; text-align: center; }
.fd-rail-item.active .fd-ri-name { color: #fff; font-weight: 600; }
.fd-ri-bar { width: 100%; height: 3px; border-radius: 2px; background: #e3ebf8; overflow: hidden; }
.fd-rail-item.active .fd-ri-bar { background: rgba(255,255,255,.35); }
.fd-ri-bar i { display: block; height: 100%; border-radius: 2px; }
.fd-ri-prog { font-size: 11px; color: var(--text-3); }
.fd-rail-item.active .fd-ri-prog { color: rgba(255,255,255,.88); }

/* 两类任务：左侧书签约竖排 Tab（G · 笔记本索引签） */
.fd-bm-wrap { display: flex; align-items: flex-start; margin: 4px 0 8px; }
.fd-bm-col { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; flex-shrink: 0; position: sticky; top: var(--fd-rail-h, 58px); z-index: 5; background: #fff; border-radius: 8px 0 0 8px; box-shadow: 1px 0 6px rgba(22,119,255,.05); }
.fd-bm { writing-mode: vertical-rl; letter-spacing: 2px; font-size: 11px; font-weight: 500; color: var(--text-2); background: #fff; border: 1px solid #e6edf9; min-width: 22px; padding: 10px 3px; border-radius: 6px 0 0 6px; cursor: pointer; text-align: center; user-select: none; }
.fd-bm:active { opacity: .85; }
.fd-bm.on { background: var(--grad-brand); color: #fff; font-weight: 600; border-color: transparent; box-shadow: -2px 2px 8px rgba(22,119,255,.28); position: relative; z-index: 1; margin-right: -1px; }
.fd-bm-n { font-size: 9px; font-weight: 400; color: var(--text-3); letter-spacing: 0; margin-top: 3px; }
.fd-bm.on .fd-bm-n { color: rgba(255,255,255,.85); }
.fd-bm-panel { flex: 1; min-width: 0; background: #fff; border: 1px solid var(--line-light); border-radius: 0 10px 10px 10px; padding: 8px; }

/* 明细列表工具条：一键收起/展开全部阶段（作用于阶段卡片，非整区隐藏） */
.fd-bm-util { writing-mode: vertical-rl; letter-spacing: 2px; font-size: 11px; font-weight: 500; color: var(--primary); background: #fff; border: 1px solid var(--primary); min-width: 22px; padding: 8px 4px; border-radius: 6px; cursor: pointer; text-align: center; user-select: none; margin-top: 2px; }
.fd-bm-util:active { background: var(--primary-bg); }

/* 浮窗内：阶段-任务（对齐 owner 项目导航 · 折叠阶段卡片 + 任务项） */
.fd-stage-list { display: flex; flex-direction: column; gap: 10px; }
.fd-stage-card { background: #fff; border: 1px solid var(--line-light); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 6px rgba(22,119,255,.06); }
.fd-stage-header { display: flex; align-items: center; padding: 12px 14px; cursor: pointer; gap: 10px; transition: background .15s ease; }
.fd-stage-header:active { background: #f3f7ff; }
.fd-stage-status-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-stage-status-dot.completed { background: #52C41A; box-shadow: 0 0 0 3px rgba(82,196,26,.18); }
.fd-stage-status-dot.in_progress { background: #FA8C16; box-shadow: 0 0 0 3px rgba(250,140,22,.18); }
.fd-stage-status-dot.pending { background: #bfc9d9; box-shadow: 0 0 0 3px rgba(191,201,217,.22); }
.fd-stage-info { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
.fd-stage-title { font-size: 14px; font-weight: 600; color: #1F2937; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fd-stage-count-badge { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 10px; flex-shrink: 0; }
.fd-stage-count-badge.completed { color: #389E0D; background: #F6FFED; }
.fd-stage-count-badge.in_progress { color: #D46B08; background: #FFF7E6; }
.fd-stage-count-badge.pending { color: #8C8C8C; background: #F0F0F0; }
.fd-stage-collapse-arrow { width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; color: #a8b6c8; font-size: 14px; transition: transform .25s ease; flex-shrink: 0; font-weight: 700; }
.fd-stage-card.collapsed .fd-stage-collapse-arrow { transform: rotate(-90deg); }
.fd-stage-task-list { overflow: hidden; transition: max-height .3s ease; border-top: 1px solid #F0F2F5; }
.fd-stage-card.collapsed .fd-stage-task-list { max-height: 0 !important; border-top: none; }
/* 定位命中：当前施工阶段短暂高亮脉冲（1.6s 后自动回落，不改变选中态样式） */
.fd-stage-card.locate-hl { animation: fdLocateHl 1.6s ease-out; }
@keyframes fdLocateHl {
  0%   { background: rgba(22,119,255,.12); border-color: rgba(22,119,255,.55); box-shadow: 0 0 0 2px rgba(22,119,255,.35); }
  60%  { background: rgba(22,119,255,.05); border-color: rgba(22,119,255,.28); box-shadow: 0 0 0 2px rgba(22,119,255,.14); }
  100% { background: #fff; border-color: var(--line-light); box-shadow: 0 1px 6px rgba(22,119,255,.06); }
}
.fd-locate:active { background: rgba(22,119,255,.18); }
.fd-stage-task-item { display: flex; align-items: center; padding: 10px 14px 10px 34px; gap: 10px; cursor: pointer; position: relative; transition: background .15s ease; }
.fd-stage-task-item + .fd-stage-task-item { border-top: 1px solid #F5F6F8; }
.fd-stage-task-item:active { background: #FAFBFC; }
.fd-task-status-icon { width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; font-weight: 600; }
.fd-task-status-icon.completed { background: #F6FFED; color: #52C41A; border: 1.5px solid #95DE64; }
.fd-task-status-icon.in_progress { background: #FFF7E6; color: #FA8C16; border: 1.5px solid #FFC069; }
.fd-task-status-icon.pending { background: transparent; border: 1.5px solid #cfd9e6; color: #a8b6c8; }
.fd-task-name { flex: 1; font-size: 13px; color: #262626; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fd-stage-task-item.in_progress .fd-task-name { color: #D46B08; font-weight: 500; }
.fd-stage-task-item.completed .fd-task-name { color: #93a1b5; text-decoration: line-through; text-decoration-color: #bfc9d9; }
.fd-task-tag { display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; width: 18px; height: 18px; border-radius: 4px; background: linear-gradient(135deg,#FF6B6B,#FF4757); color: #fff; flex-shrink: 0; }
.fd-task-arrow { color: #D9D9D9; font-size: 14px; flex-shrink: 0; font-weight: 700; }

/* 临时任务列表（已取消「隶属阶段」：单一平铺列表） */
.fd-ext-list { padding-top: 2px; }
.fd-ext-task { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; border-top: 1px solid var(--line-light); }
.fd-ext-task:first-of-type { border-top: none; }
.fd-ext-task .fd-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-ext-task .fd-name { flex: 1; min-width: 0; font-size: 13px; color: var(--text); }
.fd-ext-task .fd-meta { font-size: 11px; color: var(--text-2); }
.fd-ext-task .fd-badge { font-size: 11px; font-weight: 500; border-radius: 999px; padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.fd-ext-none { text-align: center; color: var(--text-3); font-size: 12px; padding: 14px 0; }
/* 任务型流程项内的临时任务小区块（与该项自身任务区分） */
.fd-ext-sub { margin-top: 10px; }
.fd-ext-sub-h { font-size: 12px; font-weight: 600; color: var(--text-2); padding: 8px 0 4px; display: flex; align-items: center; gap: 6px; border-top: 1px solid var(--line-light); }
.fd-ext-sub-n { font-size: 10px; font-weight: 600; color: var(--primary); background: var(--primary-bg); border-radius: 999px; padding: 1px 7px; }
        .flow-card { margin: 0 0 8px; }
    </style>
</head>
