                    <span class="switch-hint" data-page-node-id="NAGBH9CL3ottyfvgki0DoJ">切换</span>
                    <span class="switch-arrow" id="switchArrow" data-page-node-id="x3NoUp6AmHjLMnE7zhM0PJ">▾</span>
                </div>
            </div>

            <!-- 项目下拉面板：置于 topbar 内，相对切换条定位展开 -->
            <div class="proj-panel" id="projPanel" data-page-node-id="P7FavnzOEkT2P61qKZbv0c">
