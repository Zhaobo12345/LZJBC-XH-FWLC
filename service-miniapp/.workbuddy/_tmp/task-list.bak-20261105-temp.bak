﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>家装平台小程序原型 - 任务列表</title>
    <link rel="stylesheet" href="common.css">
    <style>
        .page-content {
            height: calc(100% - 44px - 44px);
        }

        .search-filter-bar {
            background-color: var(--bg-primary);
            padding: 4px 10px;
        }

        .search-input {
            width: 100%;
            height: 28px;
            background-color: var(--bg-secondary);
            border: none;
            border-radius: 14px;
            padding: 0 12px;
            font-size: 13px;
            color: var(--text-primary);
            outline: none;
        }

        .search-input::placeholder {
            color: var(--text-tertiary);
        }

        .search-input:focus {
            background-color: #E6F7FF;
        }

        .filter-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .filter-tag {
            display: flex;
            align-items: center;
            padding: 4px 10px;
            background-color: var(--status-primary-bg);
            border-radius: 14px;
            font-size: 12px;
            color: var(--primary-color);
        }

        .filter-tag .remove {
            margin-left: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .filter-level-one {
            display: flex;
            background-color: var(--bg-primary);
            padding: 8px 16px;
            gap: 8px;
            border-bottom: 1px solid var(--border-color);
        }

        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 12px 0px 12px;
            background-color: var(--bg-primary);
            position: relative;
            z-index: 1;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 1;
        }

        .filter-group:first-child {
            flex: 0 0 auto;
        }

        .filter-label {
            font-size: 12px;
            color: var(--text-secondary);
            white-space: nowrap;
        }

        .filter-toggle {
            display: flex;
            background-color: var(--bg-secondary);
            border-radius: 16px;
            overflow: hidden;
            padding: 2px;
        }

        .filter-option {
            padding: 5px 12px;
            font-size: 12px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            -webkit-user-select: none;
            border-radius: 14px;
            background-color: transparent;
        }

        .filter-option:hover {
            color: var(--primary-color);
        }

        .filter-option.active {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .filter-option.active:hover {
            background-color: var(--primary-color);
        }

        .filter-select {
            position: relative;
            padding: 6px 28px 6px 12px;
            font-size: 12px;
            color: var(--text-primary);
            background-color: var(--bg-secondary);
            border: none;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            -webkit-user-select: none;
            min-width: 90px;
        }

        .filter-select:hover {
            background-color: #E6F7FF;
        }

        .filter-select.active {
            background-color: #E6F7FF;
            color: var(--primary-color);
        }

        .filter-select::after {
            content: '▼';
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 8px;
            color: var(--text-tertiary);
            transition: transform 0.2s;
        }

        .filter-select.active::after {
            transform: translateY(-50%) rotate(180deg);
            color: var(--primary-color);
        }

        .status-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            width: 140px;
            background-color: var(--bg-primary);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            border: 1px solid var(--border-color);
            overflow: hidden;
            z-index: 1000;
            display: none;
        }

        .status-dropdown.show {
            display: block;
            animation: dropdownFadeIn 0.15s ease;
        }

        @keyframes dropdownFadeIn {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .status-dropdown-item {
            padding: 10px 14px;
            font-size: 13px;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.15s;
            user-select: none;
            -webkit-user-select: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-dropdown-item:hover {
            background-color: #F5F5F5;
        }

        .status-dropdown-item.active {
            background-color: #E6F7FF;
            color: var(--primary-color);
            font-weight: 500;
        }

        .status-dropdown-item.active::before {
            content: '✓';
            font-size: 12px;
        }

        .contract-section {
            background-color: var(--bg-primary);
            margin-bottom: 8px;
        }

        .contract-header {
            display: flex;
            align-items: flex-start;
            padding: 12px 16px;
            background-color: var(--bg-secondary);
            cursor: pointer;
            transition: all 0.2s;
        }

        .contract-header:hover {
            background-color: #E6F7FF;
        }

        .contract-header .contract-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 16px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .contract-header .contract-main {
            flex: 1;
            min-width: 0;
        }

        .contract-header .contract-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            line-height: 20px;
        }

        .contract-header .contract-footer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .contract-header .contract-meta {
            font-size: 12px;
            color: var(--text-tertiary);
            line-height: 16px;
            white-space: nowrap;
        }

        .contract-header .contract-progress {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1 1 120px;
            min-width: 96px;
        }

        .contract-header .progress-track {
            flex: 1;
            height: 6px;
            min-width: 50px;
            background-color: #F0F0F0;
            border-radius: 3px;
            overflow: hidden;
        }

        .contract-header .progress-fill {
            height: 100%;
            width: 0;
            background-color: var(--success-color);
            border-radius: 3px;
            transition: width 0.3s ease;
        }

        .contract-header .progress-text {
            font-size: 12px;
            color: var(--text-tertiary);
            white-space: nowrap;
        }

        .contract-header .arrow {
            color: var(--text-tertiary);
            transition: transform 0.3s;
            margin-left: 8px;
            flex-shrink: 0;
            line-height: 20px;
        }

        .contract-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .stage-group {
            display: none;
        }

        .stage-group.show {
            display: block;
        }

        .stage-header {
            display: flex;
            align-items: center;
            padding: 10px 16px 10px 44px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
        }

        .stage-header:hover {
            background-color: #F5F5F5;
        }

        .stage-header .stage-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--primary-color);
            margin-right: 8px;
        }

        .stage-header .stage-dot.completed {
            background-color: var(--success-color);
        }

        .stage-header .stage-dot.confirming {
            background-color: var(--warning-color);
        }

        .stage-header .stage-name {
            flex: 1;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .stage-header .stage-count {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .stage-header .sequential-icon {
            color: var(--warning-color);
            margin-left: 8px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 2px;
        }

        .stage-header .sequential-icon::before {
            content: '↪';
        }

        .task-item.disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .task-item.disabled .task-name {
            color: var(--text-tertiary);
        }

        .task-item.disabled::after {
            content: '🔒';
            font-size: 12px;
            margin-left: 8px;
        }

        .stage-header .arrow {
            margin-left: 8px;
            color: var(--text-tertiary);
            font-size: 10px;
            transition: transform 0.3s;
        }

        .stage-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .temp-tasks-section {
            border-top: 1px solid var(--border-color);
        }

        .temp-tasks-header {
            display: flex;
            align-items: center;
            padding: 10px 16px 10px 44px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
        }

        .temp-tasks-header:hover {
            background-color: #F5F5F5;
        }

        .temp-tasks-icon {
            font-size: 14px;
            margin-right: 8px;
        }

        .temp-tasks-title {
            flex: 1;
            font-size: 13px;
            font-weight: 600;
            color: #722ED1;
        }

        .temp-tasks-count {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .temp-tasks-header .arrow {
            margin-left: 8px;
            color: var(--text-tertiary);
            font-size: 10px;
            transition: transform 0.3s;
        }

        .temp-tasks-header .arrow.expanded {
            transform: rotate(180deg);
        }

        .temp-tasks-list {
            display: none;
        }

        .temp-tasks-list.show {
            display: block;
        }

        .task-list {
            display: none;
        }

        .task-list.show {
            display: block;
        }

        .task-item {
            display: flex;
            align-items: center;
            padding: 12px 16px 12px 60px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .task-item:hover {
            background-color: #E6F7FF;
        }

        .task-item:last-child {
            border-bottom: none;
        }

        .task-item .task-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 12px;
            flex-shrink: 0;
        }

        .task-item .task-status.completed {
            background-color: var(--success-color);
            color: #FFFFFF;
        }

        .task-item .task-status.confirming {
            background-color: var(--warning-color);
            color: #FFFFFF;
        }

        .task-item .task-status.executing {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .task-item .task-status.pending {
            background-color: var(--bg-tertiary);
            color: var(--text-tertiary);
        }

        .task-item .task-status.config {
            background-color: transparent;
            color: var(--text-tertiary);
            border: 1px dashed var(--border-color);
        }

        .task-item .task-status-text {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 12px;
            flex-shrink: 0;
        }

        .task-item .task-status-text .status-icon {
            font-size: 10px;
        }

        .task-item .task-status-text.pending {
            background-color: var(--status-warning-bg);
            color: var(--warning-color);
        }

        .task-item .task-status-text.config {
            background-color: #F5F5F5;
            color: #8C8C8C;
            border: 1px solid #E8E8E8;
        }

        .task-item .task-status-text.confirming {
            background-color: var(--status-primary-bg);
            color: var(--primary-color);
        }

        .task-item .task-status-text.completed {
            background-color: var(--status-success-bg);
            color: var(--success-color);
        }

        .task-item .task-status-text.executing {
            background-color: var(--status-primary-bg);
            color: var(--primary-color);
        }

        .task-item .confirm-progress {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
        }

        .task-item .confirm-progress-bar {
            flex: 1;
            height: 4px;
            background-color: var(--bg-tertiary);
            border-radius: 2px;
            overflow: hidden;
        }

        .task-item .confirm-progress-fill {
            height: 100%;
            background-color: var(--primary-color);
            border-radius: 2px;
            transition: width 0.3s;
        }

        .task-item .confirm-progress-text {
            font-size: 11px;
            color: var(--text-tertiary);
            white-space: nowrap;
        }

        .task-item .priority-badge {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: 6px;
        }

        .task-item .priority-badge.urgent {
            background-color: #FFF1F0;
            color: var(--error-color);
        }

        .task-item .priority-badge.important {
            background-color: #FFF7E6;
            color: var(--warning-color);
        }

        .task-item .priority-badge.normal {
            background-color: var(--bg-secondary);
            color: var(--text-tertiary);
        }

        .task-item .task-info {
            flex: 1;
            min-width: 0;
        }

        .task-item .task-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            line-height: 1.4;
        }

        .task-item .task-tag {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .task-item .task-tag.contract {
            background-color: #E6F7FF;
            color: #1890FF;
        }

        .task-item .task-tag.temp {
            background-color: #F9F0FF;
            color: #722ED1;
        }

        .task-item .task-tag.rejected {
            background-color: #FFF1F0;
            color: var(--error-color);
            border: 1px solid #FFCCC7;
        }

        .task-item .task-meta {
            font-size: 12px;
            color: var(--text-tertiary);
            margin-top: 4px;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 16px;
            color: var(--text-tertiary);
        }

        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
            opacity: 0.6;
        }

        .empty-state .text {
            font-size: 14px;
        }

        .result-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3px 12px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            font-size: 11px;
            color: var(--text-tertiary);
        }

        .expand-all-btn {
            color: var(--primary-color);
            cursor: pointer;
        }

        .quick-filter-bar {
            display: flex;
            padding: 8px 12px;
            gap: 6px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            flex-wrap: nowrap;
        }

        .quick-filter-bar::-webkit-scrollbar {
            display: none;
        }

        .quick-filter-btn {
            flex: 1;
            padding: 6px 8px;
            background-color: var(--bg-secondary);
            border-radius: 16px;
            font-size: 12px;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            transition: all 0.2s;
            border: 1px solid transparent;
            white-space: nowrap;
            min-width: 0;
        }

        .quick-filter-btn:hover {
            background-color: #E6F7FF;
        }

        .quick-filter-btn.active {
            background-color: var(--primary-color);
            color: #FFFFFF;
        }

        .quick-filter-btn .badge {
            background-color: rgba(255,255,255,0.3);
            padding: 0 6px;
            border-radius: 8px;
            font-size: 10px;
        }

        .quick-filter-btn:not(.active) .badge {
            background-color: var(--status-warning-bg);
            color: var(--warning-color);
        }

        /* 高级筛选抽屉样式已随筛选面板移除（2026-09-03） */


        .save-filter-btn {
            font-size: 12px;
            color: var(--primary-color);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-top: 12px;
        }

        .saved-filters {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .saved-filter-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background-color: var(--bg-secondary);
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
        }

        .saved-filter-item:hover {
            background-color: #E6F7FF;
        }

        .saved-filter-name {
            font-size: 13px;
            color: var(--text-primary);
        }

        .saved-filter-delete {
            font-size: 14px;
            color: var(--text-tertiary);
        }

        .view-switch-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 16px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
        }

        .view-switch-tabs {
            display: flex;
            background-color: var(--bg-secondary);
            border-radius: 6px;
            padding: 2px;
        }

        .view-switch-tab {
            padding: 6px 12px;
            font-size: 12px;
            color: var(--text-secondary);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .view-switch-tab.active {
            background-color: var(--bg-primary);
            color: var(--primary-color);
            font-weight: 600;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .group-by-selector {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .group-by-selector select {
            padding: 4px 8px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 12px;
            background-color: var(--bg-primary);
            cursor: pointer;
        }

        .flat-task-list {
            display: none;
        }

        .flat-task-list.show {
            display: block;
        }

        .flat-task-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            background-color: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s;
        }

        .flat-task-item:hover {
            background-color: #E6F7FF;
        }

        .flat-task-item .task-status {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 12px;
            flex-shrink: 0;
        }

        .flat-task-item .task-status.completed {
            background-color: var(--success-color);
            color: #FFFFFF;
        }

        .flat-task-item .task-status.confirming {
            background-color: var(--warning-color);
            color: #FFFFFF;
        }

        .flat-task-item .task-status.pending {
            background-color: var(--bg-tertiary);
            color: var(--text-tertiary);
        }

        .flat-task-item .task-info {
            flex: 1;
            min-width: 0;
        }

        .flat-task-item .task-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            line-height: 1.4;
        }

        .flat-task-item .task-tag {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .flat-task-item .task-tag.contract {
            background-color: #E6F7FF;
            color: #1890FF;
        }

        .flat-task-item .task-tag.temp {
            background-color: #F9F0FF;
            color: #722ED1;
        }

        .flat-task-item .priority-badge {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .flat-task-item .priority-badge.important {
            background-color: #FFF1F0;
            color: var(--error-color);
        }

        .flat-task-item .priority-badge.urgent {
            background-color: #FFF1F0;
            color: var(--error-color);
        }

        .flat-task-item .task-meta {
            font-size: 12px;
            color: var(--text-tertiary);
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .flat-task-item .task-meta .contract-name {
            color: var(--primary-color);
        }

        .flat-task-item .task-status-text {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 12px;
            flex-shrink: 0;
        }

        .flat-task-item .task-status-text.pending {
            background-color: var(--status-warning-bg);
            color: var(--warning-color);
        }

        .flat-task-item .task-status-text.confirming {
            background-color: var(--status-primary-bg);
            color: var(--primary-color);
        }

        .flat-task-item .task-status-text.completed {
            background-color: var(--status-success-bg);
            color: var(--success-color);
        }
    </style>
<style>
/* 微信原生胶囊占位（样式参考真机效果，由微信客户端实际渲染） */
.nav-bar .native-capsule {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-width: 56px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.7);
    color: rgba(0, 0, 0, 0.6);
    font-size: 12px;
    line-height: 1;
    user-select: none;
    box-sizing: border-box;
}
.nav-bar .native-capsule .nc-left,
.nav-bar .native-capsule .nc-right {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 16px;
}
.nav-bar .native-capsule .nc-right {
    font-size: 10px;
}
.nav-bar .native-capsule .nc-divider {
    width: 1px;
    height: 14px;
    background: rgba(0, 0, 0, 0.1);
    margin: 0 4px;
}
    .nav-bar .native-capsule .nc-left,
    .nav-bar .native-capsule .nc-right {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        min-width: 16px;
    }
    .nav-bar .native-capsule .nc-right {
        font-size: 10px;
    }
    .nav-bar .native-capsule .nc-divider {
        width: 1px;
        height: 14px;
        background: rgba(0, 0, 0, 0.1);
        margin: 0 4px;
    }
</style>
</head>
<body>
    <div class="phone-frame">
        <div class="status-bar">
            <div class="time">9:41</div>
            <div class="icons">📶 🔋</div>
        </div>
        
        <div class="nav-bar">
            <div class="back" onclick="history.back()">← 返回</div>
            <div class="title centered">全部任务</div>
            
            
        
            <div class="actions"><div class="native-capsule" title="微信原生胶囊：由微信客户端渲染，开发者不可自定义其内容"><span class="nc-left">⋯</span><span class="nc-divider"></span><span class="nc-right">○</span></div></div>
        </div>
            

        
        <div class="page-content">
            <div class="search-filter-bar">
                <input type="text" class="search-input" placeholder="搜索任务名称..." id="searchInput" oninput="filterTasks()">
            </div>

            <div class="quick-filter-bar" id="roleFilterBar" style="overflow-x:auto;scrollbar-width:none;">
                <button type="button" class="quick-filter-btn active" style="flex:0 0 auto;" data-role="all" onclick="applyPill('all', this)">全部</button>
                <button type="button" class="quick-filter-btn" style="flex:0 0 auto;" data-role="mine" onclick="applyPill('mine', this)">我参与</button>
                <button type="button" class="quick-filter-btn" style="flex:0 0 auto;" data-role="exec" onclick="applyPill('exec', this)">待我执行</button>
                <button type="button" class="quick-filter-btn" style="flex:0 0 auto;" data-role="confirm" onclick="applyPill('confirm', this)">待我确认</button>
                <div class="status-filter-wrap" style="position:relative;flex:0 0 auto;">
                    <button type="button" class="quick-filter-btn" id="statusSelectBtn" onclick="toggleStatusDropdown(event)">状态 ▾</button>
                    <div class="status-dropdown" id="statusDropdownMenu">
                        <div class="status-dropdown-item active" data-status="all" onclick="selectStatus('all','全部状态',this)">全部状态</div>
                        <div class="status-dropdown-item" data-status="pending" onclick="selectStatus('pending','待开始',this)">待开始</div>
                        <div class="status-dropdown-item" data-status="config" onclick="selectStatus('config','待配置',this)">待配置</div>
                        <div class="status-dropdown-item" data-status="executing" onclick="selectStatus('executing','执行中',this)">执行中</div>
                        <div class="status-dropdown-item" data-status="confirming" onclick="selectStatus('confirming','确认中',this)">确认中</div>
                        <div class="status-dropdown-item" data-status="completed" onclick="selectStatus('completed','已完成',this)">已完成</div>
                    </div>
                </div>
            </div>

            <div class="filter-tags" id="filterTags" style="display: none;"></div>

            <div class="result-bar">
                <span id="resultCount">共 26 个任务</span>
                <span class="expand-all-btn" onclick="expandAllContracts()">展开全部</span>
            </div>
            
            <div id="taskContainer">
                <div class="contract-section" data-contract="contract-1" data-level="水电工作组">
                    <div class="contract-header" onclick="toggleContract(this)">
                        <div class="contract-icon">📄</div>
                        <div class="contract-main">
                            <div class="contract-name">水电班组服务合同</div>
                            <div class="contract-footer-row">
                                <div class="contract-meta">水电工作组 · 5个阶段 · 17个任务</div>
                                <div class="contract-progress">
                                    <div class="progress-track"><div class="progress-fill"></div></div>
                                    <div class="progress-text">已完成 0/0</div>
                                </div>
                            </div>
                        </div>
                        <div class="arrow expanded">▼</div>
                    </div>
                    <div class="stage-group show">
                        <div class="stage-item" data-sequential="true">
                            <div class="stage-header" onclick="toggleStage(this)">
                                <div class="stage-dot confirming"></div>
                                <div class="stage-name">材料进场阶段</div>
                                <div class="sequential-icon" title="按序执行"></div>
                                <div class="stage-count">3/5 进行中</div>
                                <div class="arrow expanded">▼</div>
                            </div>
                            <div class="task-list show">
                                <div class="task-item" data-type="contract" data-status="completed" data-priority="normal" data-task-index="0" data-participant="true" onclick="goToTaskDetail(this)">
                                    <div class="task-status completed">✓</div>
                                    <div class="task-info">
                                        <div class="task-name">材料采购</div>
                                        <div class="task-meta">执行人：张三 · 确认人：李四、王五</div>
                                    </div>
                                    <div class="task-status-text completed"><span class="status-icon">✓</span>已完成</div>
                                </div>
                                <div class="task-item" data-type="contract" data-status="completed" data-priority="normal" data-task-index="1" data-participant="true" onclick="goToTaskDetail(this)">
