        sourceId = getQueryParam('source') || '';
        var item = getQueryParam('item') || '';
        sourceFlowId = item || (C.flowId || '');
        if (sourceFlowId && window.FlowCfgStore) {
            var fi = FlowCfgStore.find(sourceFlowId);
            sourceFlowName = (fi && fi.name) || sourceFlowId;
        } else { sourceFlowName = sourceFlowId; }
        selectedParentId = getQueryParam('parent') || '';

        var src = null;
        if (sourceId && window.ContractTreeStore) src = ContractTreeStore.byId(sourceId);
        if (!src && sourceId && window.ContractStore) src = ContractStore.getContract(sourceId);

        if (src) {
            // 命中真实来源合同：以真实值预填
            var key = (src.typeName && src.typeName.indexOf('设计') > -1) ? 'design'
                : 'base';
            sourceTypeKey = key;
            C = {
                name: src.name || FALLBACK_SOURCE.name,
                amount: (src.amount != null ? src.amount : FALLBACK_SOURCE.amount),
                typeName: src.typeName || FALLBACK_SOURCE.typeName,
                typeKey: key,
                partyA: src.partyAId || src.partyA || 'm-chenzhuang',
                partyB: src.partyBId || src.partyB || '',
                contentIntro: SERVICE_STAGE_TEMPLATES[key].contentIntro,
                stages: clone(SERVICE_STAGE_TEMPLATES[key].stages),
                extra: '无',
                attachments: (src.attachments && src.attachments.length) ? clone(src.attachments) : clone(FALLBACK_SOURCE.attachments)
            };
            if (src.flowId || src.flowName) { sourceFlowId = src.flowId || sourceFlowId; sourceFlowName = src.flowName || sourceFlowName; }
        } else {
            // 无真实来源：使用内置演示蓝本
            C = clone(FALLBACK_SOURCE);
            sourceTypeKey = 'base';
        }

        // 甲方 / 乙方 默认
        partyA = memberById(C.partyA) || memberById('m-chenzhuang');
        partyB = C.partyB ? memberById(C.partyB) : null;

        applySourceToForm();
        renderFlowDisplay();
        renderPartyA();
        renderPartyB();
        renderStages();
        renderAtts();
        renderStagesBadge();
        renderAttachBadge();
        $('copyNoteSource').textContent = C.name;
    }

    function applySourceToForm() {
        $('contractTypeInput').value = C.typeName || '基础施工服务合同';
        $('editNameInput').value = C.name || '';
        $('editAmountInput').value = C.amount || '';
        $('breachInput').value = '1、甲方逾期付款的，按逾期金额千分之三/日支付违约金。\n2、乙方工期延误或质量不符的，应无偿返工并承担违约责任。';
        $('editContractExtra').value = C.extra || '无';
    }

    /* ===================== 隶属服务流程层级 ===================== */
    function renderFlowDisplay() {
        $('flowItemValue').textContent = sourceFlowName ? ('所属服务流程项：' + sourceFlowName) : '未指定服务流程项';
        var badge = $('flowLevelBadge'), val = $('flowLevelValue'), tag = $('flowLevelTag'), scope = $('flowLevelScope');
        var parentName = '';
        if (selectedParentId && window.ContractTreeStore) {
            var p = ContractTreeStore.listByFlow(sourceFlowId).filter(function (c) { return c.id === selectedParentId; })[0];
            parentName = p ? p.name : '';
        }
        if (parentName) {
            badge.textContent = '子级';
            val.textContent = parentName;
            tag.textContent = flowLevelAdjusted ? '已更换' : '沿用蓝本';
            tag.className = 'al-tag' + (flowLevelAdjusted ? ' adj' : '');
            scope.textContent = '上级合同';
        } else {
            badge.textContent = '直属';
            val.textContent = '直属本流程项';
            tag.textContent = flowLevelAdjusted ? '已更换' : '默认';
            tag.className = 'al-tag' + (flowLevelAdjusted ? ' adj' : '');
            scope.textContent = '';
        }
    }
    function openFlowLevelPicker() {
        var list = (window.ContractTreeStore && sourceFlowId) ? ContractTreeStore.listByFlow(sourceFlowId).filter(function (c) { return c.id !== sourceId; }) : [];
        var html = '';
        html += '<div class="tpl-item" onclick="pickFlowLevel(\'\')"><div class="tpl-icon">📄</div><div class="tpl-content"><div class="tpl-name">直属本流程项</div><div class="tpl-desc">作为该流程项下的直属合同</div></div>' + (selectedParentId === '' ? '<div class="tpl-use">当前</div>' : '') + '</div>';
        list.forEach(function (c) {
            html += '<div class="tpl-item" onclick="pickFlowLevel(\'' + escapeHtml(c.id) + '\')"><div class="tpl-icon">📋</div><div class="tpl-content"><div class="tpl-name">' + escapeHtml(c.name) + '</div><div class="tpl-desc">' + escapeHtml((c.typeName || '合同') + ' · ' + (c.ct === 'service' ? '服务合同' : '工人合同')) + '</div></div>' + (selectedParentId === c.id ? '<div class="tpl-use">当前</div>' : '') + '</div>';
        });
        $('wcdSheetTitle').textContent = '选择隶属层级（含类型）';
        $('wcdSheetBody').innerHTML = html;
        openSheet();
    }
    function pickFlowLevel(pid) {
        selectedParentId = pid || '';
        flowLevelAdjusted = (pid !== (getQueryParam('parent') || ''));
        renderFlowDisplay();
        closeSheet();
    }

    /* ===================== 甲方 / 乙方 选择 ===================== */
    function renderPartyA() {
        var chips = $('partyAChips');
        chips.innerHTML = partyA ? '<span class="invite-chip">' + escapeHtml(partyA.name) + '（' + escapeHtml(partyA.role) + '）<span class="x" onclick="clearPartyA(event)">×</span></span>' : '';
    }
    function clearPartyA(e) { if (e) e.stopPropagation(); partyA = null; renderPartyA(); }
    function togglePartyAPanel() { $('partyAPanelBox').classList.toggle('open'); $('partyBPanelBox').classList.remove('open'); }
    function filterPartyA() {
        var q = ($('partyASearch').value || '').trim();
        var list = PROJECT_MEMBERS.filter(function (m) { return !q || m.name.indexOf(q) > -1 || m.role.indexOf(q) > -1; });
        var box = $('partyAList');
        if (!list.length) { box.innerHTML = ''; $('partyAEmpty').style.display = 'block'; return; }
        $('partyAEmpty').style.display = 'none';
        box.innerHTML = list.map(function (m) {
            return '<div class="member-picker-item' + (partyA && partyA.id === m.id ? ' selected' : '') + '" onclick="selectPartyA(\'' + m.id + '\')">' + escapeHtml(m.name) + '（' + escapeHtml(m.role) + '）' + (partyA && partyA.id === m.id ? '<span class="check">✓</span>' : '') + '</div>';
        }).join('');
    }
    function selectPartyA(id) {
        partyA = memberById(id);
        markAdjusted('PartyA');
        renderPartyA();
        $('partyAPanelBox').classList.remove('open');
    }

    function renderPartyB() {
        var chips = $('partyBChips');
        chips.innerHTML = partyB ? '<span class="invite-chip">' + escapeHtml(partyB.name) + '（' + escapeHtml(partyB.role) + '）<span class="x" onclick="clearPartyB(event)">×</span></span>' : '';
        $('partyBValue').textContent = partyB ? (partyB.name + '（' + partyB.role + '）') : '点击选择承接方 ›';
    }
    function clearPartyB(e) { if (e) e.stopPropagation(); partyB = null; renderPartyB(); }
    function togglePartyBPanel() { $('partyBPanelBox').classList.toggle('open'); $('partyAPanelBox').classList.remove('open'); }
    function filterPartyB() {
        var q = ($('partyBSearch').value || '').trim();
        var list = PROJECT_MEMBERS.filter(function (m) { return !q || m.name.indexOf(q) > -1 || m.role.indexOf(q) > -1; });
        var box = $('partyBList');
        if (!list.length) { box.innerHTML = ''; $('partyBEmpty').style.display = 'block'; return; }
        $('partyBEmpty').style.display = 'none';
        box.innerHTML = list.map(function (m) {
            return '<div class="member-picker-item' + (partyB && partyB.id === m.id ? ' selected' : '') + '" onclick="selectPartyB(\'' + m.id + '\')">' + escapeHtml(m.name) + '（' + escapeHtml(m.role) + '）' + (partyB && partyB.id === m.id ? '<span class="check">✓</span>' : '') + '</div>';
        }).join('');
    }
    function selectPartyB(id) {
        partyB = memberById(id);
        markAdjusted('PartyB');
        renderPartyB();
        $('partyBPanelBox').classList.remove('open');
    }

    /* ===================== 合同正文 / 模板 ===================== */
    function switchDraftTab(el, key) {
        var panes = document.querySelectorAll('.content-tab-pane');
        for (var i = 0; i < panes.length; i++) panes[i].classList.remove('active');
        $('pane-' + key).classList.add('active');
        var tabs = document.querySelectorAll('.content-tab');
        for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
        el.classList.add('active');
    }
    function showDraftTemplatePicker() {
        var html = TEXT_TEMPLATES.map(function (t) {
            return '<div class="tpl-item" onclick="useTextTemplate(\'' + t.key + '\')"><div class="tpl-icon">📄</div><div class="tpl-content"><div class="tpl-name">' + escapeHtml(t.name) + '</div><div class="tpl-desc">' + escapeHtml(t.desc) + '</div></div><div class="tpl-use">使用</div></div>';
        }).join('');
        $('wcdSheetTitle').textContent = '更换正文模板';
        $('wcdSheetBody').innerHTML = html;
        openSheet();
    }
    function useTextTemplate(key) {
        sourceTypeKey = key;
        C.typeKey = key;
        C.contentIntro = SERVICE_STAGE_TEMPLATES[key].contentIntro;
        C.stages = clone(SERVICE_STAGE_TEMPLATES[key].stages);
        C.typeName = key === 'design' ? '设计服务合同' : '基础施工服务合同';
        $('contractTypeInput').value = C.typeName;
        markAdjusted('TplText');
        markStagesDirty();
        renderStages();
        closeSheet();
        showToast('已更换正文模板：' + C.typeName);
    }

    /* ===================== 阶段任务 ===================== */
    function renderStages() {
        var box = $('draftStageList');
        box.innerHTML = C.stages.map(function (s, si) {
            var tasks = s.tasks.map(function (t, ti) {
                return '<div class="task-row"><span class="task-name">' + escapeHtml(t.name) + '</span>' +
                    '<span class="task-conf">执行：' + escapeHtml(t.exec || '-') + ' / 确认：' + escapeHtml(t.conf || '-') + '</span>' +
                    '<span class="task-del" onclick="removeTask(' + si + ',' + ti + ')">删除</span></div>';
            }).join('');
            return '<div class="stage-block"><div class="stage-head"><span><span class="stage-name">' + escapeHtml(s.name) + '</span><span class="stage-order">' + escapeHtml(s.order || '') + '</span></span>' +
                '<span class="stage-del" onclick="removeStage(' + si + ')">删除阶段</span></div>' + tasks +
                '<div class="add-task-btn" onclick="addTask(' + si + ')">+ 添加任务</div></div>';
        }).join('');
    }
    function addDraftStage() {
        C.stages.push({ name: '新阶段', order: '顺序执行', tasks: [{ name: '新任务', exec: '', conf: '', execStd: '', confStd: '', liableStd: '' }] });
        markStagesDirty(); renderStages();
    }
    function removeStage(i) { C.stages.splice(i, 1); markStagesDirty(); renderStages(); }
    function addTask(i) { C.stages[i].tasks.push({ name: '新任务', exec: '', conf: '', execStd: '', confStd: '', liableStd: '' }); markStagesDirty(); renderStages(); }
    function removeTask(i, j) { C.stages[i].tasks.splice(j, 1); markStagesDirty(); renderStages(); }

    /* ===================== 附件 ===================== */
    function renderAtts() {
        var box = $('draftAttList');
        box.innerHTML = (C.attachments || []).map(function (a, i) {
            return '<div class="attachment-item"><span class="file-icon">📎</span><div class="file-info"><div class="file-name">' + escapeHtml(a.name) + '</div><div class="file-meta">' + escapeHtml(a.meta || '') + '</div></div><span class="delete-btn" onclick="removeAtt(' + i + ')">删除</span></div>';
        }).join('');
    }
    function addDraftAttachment() {
        C.attachments = C.attachments || [];
        C.attachments.push({ name: '新附件.pdf', meta: '0.0MB' });
        markAttsDirty(); renderAtts();
    }
    function removeAtt(i) { C.attachments.splice(i, 1); markAttsDirty(); renderAtts(); }

    /* ===================== 顶部「更多」菜单 ===================== */
    function renderMoreOps() {
        var panel = $('moreOpsPanel'); if (!panel) return;
        var items = [
            { icon: '📋', label: '版本记录', fn: 'showVersionModal()' },
            { icon: '📜', label: '变更记录', fn: 'showChangeRecordModal()' },
            { icon: '📄', label: '导出合同文件', fn: 'exportContract()' }
        ];
        panel.innerHTML = items.map(function (it) {
            return '<div class="op-item" onclick="' + it.fn + '; closeMoreOps();">' +
                '<span class="op-icon">' + it.icon + '</span><span>' + it.label + '</span></div>';
        }).join('');
    }
    function toggleMoreOps() {
        var p = $('moreOpsPanel'), b = $('moreOpsBtn');
        if (!p) return;
        p.classList.toggle('show');
        if (b) b.classList.toggle('open');
    }
    function closeMoreOps() {
        var p = $('moreOpsPanel'), b = $('moreOpsBtn');
        if (p) p.classList.remove('show');
        if (b) b.classList.remove('open');
    }
    function showVersionModal() {
        $('infoModalTitle').textContent = '版本记录';
        $('infoModalBody').innerHTML = '<div class="rec-row"><span class="rec-tag">v1.0</span>复制发起初始版本（沿用蓝本内容）</div><div class="rec-row"><span class="rec-tag">当前</span>拟定中 · 可编辑</div>';
        openInfoModal();
    }
    function showChangeRecordModal() {
        $('infoModalTitle').textContent = '变更记录';
        $('infoModalBody').innerHTML = '<div class="rec-row">暂无变更记录</div>';
        openInfoModal();
    }
    function exportContract() { showToast('已导出合同文件（演示）'); }
    function openInfoModal() { $('infoModalMask').classList.add('show'); }
    function closeInfoModal() { $('infoModalMask').classList.remove('show'); }

    /* ===================== 抽屉 ===================== */
    function openSheet() { $('wcdSheetMask').classList.add('show'); }
    function closeSheet() { $('wcdSheetMask').classList.remove('show'); }

    /* ===================== 提交 / 保存 / 取消（复制发起） ===================== */
    function buildNewContract(status) {
        var name = ($('editNameInput').value || '').trim();
        var amountRaw = ($('editAmountInput').value || '').trim();
        var amount = Number(amountRaw);
        var newId = (status === 'draft' ? 'copy-draft-' : 'copy-') + Date.now();
        var data = {
            id: newId,
            name: name || C.name,
            ct: 'service',
            typeName: C.typeName,
            flowId: sourceFlowId,
            flowName: sourceFlowName,
            parent: selectedParentId || null,
            status: status,
            amount: amount,
            partyA: partyA ? partyA.name : '',
            partyAId: partyA ? partyA.id : '',
            partyB: partyB ? partyB.name : '',
            partyBId: partyB ? partyB.id : '',
            source: sourceId
        };
        if (window.ContractTreeStore) ContractTreeStore.add(data);
        return data;
    }
    function doSubmit() {
        if (!sourceFlowId) { showToast('缺少所属服务流程项，请从合同列表重新发起'); return; }
        var name = ($('editNameInput').value || '').trim();
        if (!name) { showToast('请填写合同名称'); return; }
        var amountRaw = ($('editAmountInput').value || '').trim();
        var amount = Number(amountRaw);
        if (!amountRaw || isNaN(amount) || amount <= 0) { showToast('请填写有效的合同金额'); return; }
        if (!partyB) { showToast('请选择合同乙方（承接方）'); return; }
        var breach = $('breachInput');
        if (!breach || breach.value.trim() === '') {
            if (breach) { breach.classList.add('required-error'); breach.focus(); }
            showToast('请填写「违约责任」后再提交（必填项）');
            return;
        }
        if (breach) breach.classList.remove('required-error');
        var data = buildNewContract('draft');
        showToast('已提交，生成新合同：' + data.name);
        setTimeout(function () {
            var params = new URLSearchParams({
                id: data.id,
                name: data.name,
                typeName: data.typeName,
                partyA: data.partyAId,
                partyAName: data.partyA,
                partyB: data.partyBId,
                partyBName: data.partyB,
                amount: data.amount,
                flowId: sourceFlowId,
                flowName: sourceFlowName,
                from: 'copy',
                parent: selectedParentId || '',
                status: 'draft',
                new: '1'
            });
            window.location.href = 'contract-detail.html?' + params.toString();
        }, 1800);
    }
    function doSave() {
        var breach = $('breachInput');
        if (breach) breach.classList.remove('required-error');
        buildNewContract('draft');
        showToast('已保存草稿');
    }
    /* 复制发起特有：取消 = 放弃本次复制发起，返回原合同详情（无来源则回列表） */
    function doCancelCopy() {
        showToast('已取消复制发起，返回原合同');
        setTimeout(function () {
            location.href = sourceId ? ('contract-detail.html?id=' + encodeURIComponent(sourceId)) : 'contract-list.html';
        }, 600);
    }

    /* ===================== 初始化 ===================== */
    function init() {
        renderMoreOps();
        filterPartyA();
        filterPartyB();
        loadSource();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
</script>
</body>
</html>
