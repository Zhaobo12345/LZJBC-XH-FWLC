<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="SvcCopyInitiate">
<head data-page-node-id="SvcCopyHead">
    <meta charset="UTF-8" data-page-node-id="SvcCopyCharset">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" data-page-node-id="SvcCopyViewport">
    <title>家装平台小程序原型 - 非工人合同（复制发起）</title>
    <link rel="stylesheet" href="common.css" data-page-node-id="SvcCopyCss1">
    <link rel="stylesheet" href="css/contract-detail.css" data-page-node-id="SvcCopyCss2">
    <style>
        /* ===== 复制发起（非工人 / 服务类）：与工人侧 contract-copy-initiate.html 视觉一致，字段按服务类合同呈现 ===== */
        * { box-sizing: border-box; }

        /* 手机端小程序：仅隐藏手机框内滚动条（沿用 common.css 约定，作用域限定 .phone-frame，不影响原型导航） */
        .phone-frame ::-webkit-scrollbar { display: none; }
        .phone-frame * { scrollbar-width: none; -ms-overflow-style: none; }

        body {
            background: #e9ebee;
            font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
        }

        .phone-frame {
            width: 375px; height: 812px; background: #f2f3f5;
            border-radius: 40px; overflow: hidden; position: relative; flex-shrink: 0;
            box-shadow: 0 12px 40px rgba(0,0,0,.25); display: flex; flex-direction: column;
        }
        .status-bar {
            height: 44px; background: #fff; display: flex; align-items: center;
            justify-content: space-between; padding: 0 22px; font-size: 14px;
            font-weight: 600; color: #000; flex-shrink: 0;
        }
        .nav-bar {
            height: 44px; background: #fff; display: flex; align-items: center;
            position: relative; border-bottom: 1px solid #ececec; flex-shrink: 0;
        }
        .nav-bar .nb-back {
            position: absolute; left: 14px; font-size: 26px; line-height: 1;
            color: #1a1a1a; text-decoration: none; width: 28px;
        }
        .nav-bar .title { flex: 1; text-align: center; font-size: 17px; font-weight: 600; color: #1a1a1a;  padding: 0 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .nav-bar .actions { position: absolute; right: 14px; }
        .native-capsule {
            display: inline-flex; align-items: center; border: 1px solid #e3e3e3; border-radius: 14px;
            padding: 3px 8px; font-size: 13px; color: #333; background: #fff;
        }
        .native-capsule .nc-divider { width: 1px; height: 14px; background: #e3e3e3; margin: 0 6px; }

        .page-content {
            flex: 1; overflow-y: auto; padding: 0; background: #f2f3f5;
        }
        .content-toolbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px 0; font-size: 13px; color: #888;
        }
        .content-toolbar .tb-hint { font-size: 12px; color: #C0C4CC; }
        .text-more-btn {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 13px; color: #1677FF;
            padding: 4px 8px; border-radius: 6px; cursor: pointer;
        }
        .text-more-btn:active { background-color: #F7F8FA; }
        .text-more-btn .caret { font-size: 10px; transition: transform 0.2s; }
        .text-more-btn.open .caret { transform: rotate(180deg); }
        .more-ops-panel {
            display: none; margin: 4px 12px 0;
            background: #fff; border: 1px solid #E5E6EB; border-radius: 10px; overflow: hidden;
        }
        .more-ops-panel.show { display: block; }
        .more-ops-panel .op-item {
            display: flex; align-items: center; gap: 10px;
            padding: 11px 14px; font-size: 14px; color: #1D2129;
            border-bottom: 1px solid #F2F3F5; cursor: pointer;
        }
        .more-ops-panel .op-item:last-child { border-bottom: none; }
        .more-ops-panel .op-icon { font-size: 15px; }

        /* 状态横幅（拟定中） */
        .wc-banner {
            margin: 4px 12px 6px; padding: 8px 12px; border-radius: 10px; color: #fff;
        }
        .wc-banner.draft { background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%); }
        .wc-banner-text { font-size: 14px; font-weight: 700; }
        .wc-banner-desc { font-size: 11px; opacity: .92; margin-top: 2px; line-height: 1.4; }

        /* 状态进度步骤条：拟定中（当前）→ 确认中 → 已签约 */
        .worker-flow { display: flex; align-items: center; margin: 2px 12px 4px; }
        .wf-step { display: flex; flex-direction: column; align-items: center; width: 60px; flex-shrink: 0; }
        .wf-circle {
            width: 28px; height: 28px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; background: #F2F3F5;
            border: 2px solid #E5E6EB; color: #86909C;
        }
        .wf-step.current .wf-circle { background: #E8F3FF; border-color: #1677FF; color: #1677FF; }
        .wf-label { font-size: 10px; margin-top: 3px; color: #86909C; }
        .wf-step.current .wf-label { color: #1677FF; font-weight: 600; }
        .wf-line { flex: 1; height: 2px; background: #E5E6EB; margin: 0 -4px 14px; }

        /* 卡片通用 */
        .worker-invite-card {
            margin: 0 12px 12px; background: #fff; border-radius: 12px; padding: 14px;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
        }
        .card-title { font-size: 14px; font-weight: 600; color: #222; margin-bottom: 10px; }
        .card-note { font-size: 12px; font-weight: 400; color: #999; margin-left: 4px; }

        .invite-edit-panel {
            margin-top: 6px; border: 1px solid var(--primary-light);
            border-radius: 10px; padding: 12px; background: var(--status-primary-bg);
        }

        .form-section-title { font-size: 13px; font-weight: 600; color: #333; margin: 14px 0 8px; }
        .form-section-title:first-child { margin-top: 0; }

        /* 可编辑字段 */
        .edit-field { margin-bottom: 10px; }
        .edit-field label { display: block; font-size: 12px; color: #888; margin-bottom: 4px; }
        .edit-input {
            width: 100%; height: 38px; border: 1px solid #e3e3e3; border-radius: 8px;
            padding: 0 10px; font-size:14px; color: #333; background: #fff; font-family: inherit;
        }
        .edit-input:focus { border-color: #1677ff; outline: none; box-shadow: 0 0 0 2px rgba(22,119,255,.12); }
        .edit-input[readonly] { background: #f7f8fa; color: #999; }

        .edit-textarea {
            width: 100%; min-height: 96px; border: 1px solid #e3e3e3; border-radius: 8px;
            padding: 9px 10px; font-size: 13px; color: #333; line-height: 1.7; resize: vertical;
            background: #fff; font-family: inherit;
        }
        .edit-textarea:focus { border-color: #1677ff; outline: none; box-shadow: 0 0 0 2px rgba(22,119,255,.12); }
        .edit-textarea.required-error { border-color: #ff4d4f; background: #fff2f0; box-shadow: 0 0 0 2px rgba(255,77,79,.12); }
        .edit-textarea.plain { min-height: 70px; }
        .field-required-tag { color: #ff4d4f; margin-left: 4px; font-size: 12px; font-weight: 400; }
        .field-hint { font-size: 11px; color: #999; margin-top: 5px; line-height: 1.5; }
        .muted { color: #999; font-size: 12px; margin-left: 4px; }

        /* 乙方 chips / 选择面板 */
        .invite-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
        .invite-chip {
            display: inline-flex; align-items: center; gap: 4px;
            background: #f0f7ff; border: 1px solid #bae0ff; color: #1677ff;
            font-size: 13px; padding: 5px 10px; border-radius: 16px;
        }
        .invite-chip .x { color: #ff4d4f; cursor: pointer; font-weight: 700; }
        .member-picker { position: relative; }
        .member-picker-control {
            border: 1px solid #e3e3e3; border-radius: 8px; padding: 10px 12px;
            background: #fff; font-size: 13px; color: #666; cursor: pointer;
        }
        .member-picker-panel {
            display: none; margin-top: 6px; border: 1px solid #e3e3e3;
            border-radius: 8px; background: #fff; max-height: 220px; overflow-y: auto;
        }
        .member-picker-panel.open { display: block; }
        .member-picker-search {
            width: 100%; box-sizing: border-box; border: none; border-bottom: 1px solid #eee;
            padding: 10px 12px; font-size: 13px; outline: none; background: #fff;
        }
        .member-picker-list { padding: 4px 0; }
        .member-picker-item {
            display: flex; align-items: center; justify-content: flex-start;
            padding: 10px 12px; font-size: 13px; cursor: pointer; color: #222;
        }
        .member-picker-item:hover { background: #f5f5f5; }
        .member-picker-item.selected { color: #1677ff; font-weight: 600; }
        .member-picker-empty { padding: 16px; text-align: center; color: #999; font-size: 13px; }

        /* 合同甲方：当前甲方与「更换甲方」同行 */
        .party-a-row { position: relative; display: flex; align-items: center; gap: 10px; }
        .party-a-row .invite-chips { margin-bottom: 0; flex: 1; min-width: 0; }
        .party-a-picker { position: static; flex: 0 0 auto; }
        .party-a-picker .member-picker-control {
            padding: 6px 12px; color: #1677ff; border-color: #bae0ff; background: #f0f7ff; white-space: nowrap;
        }
        .party-a-picker .member-picker-panel {
            position: absolute; left: 0; right: 0; top: 100%; margin-top: 6px; z-index: 50;
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
        }

        /* 合同内容卡片 */
        .contract-content-card {
            margin: 0 12px 12px; background: #fff; border-radius: 12px; padding: 14px;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
        }
        .content-tabs { display: flex; border-bottom: 1px solid #f0f0f0; margin-bottom: 12px; }
        .content-tab {
            flex: 1; text-align: center; padding: 10px 0; font-size: 13px; color: #666; cursor: pointer; position: relative;
        }
        .content-tab.active { color: #1677ff; font-weight: 600; }
        .content-tab.active::after {
            content: ""; position: absolute; bottom: -1px; left: 50%; transform: translateX(-50%); width: 40px; height: 2px; background: #1677ff; border-radius: 2px;
        }
        .content-tab-pane { display: none; }
        .content-tab-pane.active { display: block; }

        .form-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
        .form-label { font-size: 13px; color: #333; font-weight: 600; }
        .view-full-link {
            font-size: 12px; color: #1677ff; text-decoration: none; font-weight: 600;
            display: inline-flex; align-items: center; gap: 2px; padding: 2px 0;
        }
        .view-full-link::after { content: " >"; }

        .template-info { margin-bottom: 10px; background: #f0f7ff; border: 1px solid #bae0ff; border-radius: 8px; padding: 8px 10px; }
        .template-tag { font-size: 12px; color: #1677ff; font-weight: 600; }
        .template-hint { font-size: 11px; color: #99c0ff; margin-top: 2px; }

        /* 阶段任务 */
        .stage-block { border: 1px solid #eef0f3; border-radius: 10px; padding: 10px; margin-bottom: 10px; background: #fafbfc; }
        .stage-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
        .stage-name { font-size: 13px; font-weight: 600; color: #222; }
        .stage-order { font-size: 11px; color: #999; margin-left: 6px; }
        .stage-del { color: #ff4d4f; font-size: 12px; cursor: pointer; }
        .task-row { display: flex; align-items: center; justify-content: space-between; padding: 7px 0; border-top: 1px solid #f0f0f0; font-size: 13px; color: #333; }
        .task-row:first-child { border-top: none; }
        .task-row .task-name { flex: 1; }
        .task-row .task-conf { font-size: 11px; color: #999; margin-left: 8px; }
        .task-row .task-del { color: #ff4d4f; font-size: 12px; cursor: pointer; margin-left: 8px; }
        .add-stage-btn, .add-task-btn {
            display: inline-block; margin-top: 4px; padding: 7px 12px; border-radius: 8px;
            background: #f0f7ff; color: #1677ff; font-size: 13px; cursor: pointer; font-weight: 600;
        }
        .add-task-btn { margin-left: 6px; background: #f6ffed; color: #52c41a; }

        /* 附件 */
        .attachment-upload-area { border: 1px dashed #d9d9d9; border-radius: 10px; padding: 18px; text-align: center; cursor: pointer; background: #fafafa; margin-bottom: 10px; }
        .attachment-upload-area .upload-icon { font-size: 24px; }
        .attachment-upload-area .upload-text { font-size: 13px; color: #333; margin-top: 6px; }
        .attachment-upload-area .upload-hint { font-size: 11px; color: #999; margin-top: 2px; }
        .attachment-list .attachment-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f5f5f5; }
        .attachment-list .attachment-item:last-child { border-bottom: none; }
        .attachment-list .file-icon { font-size: 20px; }
        .attachment-list .file-info { flex: 1; }
        .attachment-list .file-name { font-size: 13px; color: #333; }
        .attachment-list .file-meta { font-size: 11px; color: #999; }
        .attachment-list .delete-btn { color: #ff4d4f; font-size: 13px; cursor: pointer; }

        /* 底部操作栏（吸底） */
        .sticky-cta {
            display: flex; gap: 12px; padding: 12px 16px; background: #fff;
            border-top: 1px solid #eee; flex-shrink: 0;
        }
        .cta-btn { flex: 1; height: 46px; border-radius: 23px; font-size: 16px; font-weight: 600; border: none; cursor: pointer; }
        .cta-secondary { background: #f5f5f5; color: #666; flex: 0 0 88px; font-size: 14px; }
        .cta-primary { background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%); color: #fff; }

        /* 复制发起特有：沿用 / 已调整 徽标 */
        .copy-badge {
            display: inline-block; margin-left: 6px; padding: 1px 8px;
            border-radius: 8px; font-size: 10px; font-weight: 500; vertical-align: middle;
        }
        .copy-badge.keep { background: #F2F3F5; color: #86909C; }
        .copy-badge.adjusted { background: #FFF7E6; color: #FA8C16; }

        /* 复制发起说明侧栏 */
        .copy-demo-stage { display: flex; flex-wrap: nowrap; justify-content: center; align-items: flex-start; gap: 16px; padding: 20px 12px; }
        .copy-demo-stage .phone-frame { margin: 0; flex-shrink: 0; }
        .copy-note { flex: 0 1 220px; min-width: 150px; box-sizing: border-box; padding: 6px 0 6px 12px; background-color: transparent; border: none; border-left: 2px dashed #91CAFF; border-radius: 0; font-size: 11px; line-height: 1.65; color: #1677FF; }
        .copy-note .cn-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
        .copy-note p { margin: 0 0 8px; }
        .copy-note p:last-child { margin-bottom: 0; }

        /* 隶属服务流程层级（含类型） */
        .arch-level-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px; background: #fff; border: 1px solid var(--primary-light);
            border-radius: 10px; cursor: pointer; margin-top: 4px;
        }
        .arch-level-row:active { background: #F7F8FA; }
        .arch-level-row .al-value { display: flex; align-items: center; gap: 6px; min-width: 0; overflow: hidden; font-size: 14px; color: #222; font-weight: 500; }
        .arch-level-row .al-value .al-tag { font-size: 10px; color: #00B42A; background: #E8FFEA; border-radius: 4px; padding: 1px 6px; font-weight: 600; flex-shrink: 0; }
        .arch-level-row .al-value .al-tag.adj { color: #FA8C16; background: #FFF3E6; }
        .arch-level-row .al-change { font-size: 13px; color: #1677FF; flex-shrink: 0; margin-left: 8px; }
        .arch-level-hint { font-size: 11px; color: #999; margin-top: 6px; line-height: 1.5; }
        .al-badge { font-size: 10px; color: #1677FF; background: #E6F0FF; border-radius: 4px; padding: 1px 6px; font-weight: 600; flex-shrink: 0; }

        /* toast */
        .app-toast {
            position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
            background: rgba(0,0,0,.8); color: #fff; font-size: 13px; padding: 10px 16px;
            border-radius: 8px; z-index: 350; opacity: 0; pointer-events: none; transition: opacity .2s; white-space: pre-line; text-align: center;
        }
        .app-toast.show { opacity: 1; }

        /* 通用信息弹窗 / 底部选择抽屉 */
        .info-modal-mask {
            position: absolute; inset: 0; background: rgba(0,0,0,.45);
            display: none; align-items: center; justify-content: center; z-index: 320;
        }
        .info-modal-mask.show { display: flex; }
        .info-modal {
            width: 80%; max-width: 300px; background: #fff; border-radius: 12px;
            padding: 18px; box-sizing: border-box; max-height: 70%; overflow-y: auto;
        }
        .info-modal-title { font-size: 15px; font-weight: 600; margin-bottom: 10px; }
        .info-modal-body { font-size: 13px; color: #444; line-height: 1.6; }
        .info-modal-body .rec-row { padding: 8px 0; border-bottom: 1px solid #f2f3f5; }
        .info-modal-body .rec-row:last-child { border-bottom: none; }
        .info-modal-body .rec-tag { display: inline-block; font-size: 11px; color: #1677ff; background: #e6f4ff; border-radius: 4px; padding: 1px 6px; margin-right: 6px; }
        .info-modal-close {
            margin-top: 14px; text-align: center; color: #1677ff; font-size: 14px;
            padding: 8px; border-radius: 8px; background: #f0f7ff; cursor: pointer;
        }
        .wcd-modal-mask {
            position: absolute; left: 0; top: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,.45); z-index: 320; display: none; align-items: flex-end;
        }
        .wcd-modal-mask.show { display: flex; }
        .wcd-sheet { width: 100%; max-height: 72%; background: #fff; border-radius: 14px 14px 0 0; display: flex; flex-direction: column; overflow: hidden; }
        .wcd-sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid #f0f0f0; }
        .wcd-sheet-head .title { font-size: 15px; font-weight: 600; color: #222; }
        .wcd-sheet-head .close { font-size: 18px; color: #999; cursor: pointer; }
        .wcd-sheet-body { padding: 8px 16px 16px; overflow-y: auto; }
        .tpl-item { display: flex; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid #f5f5f5; }
        .tpl-item:last-child { border-bottom: none; }
        .tpl-item .tpl-icon { width: 38px; height: 38px; border-radius: 9px; background: #f0f7ff; color: #1677ff; display: flex; align-items: center; justify-content: center; font-size: 18px; flex: 0 0 auto; }
        .tpl-item .tpl-content { flex: 1; }
        .tpl-item .tpl-name { font-size: 14px; color: #222; font-weight: 600; }
        .tpl-item .tpl-desc { font-size: 11px; color: #999; margin-top: 3px; }
        .tpl-item .tpl-use { background: #1677ff; color: #fff; font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer; flex: 0 0 auto; }
        .wcd-sheet-foot { padding: 12px 16px; border-top: 1px solid #f5f5f5; }
        .wcd-sheet-foot .btn { display: block; width: 100%; text-align: center; padding: 11px; border-radius: 22px; font-size: 14px; cursor: pointer; background: #f5f5f5; color: #666; }
    </style>
</head>
<body data-page-node-id="SvcCopyBody">
<div class="copy-demo-stage">
<div class="phone-frame" data-page-node-id="SvcCopyFrame">
    <div class="status-bar" data-page-node-id="SvcCopySb">
        <div class="time" data-page-node-id="SvcCopyTime">9:41</div>
        <div class="icons" data-page-node-id="SvcCopyIcons">📶 🔋</div>
    </div>
    <div class="nav-bar" data-page-node-id="SvcCopyNav">
        <a class="nb-back" href="contract-detail.html" data-page-node-id="SvcCopyBack">&lsaquo;</a>
        <div class="title" data-page-node-id="SvcCopyTitle">复制发起</div>
        <div class="actions" data-page-node-id="SvcCopyActions"><div class="native-capsule" title="微信原生胶囊：由微信客户端渲染，开发者不可自定义其内容" data-page-node-id="SvcCopyCapsule"><span data-page-node-id="SvcCopyCapsule1">⋯</span><span class="nc-divider" data-page-node-id="SvcCopyCapsule2"></span><span data-page-node-id="SvcCopyCapsule3">○</span></div></div>
    </div>

    <div class="page-content" data-page-node-id="SvcCopyContent">
        <div class="content-toolbar" data-page-node-id="SvcCopyTb">
            <span class="tb-hint" data-page-node-id="SvcCopyTbHint">合同操作</span>
            <span class="text-more-btn" id="moreOpsBtn" onclick="toggleMoreOps()" data-page-node-id="SvcCopyMore">更多<span class="caret" data-page-node-id="SvcCopyCaret">▾</span></span>
        </div>
        <div class="more-ops-panel" id="moreOpsPanel" data-page-node-id="SvcCopyMorePanel"></div>

        <!-- 状态进度步骤条：拟定中（当前）→ 确认中 → 已签约 -->
        <div class="worker-flow" data-page-node-id="SvcCopyFlow">
            <div class="wf-step current" data-page-node-id="SvcCopyStep1"><div class="wf-circle" data-page-node-id="SvcCopyC1">✏️</div><div class="wf-label" data-page-node-id="SvcCopyL1">拟定中</div></div>
            <div class="wf-line" data-page-node-id="SvcCopyLine1"></div>
            <div class="wf-step" data-page-node-id="SvcCopyStep2"><div class="wf-circle" data-page-node-id="SvcCopyC2">🤝</div><div class="wf-label" data-page-node-id="SvcCopyL2">确认中</div></div>
            <div class="wf-line" data-page-node-id="SvcCopyLine2"></div>
            <div class="wf-step" data-page-node-id="SvcCopyStep3"><div class="wf-circle" data-page-node-id="SvcCopyC3">📄</div><div class="wf-label" data-page-node-id="SvcCopyL3">已签约</div></div>
