<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>家装平台小程序原型 - 项目主页（进行中）</title>
<style>
/* ===== 全局：隐藏滚动条 / 防横向溢出 ===== */
* { margin: 0; padding: 0; box-sizing: border-box; scrollbar-width: none; -ms-overflow-style: none; }
::-webkit-scrollbar { display: none; }
html, body { height: 100%; }
body {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(160deg, #d7e1f2 0%, #e9eef8 100%); color: var(--text); font-size: 12px; line-height: 1.5;
  display: flex; align-items: flex-start; justify-content: center;
  min-height: 100vh; padding: 24px; gap: 16px;
}

/* ===== 设计令牌：对齐服务端项目详情原型（Ant Design 4 色调） ===== */
:root {
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 20px;
  --r-card: 12px; --r-block: 8px; --r-pill: 999px;
  --fs-11: 11px; --fs-12: 12px; --fs-13: 13px; --fs-15: 15px; --fs-17: 17px;
  /* 颜色取自营服端 project-detail-initial-v2.html 的 :root */
  --primary: #1677ff; --primary-deep: #0b57d0; --primary-bg: #e8f1ff; --primary-light: #4096ff;
  --success: #2f9e2f; --success-bg: #eaf7e8; --warning: #fa8c16; --warning-bg: #fff7e6;
  --danger: #f5544f; --danger-bg: #fff2f0; --orange: #fa541c;
  --text: #1f2a3d; --text-2: #5a6b85; --text-3: #93a1b5; --bg: #eef4ff;
  --bg-grad: linear-gradient(180deg, #e8f1ff 0%, #f2f6ff 26%, #f7faff 100%);
  --grad-brand: linear-gradient(135deg, #1e7dff 0%, #0b57d0 100%);
  --card: #fff; --border: #e2eaf8; --shadow: 0 2px 12px rgba(22,119,255,.07);
  --shadow-2: 0 8px 24px rgba(22,119,255,.14);
  --bg-secondary: #f3f7ff; --flow-bg: #f6faff; --line-light: #eef3fb;
  --dot-ring: #d8e3f5; --demo-blue: #1677ff;
}

/* ===== 手机框（与服务端原型一致：375×812 + 10px 黑边） ===== */
.phone-frame {
  width: 375px; flex-shrink: 0; height: 812px; background: var(--bg-grad);
  border-radius: 40px; overflow: hidden; position: relative;
  display: flex; flex-direction: column; border: 10px solid #1a1a1a;
  box-shadow: 0 12px 40px rgba(0,0,0,.25);
}
.status-bar {
  height: 44px; background: var(--grad-brand); flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 22px; font-size: 14px; font-weight: 600; color: #fff;
}
.sb-ic { display: flex; align-items: center; gap: 6px; }
.sb-signal { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
.sb-signal i { width: 3px; background: #fff; border-radius: 1px; }
.sb-signal i:nth-child(1){height:4px} .sb-signal i:nth-child(2){height:6px}
.sb-signal i:nth-child(3){height:8px} .sb-signal i:nth-child(4){height:11px}
.sb-battery { width: 22px; height: 11px; border: 1px solid rgba(255,255,255,.85); border-radius: 3px; position: relative; padding: 1.5px; }
.sb-battery::after { content: ""; position: absolute; right: -3px; top: 3px; width: 2px; height: 4px; background: rgba(255,255,255,.85); border-radius: 0 1px 1px 0; }
.sb-battery i { display: block; height: 100%; width: 70%; background: #fff; border-radius: 1px; }
.nav-bar {
  height: 44px; background: var(--grad-brand); flex-shrink: 0; position: relative;
  display: flex; align-items: center; box-shadow: 0 2px 10px rgba(11,87,208,.18);
}
.nav-bar .nb-back { position: absolute; left: 14px; font-size: 26px; line-height: 1; color: #fff; text-decoration: none; }
.nav-bar .title { flex: 1; text-align: center; font-size: 17px; font-weight: 600; color: #fff; padding: 0 72px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-bar .nb-actions { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); }
.native-capsule {
  display: inline-flex; align-items: center; justify-content: space-between;
  min-width: 56px; height: 28px; padding: 0 10px; box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.5); border-radius: 14px; background: rgba(255,255,255,.22);
  color: #fff; font-size: 12px; line-height: 1; user-select: none;
}
.native-capsule .nc-left, .native-capsule .nc-right { display: inline-flex; align-items: center; justify-content: center; flex: 1; min-width: 16px; }
.native-capsule .nc-right { font-size: 10px; }
.native-capsule .nc-divider { width: 1px; height: 14px; background: rgba(255,255,255,.45); margin: 0 4px; }

/* ===== 可滚动主体 ===== */
.page-body { flex: 1; overflow-y: auto; overflow-x: hidden; background: transparent; -webkit-overflow-scrolling: touch; }
.card { background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow); border-radius: var(--r-card); padding: var(--sp-3); margin: 0 var(--sp-3) var(--sp-2); }
.card:first-of-type { margin-top: 4px; }

/* ===== 项目信息一行（已由顶栏 .topbar 承载，旧 .project-bar/.switch-pop 已下线） ===== */

/* ===== quick-nav 4 项 ===== */
.qn-card { padding-top: 4px; padding-bottom: 4px; }
.quick-nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-2); }
.quick-nav .qn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-height: 40px; border-radius: var(--r-block); background: #fff; border: 1px solid var(--line-light); box-shadow: 0 1px 4px rgba(22,119,255,.05); }
.quick-nav .qn .qn-ic { width: 22px; height: 22px; border-radius: 7px; background: linear-gradient(135deg,#4096ff,#0b57d0); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 500; box-shadow: 0 2px 6px rgba(22,119,255,.25); }
.quick-nav .qn:nth-child(2) .qn-ic { background: linear-gradient(135deg,#36cfc9,#08979c); box-shadow: 0 2px 6px rgba(8,151,156,.25); }
.quick-nav .qn:nth-child(3) .qn-ic { background: linear-gradient(135deg,#9254de,#531dab); box-shadow: 0 2px 6px rgba(83,29,171,.25); }
.quick-nav .qn:nth-child(4) .qn-ic { background: linear-gradient(135deg,#73d13d,#237804); box-shadow: 0 2px 6px rgba(35,120,4,.25); }
.quick-nav .qn .qn-tx { font-size: var(--fs-11); color: var(--text-2); }

/* ===== 待办 ===== */
.card-head { display: flex; align-items: center; gap: 6px; margin-bottom: var(--sp-2); }
.card-head .ch-t { font-size: var(--fs-13); font-weight: 500; color: var(--text); }
.card-head .ch-t::before { content: ''; display: inline-block; width: 3px; height: 12px; border-radius: 2px; background: linear-gradient(180deg,#4096ff,#0b57d0); margin-right: 6px; vertical-align: -1px; }
.card-head .ch-n { font-size: var(--fs-11); color: #fff; background: var(--grad-brand); border-radius: var(--r-pill); padding: 0 7px; font-weight: 500; }
.card-head .ch-a { margin-left: auto; font-size: var(--fs-11); color: var(--text-2); }
.todo-row { display: flex; align-items: center; gap: var(--sp-2); min-height: 44px; padding: 6px 0; border-top: 1px solid var(--line-light); }
.todo-row:active { background: #f1f6ff; }
.todo-row .t-tag { font-size: var(--fs-11); font-weight: 500; border-radius: var(--r-pill); padding: 2px 7px; flex-shrink: 0; }
.todo-row .t-tag.t-contract { color: var(--primary); background: var(--primary-bg); }
.todo-row .t-tag.t-task { color: var(--success); background: var(--success-bg); }
.todo-row .t-main { flex: 1; min-width: 0; }
.todo-row .t-title { font-size: var(--fs-12); color: var(--text); line-height: 1.4; }
.todo-row .t-sub { font-size: var(--fs-11); color: var(--text-2); line-height: 1.4; }
.todo-row .t-go { font-size: var(--fs-11); color: var(--primary); flex-shrink: 0; }

/* ===== 我的任务一行 ===== */
.mytask-row { display: flex; align-items: center; gap: var(--sp-2); min-height: 40px; }
.mytask-row .mt-t { font-size: var(--fs-13); font-weight: 500; color: var(--text); }
.mytask-row .mt-s { font-size: var(--fs-12); color: var(--text-2); }
.mytask-row .mt-a { margin-left: auto; font-size: var(--fs-11); color: var(--text-2); }

/* ===== 服务流程卡（核心） ===== */
.flow-card { background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow); border-radius: var(--r-card); margin: 0 var(--sp-3) var(--sp-2); overflow: hidden; }
.flow-sticky { position: sticky; top: 0; z-index: 20; overflow: visible; background: linear-gradient(180deg,#f8fbff 0%,#ffffff 100%); padding: 8px var(--sp-3) 0; border-bottom: 1px solid transparent; transition: border-color 120ms ease-out, box-shadow 160ms ease-out; }
.flow-sticky.stuck { border-bottom-color: var(--line-light); box-shadow: 0 4px 14px rgba(22,119,255,.08); }
.flow-head { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
.flow-head .fh-t { font-size: var(--fs-15); font-weight: 600; color: var(--text); }
.flow-head .fh-n { font-size: var(--fs-11); color: var(--primary-deep); background: var(--primary-bg); padding: 1px 7px; border-radius: var(--r-pill); }
/* 流程配置入口：仅非工人且有配置权限时出现 */
.flow-head .fh-cfg { margin-left: auto; font-size: var(--fs-11); color: var(--primary); background: #fff; border: 1px solid #cfe1fb; border-radius: var(--r-pill); padding: 4px 9px; display: flex; align-items: center; gap: 3px; flex-shrink: 0; }
.flow-head .fh-cfg:active { background: var(--primary-bg); }
.flow-stats { display: flex; align-items: center; gap: var(--sp-3); background: linear-gradient(90deg,#eef5ff,#f8fbff); border: 1px solid #e2eaf8; border-radius: var(--r-block); padding: 4px 10px; margin-bottom: 5px; }
.flow-stats .fs-seg { display: flex; align-items: baseline; gap: 4px; }
.flow-stats .fs-num { font-size: var(--fs-13); font-weight: 600; color: var(--primary-deep); }
.flow-stats .fs-lab { font-size: var(--fs-11); color: var(--text-2); }
.flow-stats .fs-div { width: 1px; height: 12px; background: var(--dot-ring); }

/* 横滑流程条 */
.rail-wrap { position: relative; margin-bottom: 5px; }
.flow-rail { position: relative; display: flex; gap: var(--sp-2); overflow-x: auto; overflow-y: hidden; scroll-behavior: smooth; scroll-snap-type: x proximity; padding-bottom: 2px; }
.flow-rail.centerable::before, .flow-rail.centerable::after { content: ''; flex: 0 0 calc(50% - 42px); }
.flow-item { flex: 0 0 auto; min-width: 50px; min-height: 38px; scroll-snap-align: center; border-radius: 10px; padding: 5px 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: #fff; border: 1px solid #e6edf9; box-shadow: 0 1px 4px rgba(22,119,255,.05); transition: transform 160ms ease-out, background-color 160ms ease-out, box-shadow 160ms ease-out; }
.flow-item:active { background: #f1f6ff; }
.flow-item.on { min-width: 84px; background: var(--grad-brand); border-color: transparent; transform: scale(1.02); box-shadow: 0 6px 16px rgba(22,119,255,.32); }
.flow-item .fi-dot { width: 10px; height: 10px; border-radius: 50%; }
.flow-item.on .fi-dot { box-shadow: 0 0 0 2px rgba(255,255,255,.9); }
.flow-item .fi-name { font-size: var(--fs-11); color: var(--text-2); line-height: 1.2; text-align: center; }
.flow-item.on .fi-name { font-size: var(--fs-13); font-weight: 600; color: #fff; }
.flow-item .fi-bar { width: 100%; height: 3px; border-radius: 2px; background: #e3ebf8; overflow: hidden; }
.flow-item.on .fi-bar { background: rgba(255,255,255,.35); }
.flow-item .fi-bar i { display: block; height: 100%; border-radius: 2px; }
.flow-item .fi-prog { font-size: var(--fs-11); color: var(--text-3); line-height: 1.2; }
.flow-item.on .fi-prog { color: rgba(255,255,255,.88); }
.rail-mask { position: absolute; right: 0; top: 0; bottom: 2px; width: 24px; background: linear-gradient(to left, #fff, rgba(255,255,255,0)); pointer-events: none; display: none; }

/* 内联明细 */
.flow-detail { background: var(--flow-bg); border-radius: 0 0 var(--r-card) var(--r-card); }
.flow-detail.collapsed { display: none; }
.detail-inner { padding: var(--sp-3); border-left: 2px solid var(--primary); }
.detail-title { font-size: var(--fs-13); font-weight: 500; color: var(--text); margin-bottom: var(--sp-2); }
.d-sec { margin-bottom: var(--sp-3); }
.d-sec:last-child { margin-bottom: 0; }
.d-sec-h { font-size: var(--fs-11); color: var(--text-2); margin-bottom: 6px; }
.d-row { display: flex; align-items: center; gap: var(--sp-2); min-height: 44px; padding: 6px 0; border-top: 1px solid var(--line-light); }
.d-row:first-of-type { border-top: none; }
.d-row:active { background: #f1f6ff; }
.d-row .d-name { flex: 1; min-width: 0; font-size: var(--fs-12); color: var(--text); line-height: 1.4; }
.d-row .d-meta { font-size: var(--fs-11); color: var(--text-2); line-height: 1.4; }
.d-row .d-go { font-size: var(--fs-11); color: var(--primary); flex-shrink: 0; }
.badge { font-size: var(--fs-11); font-weight: 500; border-radius: var(--r-pill); padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.b-go { color: var(--primary); background: var(--primary-bg); }
.b-done { color: var(--success); background: var(--success-bg); }
.b-wait { color: var(--text-2); background: var(--bg-secondary); }
.b-stop { color: var(--danger); background: var(--danger-bg); }
.detail-empty { text-align: center; padding: var(--sp-5) var(--sp-3); }
.detail-empty .de-t { font-size: var(--fs-12); color: var(--text-2); line-height: 1.5; margin-bottom: var(--sp-3); }
.add-btn { display: inline-block; border: 1px dashed var(--primary-light); color: var(--primary); font-size: var(--fs-12); border-radius: var(--r-block); padding: 8px 16px; }

/* ===== 今日动态（对齐服务端原型页） ===== */
.activity-card .card-head { margin-bottom: 4px; }
.activity-item { padding: 8px 0 8px 16px; position: relative; cursor: pointer; transition: background .15s; border-top: 1px solid var(--line-light); }
.activity-item:first-child { border-top: none; }
.activity-item:active { background: #f7faff; }
.activity-item.hidden { display: none; }
.activity-item::before { content: ''; position: absolute; left: 4px; top: 14px; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }
.activity-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.activity-avatar { width: 26px; height: 26px; border-radius: 50%; font-size: 11px; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 0 0 2px rgba(255,255,255,.85), 0 1px 4px rgba(0,0,0,.12); }
.activity-info { flex: 1; min-width: 0; }
.activity-user { font-size: 13px; color: var(--text); font-weight: 500; }
.activity-role-tag { display: inline-block; font-size: 10px; padding: 0 6px; border-radius: 8px; margin-left: 4px; vertical-align: middle; line-height: 14px; height: 14px; font-weight: 500; }
.activity-role-tag.project-manager { background-color: #E6F7FF; color: #1890FF; }
.activity-role-tag.foreman { background-color: #F6FFED; color: #52C41A; }
.activity-role-tag.worker { background-color: #FFF7E6; color: #FA8C16; }
.activity-role-tag.designer { background-color: #F9F0FF; color: #722ED1; }
.activity-role-tag.owner { background-color: #FFF1F0; color: #F5222D; }
.activity-time { font-size: 10px; color: var(--text-3); margin-top: 2px; }
.activity-content { font-size: 12px; color: var(--text); margin-bottom: 4px; line-height: 1.5; }
.activity-content .hl { color: var(--primary); background: var(--primary-bg); border-radius: 3px; padding: 0 3px; }
.activity-media { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
.activity-media-item { width: 48px; height: 48px; border-radius: 6px; flex: 0 0 auto; position: relative; background: #dfe6f2; overflow: hidden; }
.activity-media-item .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.activity-media-item .play::after { content: ''; width: 0; height: 0; border-left: 12px solid rgba(255,255,255,.95); border-top: 8px solid transparent; border-bottom: 8px solid transparent; margin-left: 3px; filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
.activity-more-btn { padding: 8px 0 2px; font-size: 12px; text-align: center; color: var(--primary); cursor: pointer; }

/* ===== Toast ===== */
.toast { position: fixed; left: 50%; bottom: 90px; transform: translateX(-50%); background: rgba(0,0,0,.8); color: #fff; font-size: var(--fs-12); padding: 8px 16px; border-radius: var(--r-block); z-index: 100; opacity: 0; transition: opacity 160ms ease-out; pointer-events: none; }
.toast.show { opacity: 1; }

/* ===== 演示控制（框外） ===== */
.demo-panel { width: 220px; flex-shrink: 0; background: #fff; border-left: 2px dashed var(--demo-blue); border-radius: var(--r-block); padding: var(--sp-3); align-self: flex-start; box-shadow: var(--shadow); }
.demo-panel h4 { font-size: var(--fs-13); font-weight: 500; color: var(--text); margin-bottom: var(--sp-2); }
.demo-panel .dp-group { margin-bottom: var(--sp-4); }
.demo-panel .dp-lab { font-size: var(--fs-11); color: var(--text-2); margin-bottom: var(--sp-2); }
.demo-panel .dp-opts { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
.demo-panel .dp-opt { font-size: var(--fs-11); color: var(--text-2); border: 1px solid var(--border); border-radius: var(--r-pill); padding: 6px 10px; min-height: 32px; display: flex; align-items: center; cursor: pointer; }
.demo-panel .dp-opt.on { color: var(--primary); border-color: var(--primary); background: var(--primary-bg); font-weight: 500; }

/* ===== 右侧「服务流程项」浮窗（参考 owner 项目导航） ===== */
/* 右缘常驻触发条 */
.flow-trigger {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  z-index: 30; background: var(--grad-brand); color: #fff; cursor: pointer;
  padding: 14px 6px; border-radius: 12px 0 0 12px;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  box-shadow: -2px 2px 14px rgba(22,119,255,.35); transition: opacity 160ms ease-out;
}
.flow-trigger .ft-arrow { font-size: 13px; line-height: 1; }
.flow-trigger .ft-text { writing-mode: vertical-rl; font-size: 12px; font-weight: 600; letter-spacing: 3px; }

/* 遮罩 + 抽屉 */
.flow-drawer-mask {
  position: absolute; inset: 44px 0 0 0; background: rgba(0,0,0,.35); z-index: 50;
  opacity: 0; visibility: hidden; transition: opacity 200ms ease-out, visibility 200ms;
}
.flow-drawer-mask.open { opacity: 1; visibility: visible; }
.flow-drawer {
  position: absolute; top: 44px; right: 0; height: calc(100% - 44px); width: 300px; max-width: 86%;
  background: #fff; z-index: 60; transform: translateX(100%);
  transition: transform 240ms cubic-bezier(.22,.61,.36,1);
  display: flex; flex-direction: column; box-shadow: -6px 0 24px rgba(0,0,0,.18);
}
.flow-drawer.open { transform: translateX(0); }

/* 深色头部栏（仿 owner drawer-header-bar） */
.fd-header { background: var(--grad-brand); color: #fff; padding: 12px 14px; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.fd-header .fd-ic { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,.22); display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
.fd-header .fd-title { font-size: 15px; font-weight: 600; }
.fd-header .fd-tag { font-size: 10px; background: rgba(255,255,255,.2); padding: 2px 8px; border-radius: 999px; }
.fd-header .fd-right { margin-left: auto; display: flex; align-items: center; gap: 12px; font-size: 12px; }
.fd-header .fd-cfg { font-size: 11px; color: #fff; border: 1px solid rgba(255,255,255,.55); border-radius: 999px; padding: 2px 8px; cursor: pointer; }
.fd-header .fd-close { cursor: pointer; font-size: 20px; line-height: 1; }

/* 信息栏 */
.fd-info { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: linear-gradient(90deg,#eef5ff,#f8fbff); border-bottom: 1px solid var(--border); flex-shrink: 0; }
.fd-info .fd-badge { font-size: 12px; color: var(--text); flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fd-info .fd-badge b { color: var(--primary); font-weight: 600; }
.fd-info .fd-act { font-size: 11px; padding: 4px 10px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
.fd-info .fd-act.create { background: var(--primary); color: #fff; }
.fd-info .fd-act.view { background: #fff; color: var(--primary); border: 1px solid rgba(22,119,255,.35); }
.fd-info .fd-locate { font-size: 11px; color: var(--primary); background: var(--primary-bg); padding: 4px 10px; border-radius: 999px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }

/* 内容区（顶部 padding 归零：首子元素即吸顶 Tab 条，避免吸顶后上方留透明缝） */
.fd-content { flex: 1; overflow-y: auto; padding: 0 14px 16px; -webkit-overflow-scrolling: touch; background: linear-gradient(180deg,#ffffff 0%,#f8fbff 100%); }
.fd-sec { margin-bottom: 14px; }
.fd-sec-h { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.fd-sec-h .fd-count { font-size: 11px; color: var(--text-2); font-weight: 500; }
.fd-item { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; border-top: 1px solid var(--line-light); cursor: pointer; }
.fd-item:first-child { border-top: none; }
.fd-item.active { background: linear-gradient(90deg, var(--primary-bg), transparent); margin: 0 -14px; padding: 8px 14px; border-radius: 8px; }
.fd-item .fd-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-item .fd-name { flex: 1; min-width: 0; font-size: 13px; color: var(--text); }
.fd-item .fd-meta { font-size: 11px; color: var(--text-2); }
.fd-item .fd-badge { font-size: 11px; font-weight: 500; border-radius: 999px; padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.fd-item.active .fd-name { color: var(--primary); font-weight: 600; }
.fd-empty { text-align: center; color: var(--text-3); font-size: 12px; padding: 14px 0; }
.fd-footer { flex-shrink: 0; padding: 10px 14px; font-size: 11px; color: var(--text-3); text-align: center; border-top: 1px solid var(--line-light); background: #f5f9ff; }

/* ===== 指派任务（临时任务）：明细区底部吸底入口 + 轻量表单弹窗 ===== */
.fd-assignbar { position: sticky; bottom: 0; z-index: 4; margin: 4px 0 0; padding: 10px 0 2px; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, #fff 42%); }
.fd-ext-add { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 4px; border: none; border-radius: 10px; background: var(--grad-brand); color: #fff; font-size: 14px; font-weight: 500; font-family: inherit; cursor: pointer; box-shadow: 0 4px 12px rgba(22,119,255,.24); user-select: none; }
.fd-ext-add:active { opacity: .92; }
.assign-modal { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15,23,42,.5); z-index: 80; display: none; align-items: center; justify-content: center; }
.assign-modal.show { display: flex; }
.assign-modal .am-content { background: #fff; border-radius: 12px; width: 88%; max-width: 340px; max-height: 82%; overflow-y: auto; box-shadow: 0 12px 40px rgba(22,119,255,.2); }
.am-header { padding: 14px 16px; border-bottom: 1px solid var(--line-light); display: flex; justify-content: space-between; align-items: center; }
.am-title { font-size: 16px; font-weight: 600; color: var(--text); }
.am-close { font-size: 18px; color: var(--text-3); cursor: pointer; padding: 2px 6px; }
.am-body { padding: 14px 16px; }
.am-group { margin-bottom: 14px; }
.am-group:last-child { margin-bottom: 0; }
.am-label { display: block; font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 6px; }
.am-required { color: var(--danger); }
.am-input, .am-textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--dot-ring); border-radius: 8px; font-size: 13px; box-sizing: border-box; font-family: inherit; background: #fff; color: var(--text); }
.am-textarea { min-height: 56px; resize: vertical; }
.am-input:focus, .am-textarea:focus { outline: none; border-color: var(--primary); }
.am-err { color: var(--danger); font-size: 11px; margin-top: 4px; display: none; }
.am-select { position: relative; }
.am-select-btn { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 9px 10px; border: 1px solid var(--dot-ring); border-radius: 8px; font-size: 13px; color: var(--text-2); cursor: pointer; background: #fff; min-height: 40px; }
.am-select-btn .arr { font-size: 10px; color: var(--text-3); transition: transform .15s ease; flex-shrink: 0; }
.am-select.open .am-select-btn { border-color: var(--primary); }
.am-select.open .am-select-btn .arr { transform: rotate(180deg); }
.am-dropdown { display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #fff; border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 6px 20px rgba(22,119,255,.15); max-height: 180px; overflow-y: auto; z-index: 10; }
.am-select.open .am-dropdown { display: block; }
.am-opt { padding: 10px 12px; font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 8px; cursor: pointer; }
.am-opt:active { background: var(--primary-bg); }
.am-opt .role { font-size: 11px; color: var(--text-3); margin-left: auto; flex-shrink: 0; }
.am-opt .ck { font-size: 12px; color: var(--primary); margin-left: 6px; flex-shrink: 0; font-weight: 600; }
.am-opt.checked { background: var(--primary-bg); color: var(--primary); font-weight: 500; }
.am-select-btn > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.am-footer { padding: 12px 16px; border-top: 1px solid var(--line-light); }
.am-submit { width: 100%; padding: 11px; background: var(--grad-brand); color: #fff; border: none; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; }
.am-submit:active { opacity: .9; }

/* 流程项：横向鱼眼 Tab（Q · 选中放大、邻项按距离缩小、两端渐隐） */
/* 浮窗内流程项 Tab 吸顶：滚动看任务时保持「当前流程项」上下文（紧凑：顶部留白 2px，仅为鱼眼放大溢出预留） */
#fdFlowList { position: sticky; top: 0; z-index: 6; background: #fff; padding-top: 2px; }
#fdFlowList.stuck { box-shadow: 0 4px 14px rgba(22,119,255,.08); }
.fd-rail { position: relative; display: flex; gap: 6px; overflow-x: auto; padding: 4px 0 2px; scroll-behavior: smooth; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%); }
.fd-rail::before, .fd-rail::after { content: ''; flex: 0 0 calc(50% - 28px); }
.fd-rail-item { flex: 0 0 auto; min-width: 56px; border-radius: 10px; padding: 6px; background: #fff; border: 1px solid #e6edf9; box-shadow: 0 1px 4px rgba(22,119,255,.05); display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; transform-origin: center bottom; transition: transform .28s cubic-bezier(.34,1.3,.64,1), opacity .2s ease, background-color .2s ease, box-shadow .2s ease; }
.fd-rail-item.active { background: var(--grad-brand); border-color: transparent; position: relative; z-index: 1; box-shadow: 0 6px 16px rgba(22,119,255,.32); }
.fd-ri-d0 { transform: scale(1.16); }
.fd-ri-d1 { transform: scale(1.04); }
.fd-ri-d2 { transform: scale(.94); opacity: .92; }
.fd-ri-d3 { transform: scale(.88); opacity: .75; }
.fd-ri-name { font-size: 11px; color: var(--text-2); line-height: 1.2; text-align: center; }
.fd-rail-item.active .fd-ri-name { color: #fff; font-weight: 600; }
.fd-ri-bar { width: 100%; height: 3px; border-radius: 2px; background: #e3ebf8; overflow: hidden; }
.fd-rail-item.active .fd-ri-bar { background: rgba(255,255,255,.35); }
.fd-ri-bar i { display: block; height: 100%; border-radius: 2px; }
.fd-ri-prog { font-size: 11px; color: var(--text-3); }
.fd-rail-item.active .fd-ri-prog { color: rgba(255,255,255,.88); }

/* 两类任务：左侧书签约竖排 Tab（G · 笔记本索引签） */
.fd-bm-wrap { display: flex; align-items: flex-start; margin: 4px 0 8px; }
.fd-bm-col { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; flex-shrink: 0; position: sticky; top: var(--fd-rail-h, 58px); z-index: 5; background: #fff; border-radius: 8px 0 0 8px; box-shadow: 1px 0 6px rgba(22,119,255,.05); }
.fd-bm { writing-mode: vertical-rl; letter-spacing: 2px; font-size: 11px; font-weight: 500; color: var(--text-2); background: #fff; border: 1px solid #e6edf9; min-width: 22px; padding: 10px 3px; border-radius: 6px 0 0 6px; cursor: pointer; text-align: center; user-select: none; }
.fd-bm:active { opacity: .85; }
.fd-bm.on { background: var(--grad-brand); color: #fff; font-weight: 600; border-color: transparent; box-shadow: -2px 2px 8px rgba(22,119,255,.28); position: relative; z-index: 1; margin-right: -1px; }
.fd-bm-n { font-size: 9px; font-weight: 400; color: var(--text-3); letter-spacing: 0; margin-top: 3px; }
.fd-bm.on .fd-bm-n { color: rgba(255,255,255,.85); }
.fd-bm-panel { flex: 1; min-width: 0; background: #fff; border: 1px solid var(--line-light); border-radius: 0 10px 10px 10px; padding: 8px; }

/* 明细列表工具条：一键收起/展开全部阶段（作用于阶段卡片，非整区隐藏） */
.fd-bm-util { writing-mode: vertical-rl; letter-spacing: 2px; font-size: 11px; font-weight: 500; color: var(--primary); background: #fff; border: 1px solid var(--primary); min-width: 22px; padding: 8px 4px; border-radius: 6px; cursor: pointer; text-align: center; user-select: none; margin-top: 2px; }
.fd-bm-util:active { background: var(--primary-bg); }

/* 浮窗内：阶段-任务（对齐 owner 项目导航 · 折叠阶段卡片 + 任务项） */
.fd-stage-list { display: flex; flex-direction: column; gap: 10px; }
.fd-stage-card { background: #fff; border: 1px solid var(--line-light); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 6px rgba(22,119,255,.06); }
.fd-stage-header { display: flex; align-items: center; padding: 12px 14px; cursor: pointer; gap: 10px; transition: background .15s ease; }
.fd-stage-header:active { background: #f3f7ff; }
.fd-stage-status-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-stage-status-dot.completed { background: #52C41A; box-shadow: 0 0 0 3px rgba(82,196,26,.18); }
.fd-stage-status-dot.in_progress { background: #FA8C16; box-shadow: 0 0 0 3px rgba(250,140,22,.18); }
.fd-stage-status-dot.pending { background: #bfc9d9; box-shadow: 0 0 0 3px rgba(191,201,217,.22); }
.fd-stage-info { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
.fd-stage-title { font-size: 14px; font-weight: 600; color: #1F2937; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fd-stage-count-badge { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 10px; flex-shrink: 0; }
.fd-stage-count-badge.completed { color: #389E0D; background: #F6FFED; }
.fd-stage-count-badge.in_progress { color: #D46B08; background: #FFF7E6; }
.fd-stage-count-badge.pending { color: #8C8C8C; background: #F0F0F0; }
.fd-stage-collapse-arrow { width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; color: #a8b6c8; font-size: 14px; transition: transform .25s ease; flex-shrink: 0; font-weight: 700; }
.fd-stage-card.collapsed .fd-stage-collapse-arrow { transform: rotate(-90deg); }
.fd-stage-task-list { overflow: hidden; transition: max-height .3s ease; border-top: 1px solid #F0F2F5; }
.fd-stage-card.collapsed .fd-stage-task-list { max-height: 0 !important; border-top: none; }
/* 定位命中：当前施工阶段短暂高亮脉冲（1.6s 后自动回落，不改变选中态样式） */
.fd-stage-card.locate-hl { animation: fdLocateHl 1.6s ease-out; }
@keyframes fdLocateHl {
  0%   { background: rgba(22,119,255,.12); border-color: rgba(22,119,255,.55); box-shadow: 0 0 0 2px rgba(22,119,255,.35); }
  60%  { background: rgba(22,119,255,.05); border-color: rgba(22,119,255,.28); box-shadow: 0 0 0 2px rgba(22,119,255,.14); }
  100% { background: #fff; border-color: var(--line-light); box-shadow: 0 1px 6px rgba(22,119,255,.06); }
}
.fd-locate:active { background: rgba(22,119,255,.18); }
.fd-stage-task-item { display: flex; align-items: center; padding: 10px 14px 10px 34px; gap: 10px; cursor: pointer; position: relative; transition: background .15s ease; }
.fd-stage-task-item + .fd-stage-task-item { border-top: 1px solid #F5F6F8; }
.fd-stage-task-item:active { background: #FAFBFC; }
.fd-task-status-icon { width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 10px; font-weight: 600; }
.fd-task-status-icon.completed { background: #F6FFED; color: #52C41A; border: 1.5px solid #95DE64; }
.fd-task-status-icon.in_progress { background: #FFF7E6; color: #FA8C16; border: 1.5px solid #FFC069; }
.fd-task-status-icon.pending { background: transparent; border: 1.5px solid #cfd9e6; color: #a8b6c8; }
.fd-task-name { flex: 1; font-size: 13px; color: #262626; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fd-stage-task-item.in_progress .fd-task-name { color: #D46B08; font-weight: 500; }
.fd-stage-task-item.completed .fd-task-name { color: #93a1b5; text-decoration: line-through; text-decoration-color: #bfc9d9; }
.fd-task-tag { display: inline-flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600; width: 18px; height: 18px; border-radius: 4px; background: linear-gradient(135deg,#FF6B6B,#FF4757); color: #fff; flex-shrink: 0; }
.fd-task-arrow { color: #D9D9D9; font-size: 14px; flex-shrink: 0; font-weight: 700; }

/* 临时任务列表（已取消「隶属阶段」：单一平铺列表） */
.fd-ext-list { padding-top: 2px; }
.fd-ext-task { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 0; border-top: 1px solid var(--line-light); }
.fd-ext-task:first-of-type { border-top: none; }
.fd-ext-task .fd-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-ext-task .fd-name { flex: 1; min-width: 0; font-size: 13px; color: var(--text); }
.fd-ext-task .fd-meta { font-size: 11px; color: var(--text-2); }
.fd-ext-task .fd-badge { font-size: 11px; font-weight: 500; border-radius: 999px; padding: 2px 8px; flex-shrink: 0; white-space: nowrap; }
.fd-ext-none { text-align: center; color: var(--text-3); font-size: 12px; padding: 14px 0; }
/* 任务型流程项内的临时任务小区块（与该项自身任务区分） */
.fd-ext-sub { margin-top: 10px; }
.fd-ext-sub-h { font-size: 12px; font-weight: 600; color: var(--text-2); padding: 8px 0 4px; display: flex; align-items: center; gap: 6px; border-top: 1px solid var(--line-light); }
.fd-ext-sub-n { font-size: 10px; font-weight: 600; color: var(--primary); background: var(--primary-bg); border-radius: 999px; padding: 1px 7px; }

/* ===== 顶部项目切换条 / 下拉面板（沿用旧项目主页口径） ===== */
.topbar { flex-shrink: 0; background: #fff; padding: 8px 12px; position: relative; z-index: 30; border-bottom: 1px solid var(--line-light); }
.proj-switch { display: flex; align-items: stretch; background: #f5f7fa; border: 1px solid #e8edf3; border-radius: 12px; overflow: hidden; }
.proj-info-zone { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 8px 10px; }
.proj-info-zone:active { background: #eef2f7; }
.proj-info-zone .info-arrow { font-size: 18px; color: var(--text-3); line-height: 1; }
.proj-switch-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
.proj-name { font-size: var(--fs-15); font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; }
.proj-status { font-size: var(--fs-11); font-weight: 500; color: #fff; background: var(--grad-brand); padding: 2px 8px; border-radius: var(--r-pill); flex-shrink: 0; }
.proj-status.done { background: var(--success); }
.proj-switch-hero { flex: 1; min-width: 0; text-align: right; font-size: var(--fs-12); color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.proj-switch-right { display: flex; align-items: center; gap: 4px; padding: 8px 12px; border-left: 1px solid #e3e8ef; background: #fafbfc; }
.switch-hint { font-size: var(--fs-11); color: var(--text-2); }
.switch-arrow { font-size: 11px; color: var(--text-3); transition: transform .25s; }
.switch-arrow.open { transform: rotate(180deg); }
.proj-panel { position: absolute; left: 0; right: 0; top: 100%; background: #fff; max-height: 0; overflow: hidden; transition: max-height .3s ease; z-index: 25; box-shadow: 0 8px 20px rgba(11,87,208,.12); border-radius: 0 0 16px 16px; }
.proj-panel.open { max-height: 460px; display: flex; flex-direction: column; }
.proj-panel-filter { flex-shrink: 0; display: flex; gap: 6px; padding: 8px 12px 6px; border-bottom: 1px solid var(--line-light); }
.pf-item { flex: 1; text-align: center; font-size: var(--fs-12); padding: 6px 0; border-radius: 8px; background: #f2f4f7; color: var(--text-2); cursor: pointer; }
.pf-item.active { background: var(--primary); color: #fff; font-weight: 500; }
.proj-panel-inner { flex: 1; min-height: 0; overflow-y: auto; padding: 8px 12px 12px; }
.proj-option { border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; background: #fff; cursor: pointer; }
.proj-option:active { background: #f5f7fa; }
.proj-option.active { border-color: var(--primary); background: #f5faff; }
.po-top { display: flex; align-items: center; justify-content: space-between; }
.po-name { font-size: var(--fs-13); font-weight: 600; color: var(--text); }
.po-status { font-size: var(--fs-11); padding: 2px 8px; border-radius: var(--r-pill); background: var(--primary-bg); color: var(--primary); }
.po-status.done { background: var(--success-bg); color: var(--success); }
.po-addr { font-size: var(--fs-11); color: var(--text-3); margin: 4px 0; }
.po-stats { display: flex; gap: 14px; font-size: var(--fs-11); color: var(--text-2); margin-bottom: 6px; }
.po-bar { height: 4px; background: #eef0f3; border-radius: 2px; overflow: hidden; }
.po-bar-fill { height: 100%; background: var(--grad-brand); border-radius: 2px; }
.proj-panel-foot { flex-shrink: 0; padding: 8px 12px 10px; border-top: 1px solid var(--line-light); }
.proj-new-btn { width: 100%; padding: 10px; border: none; border-radius: 10px; background: var(--grad-brand); color: #fff; font-size: var(--fs-13); font-weight: 500; font-family: inherit; cursor: pointer; }
.proj-empty { text-align: center; font-size: var(--fs-12); color: var(--text-3); padding: 18px 0; }

/* ===== 底部主导航 ===== */
.tab-bar { flex-shrink: 0; height: 52px; background: #fff; display: flex; border-top: 1px solid var(--line-light); }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; cursor: pointer; color: var(--text-3); }
.tab-item.active { color: var(--primary); }
.tab-item .ti { font-size: 17px; line-height: 1; }
.tab-item .tl { font-size: var(--fs-11); }

/* ===== 工人视角：合同行 / 任务统计 ===== */
/* 快捷入口「我的合同」滚动定位后的短暂高亮 */
#myFlowCard.hl { animation: ctHl 1.3s ease-out; }
@keyframes ctHl { 0% { background: rgba(22,119,255,.12); box-shadow: 0 0 0 2px rgba(22,119,255,.35); } 100% { background: #fff; box-shadow: 0 0 0 2px rgba(22,119,255,0); } }

/* ===== 工人视角「我的服务流程」：由我签署的合同驱动，一个合同对应一个流程项块 ===== */
.mf-item { border: 1px solid #e2eaf8; border-radius: var(--r-block); padding: 9px 10px; margin-top: 8px; background: #fbfdff; }
.mf-item:first-child { margin-top: 4px; }
.mf-top { display: flex; align-items: center; gap: 6px; }
.mf-name { font-size: var(--fs-13); font-weight: 600; color: var(--text); }
.mf-badge { margin-left: auto; font-size: var(--fs-11); padding: 1px 7px; border-radius: var(--r-pill); white-space: nowrap; flex-shrink: 0; }
.mf-badge.on { color: var(--primary-deep); background: var(--primary-bg); }
.mf-badge.off { color: var(--text-3); background: #f0f3f7; }
.mf-contract { font-size: var(--fs-11); color: var(--text-2); margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 工人合同体系标识：与「基础施工服务合同 / 设计服务合同」等非工人服务合同区分 */
.mf-ct-tag { display: inline-block; font-size: 9px; line-height: 1; color: #5b6b82; background: #eef2f8; border-radius: 3px; padding: 2px 4px; margin-right: 4px; vertical-align: 1px; }
.mf-stages { display: flex; gap: 3px; margin-top: 7px; }
.mf-st { flex: 1; min-width: 0; height: 20px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: var(--fs-11); color: var(--text-3); background: #f0f3f7; overflow: hidden; white-space: nowrap; }
.mf-st.done { color: var(--primary-deep); background: var(--primary-bg); }
.mf-st.cur { color: #fff; background: var(--grad-brand); font-weight: 500; box-shadow: 0 2px 6px rgba(22,119,255,.24); }
.mf-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; padding-top: 7px; border-top: 1px dashed var(--line-light); }
.mf-tasks { font-size: var(--fs-11); color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mf-link { font-size: var(--fs-11); color: var(--primary); font-weight: 500; flex-shrink: 0; padding: 4px 2px; }
.stat-grid { display: flex; gap: 8px; }
.stat-cell { flex: 1; background: var(--bg-secondary); border-radius: var(--r-block); padding: 8px 6px; text-align: center; }
.stat-cell .sc-n { display: block; font-size: var(--fs-15); font-weight: 600; color: var(--primary-deep); }
.stat-cell .sc-l { font-size: var(--fs-11); color: var(--text-2); }

/* ===== 提示弹窗（认证拦截） ===== */
.app-modal { position: absolute; inset: 0; background: rgba(15,23,42,.5); display: none; align-items: center; justify-content: center; z-index: 90; }
.app-modal.show { display: flex; }
.modal-box { width: 280px; background: #fff; border-radius: 14px; padding: 22px 18px 14px; text-align: center; }
.modal-title { font-size: var(--fs-15); font-weight: 600; color: var(--text); margin-bottom: 12px; }
.modal-content { font-size: var(--fs-13); color: var(--text-2); line-height: 1.6; margin-bottom: 18px; }
.modal-content p { margin: 0; }
.modal-actions { display: flex; gap: 10px; }
.modal-btn { flex: 1; height: 40px; border-radius: 10px; font-size: var(--fs-13); font-weight: 500; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.modal-btn.cancel { background: #f2f5fa; color: var(--text-2); }
.modal-btn.confirm { background: var(--grad-brand); color: #fff; }

/* ===== 原型导航（框外右上） ===== */
.page-nav { position: fixed; top: 20px; right: 20px; z-index: 1000; width: 190px; background: #fff; border-radius: 10px; padding: 14px; box-shadow: 0 6px 20px rgba(0,0,0,.12); max-height: calc(100vh - 40px); overflow-y: auto; transition: max-height .3s; }
.page-nav.collapsed { max-height: 52px; overflow: hidden; }
.page-nav-title { font-size: var(--fs-13); font-weight: 500; color: var(--text); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
.page-nav-title .toggle-btn { font-size: 11px; color: var(--text-3); transition: transform .3s; }
.page-nav-title .toggle-btn.collapsed { transform: rotate(-90deg); }
.page-nav a { display: block; padding: 8px 10px; margin: 4px 0; background: var(--bg-secondary); border-radius: 6px; color: var(--text-2); font-size: var(--fs-11); text-decoration: none; }
.page-nav a.active { background: var(--primary); color: #fff; }
.page-nav a:hover { background: var(--primary); color: #fff; }

@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
@media (max-width: 720px) { body { flex-direction: column; align-items: center; } .demo-panel { width: 375px; border-left: none; border-top: 2px dashed var(--demo-blue); } }
</style>
<script src="js/flow-config-store.js"></script>
<script src="js/my-tasks-store.js"></script>
</head>
<body>
  <!-- ===== 原型导航（框外右上，沿用旧项目主页） ===== -->
  <div class="page-nav">
    <div class="page-nav-title" onclick="togglePageNav()" title="收起 / 展开 原型导航">原型导航 <span class="toggle-btn" id="pageNavToggle">▼</span></div>
    <a href="home.html">首页</a>
    <a href="project-list.html" class="active">项目主页（进行中）</a>
    <a href="project-list-empty-demo.html">项目列表（空状态演示）</a>
    <a href="project-detail-initial-v2.html">项目详情（初始-新版）</a>
    <a href="project-detail-completed-v2.html">项目详情（已完成-新版）</a>
    <a href="project-info.html">项目信息</a>
    <a href="architecture.html">项目架构</a>
    <a href="create-project.html">创建项目</a>
    <a href="task-list.html">任务列表</a>
    <a href="contract-detail.html">合同详情</a>
  </div>

  <!-- ===== 手机框 ===== -->
  <div class="phone-frame">
    <div class="status-bar">
      <span class="time">9:41</span>
      <div class="sb-ic">
        <span class="sb-signal"><i></i><i></i><i></i><i></i></span>
        <span class="sb-battery"><i></i></span>
      </div>
    </div>
    <div class="nav-bar">
      <div class="title">项目及详情</div>
      <div class="nb-actions"><div class="native-capsule" title="微信原生胶囊：由微信客户端渲染，开发者不可自定义其内容"><span class="nc-left">⋯</span><span class="nc-divider"></span><span class="nc-right">○</span></div></div>
    </div>

    <!-- 顶栏：左侧查看项目信息（跳 project-info），右侧展开项目切换面板 -->
    <div class="topbar" id="topbar">
      <div class="proj-switch">
        <div class="proj-info-zone" onclick="viewProjectInfo()">
          <div class="proj-switch-left">
            <span class="proj-name" id="curProjName">西安全屋整装</span>
            <span class="proj-status" id="curProjStatus">进行中</span>
          </div>
          <div class="proj-switch-hero" id="topHero">项目信息</div>
          <span class="info-arrow">›</span>
        </div>
        <div class="proj-switch-right" onclick="togglePanel()">
          <span class="switch-hint">切换</span>
          <span class="switch-arrow" id="switchArrow">▾</span>
        </div>
      </div>
      <div class="proj-panel" id="projPanel">
        <div class="proj-panel-filter" id="projPanelFilter">
          <div class="pf-item active" data-filter="all" onclick="setPanelFilter('all', this)">全部</div>
          <div class="pf-item" data-filter="ongoing" onclick="setPanelFilter('ongoing', this)">进行中</div>
          <div class="pf-item" data-filter="done" onclick="setPanelFilter('done', this)">已完成</div>
        </div>
        <div class="proj-panel-inner" id="projPanelInner"></div>
        <div class="proj-panel-foot">
          <button class="proj-new-btn" onclick="createProject()">＋ 新建项目</button>
        </div>
      </div>
    </div>

    <div class="page-body" id="pageBody">
      <!-- ===== 非工人（项目负责人）视角：服务流程主视图 ===== -->
      <div id="nonworkerView">
      <!-- quick-nav 4 项 -->
      <div class="card qn-card">
        <div class="quick-nav">
          <div class="qn" onclick="go('member.html')"><span class="qn-ic">众</span><span class="qn-tx">团队成员</span></div>
          <div class="qn" onclick="go('project-files.html')"><span class="qn-ic">资</span><span class="qn-tx">资料</span></div>
          <div class="qn" onclick="go('statement-list.html')"><span class="qn-ic">账</span><span class="qn-tx">对账单</span></div>
          <div class="qn" onclick="go('contract-list.html')"><span class="qn-ic">合</span><span class="qn-tx">合同</span></div>
        </div>
      </div>

      <!-- 待办事项 -->
      <div class="card">
        <div class="card-head"><span class="ch-t">待办事项</span><span class="ch-n">2</span><span class="ch-a" onclick="go('todo-list.html')">全部 ›</span></div>
        <div class="todo-row" onclick="go('contract-detail.html?status=confirming_sender')">
          <span class="t-tag t-contract">合同</span>
          <span class="t-main"><span class="t-title">水电分包合同待签约</span><span class="t-sub">发起人 陈庄 · 今天 10:20</span></span>
          <span class="t-go">去处理 ›</span>
        </div>
        <div class="todo-row" onclick="go('task-detail.html')">
          <span class="t-tag t-task">任务</span>
          <span class="t-main"><span class="t-title">材料进场验收待确认</span><span class="t-sub">发起人 李伟 · 昨天 16:40</span></span>
          <span class="t-go">去处理 ›</span>
        </div>
      </div>

      <!-- 我的任务 -->
      <div class="card">
        <div class="mytask-row" onclick="go(myTasksHref())">
          <span class="mt-t">我的任务</span>
          <span class="mt-s" id="mtSNonworker">待处理 5 · 确认中 2 · 已完成 3</span>
          <span class="mt-a">›</span>
        </div>
      </div>

      <!-- 服务流程卡 -->
      <div class="flow-card flow-sticky" id="flowSticky">
        <div class="flow-head" onclick="openFlowDrawer()" style="cursor:pointer"><span class="fh-t">服务流程 <span style="font-size:12px;color:var(--primary)">›</span></span><span class="fh-n" id="mainLine">主线 3/6</span><span class="fh-cfg" id="flowCfgBtn" onclick="event.stopPropagation();openFlowConfig()">⚙ 配置</span></div>
        <div class="flow-stats" onclick="openFlowDrawer()" style="cursor:pointer">
          <span class="fs-seg"><span class="fs-num" id="cNum">3/5</span><span class="fs-lab">合同 · <span id="cPct">60%</span></span></span>
          <span class="fs-div"></span>
          <span class="fs-seg"><span class="fs-num" id="tNum">12/20</span><span class="fs-lab">任务 · <span id="tPct">60%</span></span></span>
        </div>
        <div class="rail-wrap">
          <div class="flow-rail" id="flowRail"></div>
          <div class="rail-mask" id="railMask"></div>
        </div>
      </div>

      <!-- 今日动态（对齐服务端原型页） -->
      <div class="card activity-card">
        <div class="card-head"><span class="ch-t">📝 今日动态</span><span class="ch-a" onclick="go('activity-list.html')">查看全部 ›</span></div>
        <div class="activity-list" id="activityList">
          <div class="activity-item" onclick="go('task-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#1890FF">陈</div>
              <div class="activity-info">
                <span class="activity-user">陈庄</span><span class="activity-role-tag project-manager">项目总</span>
                <div class="activity-time">01-15 10:30</div>
              </div>
            </div>
            <div class="activity-content">确认了 <span class="hl">水电</span> 开槽布线验收，进入下一阶段</div>
            <div class="activity-media">
              <div class="activity-media-item" style="background:#cdd5dc"><div class="play"></div></div>
              <div class="activity-media-item" style="background:#d7dde2"></div>
              <div class="activity-media-item" style="background:#c9d0d6"></div>
            </div>
          </div>
          <div class="activity-item" onclick="go('task-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#722ED1">张</div>
              <div class="activity-info">
                <span class="activity-user">张设计</span><span class="activity-role-tag designer">设计</span>
                <div class="activity-time">01-15 09:15</div>
              </div>
            </div>
            <div class="activity-content">上传了 <span class="hl">初步设计方案</span> v3 图纸</div>
            <div class="activity-media">
              <div class="activity-media-item" style="background:#d2d8dd"></div>
              <div class="activity-media-item" style="background:#cdd5dc"></div>
            </div>
          </div>
          <div class="activity-item" onclick="go('task-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#52C41A">李</div>
              <div class="activity-info">
                <span class="activity-user">李伟</span><span class="activity-role-tag foreman">工长</span>
                <div class="activity-time">01-14 18:40</div>
              </div>
            </div>
            <div class="activity-content">完成了 <span class="hl">水电</span> 隐蔽工程验收</div>
          </div>
          <div class="activity-item" onclick="go('task-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#FA8C16">王</div>
              <div class="activity-info">
                <span class="activity-user">王强</span><span class="activity-role-tag worker">施工</span>
                <div class="activity-time">01-14 15:20</div>
              </div>
            </div>
            <div class="activity-content">提交了 工地巡检 记录</div>
            <div class="activity-media">
              <div class="activity-media-item" style="background:#d7dde2"></div>
              <div class="activity-media-item" style="background:#c9d0d6"></div>
            </div>
          </div>
          <div class="activity-item extra hidden" onclick="go('contract-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#1890FF">陈</div>
              <div class="activity-info">
                <span class="activity-user">陈庄</span><span class="activity-role-tag project-manager">项目总</span>
                <div class="activity-time">01-13 11:00</div>
              </div>
            </div>
            <div class="activity-content">发起了 <span class="hl">主材安装</span> 合同签订流程</div>
          </div>
          <div class="activity-item extra hidden" onclick="go('task-detail.html')">
            <div class="activity-header">
              <div class="activity-avatar" style="background:#722ED1">张</div>
              <div class="activity-info">
                <span class="activity-user">张设计</span><span class="activity-role-tag designer">设计</span>
                <div class="activity-time">01-12 16:30</div>
              </div>
            </div>
            <div class="activity-content">完成了 量房 原始尺寸复测</div>
          </div>
        </div>
        <div class="activity-more-btn" id="activityMoreBtn" onclick="toggleActivityMore()">展开更多</div>
      </div>
      <div style="height:var(--sp-3)"></div>
      </div><!-- /#nonworkerView -->

      <!-- ===== 工人视角：待办 / 我的任务 / 快捷入口 / 合同 / 任务统计（无服务流程卡） ===== -->
      <div id="workerView" style="display:none">
        <div class="card">
          <div class="card-head"><span class="ch-t">待办事项</span><span class="ch-n">3</span><span class="ch-a" onclick="go('todo-list.html')">全部 ›</span></div>
          <div class="todo-row" onclick="go('contract-detail.html?status=confirming_sender')">
            <span class="t-tag t-contract">合同</span>
            <span class="t-main"><span class="t-title">泥瓦工班组服务合同确认</span><span class="t-sub">泥瓦工作组 · 待我确认</span></span>
            <span class="t-go">去处理 ›</span>
          </div>
          <div class="todo-row" onclick="go('task-detail.html')">
            <span class="t-tag t-task">任务</span>
            <span class="t-main"><span class="t-title">墙面基层处理</span><span class="t-sub">油漆工作组 · 李四待确认</span></span>
            <span class="t-go">去处理 ›</span>
          </div>
          <div class="todo-row" onclick="go('task-detail.html')">
            <span class="t-tag t-task">任务</span>
            <span class="t-main"><span class="t-title">地砖铺贴</span><span class="t-sub">泥瓦工作组 · 王五待确认</span></span>
            <span class="t-go">去处理 ›</span>
          </div>
        </div>

        <div class="card">
          <div class="mytask-row" onclick="go(myTasksHref())">
            <span class="mt-t">我的任务</span>
            <span class="mt-s" id="mtSWorker">待处理 1 · 确认中 3 · 已完成 4</span>
            <span class="mt-a">›</span>
          </div>
        </div>

        <div class="card qn-card">
          <div class="quick-nav">
            <div class="qn" onclick="go('activity-list.html')"><span class="qn-ic">动</span><span class="qn-tx">项目动态</span></div>
            <div class="qn" onclick="go('member.html')"><span class="qn-ic">团</span><span class="qn-tx">团队成员</span></div>
            <div class="qn" onclick="go('project-files.html')"><span class="qn-ic">资</span><span class="qn-tx">资料</span></div>
            <div class="qn" onclick="scrollToMyFlow()"><span class="qn-ic">合</span><span class="qn-tx">我的合同</span></div>
          </div>
        </div>

        <!-- 我的合同：只渲染「我签署的工人合同」（2 条示例）；服务流程不在此展开，仅保留卡头「全部流程」入口 -->
        <div class="card" id="myFlowCard">
          <div class="card-head">
            <span class="ch-t">我的合同</span>
            <span class="ch-n" id="mfCount">1 份合同</span>
            <span class="ch-a" id="mfViewAll" onclick="openFlowDrawer()">全部流程 ›</span>
          </div>
          <div id="myFlowList"></div>
        </div>

        <div style="height:var(--sp-3)"></div>
      </div><!-- /#workerView -->
    </div><!-- /#pageBody -->

    <!-- 小程序底部主导航（项目为当前项） -->
    <div class="tab-bar">
      <div class="tab-item" onclick="location.href='home.html'"><span class="ti">🏠</span><span class="tl">首页</span></div>
      <div class="tab-item active"><span class="ti">📋</span><span class="tl">项目</span></div>
      <div class="tab-item" onclick="location.href='message.html'"><span class="ti">💬</span><span class="tl">消息</span></div>
      <div class="tab-item" onclick="toast('个人中心开发中')"><span class="ti">👤</span><span class="tl">我的</span></div>
    </div>

    <!-- 右侧「服务流程项」浮窗（参考 owner 项目导航） -->
    <div class="flow-trigger" id="flowTrigger" onclick="openFlowDrawer()">
      <span class="ft-arrow">‹</span>
      <span class="ft-text">服务流程</span>
    </div>
    <div class="flow-drawer-mask" id="flowDrawerMask" onclick="closeFlowDrawer()"></div>
    <div class="flow-drawer" id="flowDrawer">
      <div class="fd-header">
        <span class="fd-ic">ⓘ</span>
        <span class="fd-title">服务流程项</span>
        <span class="fd-tag">施工路线</span>
        <span class="fd-right">
          <span class="fd-cfg" id="fdCfg" onclick="openFlowConfig()">配置</span>
          <span class="fd-close" onclick="closeFlowDrawer()">×</span>
        </span>
      </div>
      <div class="fd-info">
        <span class="fd-badge" id="fdMainCount">主线 3/6</span>
        <span class="fd-act" id="fdContractAct" onclick="goContract('drawer')" style="display:none"></span>
        <span class="fd-locate" id="fdLocate" onclick="locateCurrent()">📍 定位当前</span>
      </div>
      <div class="fd-content">
        <div id="fdFlowList"></div>
        <div id="fdDetailWrap"><div id="fdDetail"></div></div>
      </div>
      <div class="fd-footer">点击流程项可切换 · 点击任务查看详情</div>
    </div>

    <!-- 指派任务（临时任务）轻量表单：布局参考「添加新任务」弹窗，确认/担责标准非必填 -->
    <div class="assign-modal" id="assignModal">
      <div class="am-content">
        <div class="am-header">
          <div class="am-title">指派任务</div>
          <div class="am-close" onclick="closeAssignModal()">✕</div>
        </div>
        <div class="am-body">
          <div class="am-group">
            <label class="am-label">任务名称 <span class="am-required">*</span></label>
            <input type="text" class="am-input" id="asName" placeholder="请输入任务名称">
            <div class="am-err" id="asNameErr"></div>
          </div>
          <div class="am-group">
            <label class="am-label">执行人 <span class="am-required">*</span></label>
            <div class="am-select" id="asExecutorSelect">
              <div class="am-select-btn" onclick="toggleAsSelect('asExecutorSelect')"><span id="asExecutorText">请选择执行人</span><span class="arr">▼</span></div>
              <div class="am-dropdown" id="asExecutorDropdown"></div>
            </div>
            <div class="am-err" id="asExecutorErr"></div>
          </div>
          <div class="am-group">
            <label class="am-label">确认人（选填，最多5人）</label>
            <div class="am-select" id="asConfirmSelect">
              <div class="am-select-btn" onclick="toggleAsSelect('asConfirmSelect')"><span id="asConfirmText">请选择确认人</span><span class="arr">▼</span></div>
              <div class="am-dropdown" id="asConfirmDropdown"></div>
            </div>
            <div class="am-err" id="asConfirmErr"></div>
          </div>
          <div class="am-group">
            <label class="am-label">执行标准 <span class="am-required">*</span></label>
            <textarea class="am-textarea" id="asExecStd" placeholder="请输入执行标准"></textarea>
            <div class="am-err" id="asStdErr"></div>
          </div>
          <div class="am-group">
            <label class="am-label">确认标准（选填）</label>
            <textarea class="am-textarea" id="asConfirmStd" placeholder="请输入确认标准（选填）"></textarea>
          </div>
          <div class="am-group">
            <label class="am-label">担责标准（选填）</label>
            <textarea class="am-textarea" id="asLiableStd" placeholder="请输入担责标准（选填）"></textarea>
          </div>
        </div>
        <div class="am-footer">
          <button class="am-submit" onclick="confirmAssignTask()">确认指派</button>
        </div>
      </div>
    </div>

    <!-- 角色认证提示弹窗（新建项目需先完成认证） -->
    <div class="app-modal" id="authRequiredModal">
      <div class="modal-box">
        <div class="modal-title">创建项目需先完成认证</div>
        <div class="modal-content">
          <p>当前操作需先完成角色认证；</p>
          <p>认证通过后方可继续创建；</p>
        </div>
        <div class="modal-actions">
          <div class="modal-btn cancel" onclick="closeAuthModal()">取消</div>
          <div class="modal-btn confirm" onclick="goToAuthPage()">立即认证</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== 演示控制（框外） ===== -->
  <div class="demo-panel">
    <h4>演示控制（不影响页面语义）</h4>
    <div class="dp-group">
      <div class="dp-lab">角色视角</div>
      <div class="dp-opts" id="optRole">
        <div class="dp-opt on" data-v="nonworker">非工人</div>
        <div class="dp-opt" data-v="worker">工人</div>
      </div>
    </div>
    <div class="dp-group">
      <div class="dp-lab">认证状态（对应新建项目）</div>
      <div class="dp-opts" id="optAuth">
        <div class="dp-opt on" data-v="no">未认证</div>
        <div class="dp-opt" data-v="yes">已认证</div>
      </div>
    </div>
    <div class="dp-group">
      <div class="dp-lab">选中项状态</div>
      <div class="dp-opts" id="optStatus">
        <div class="dp-opt" data-v="未开始">未开始</div>
        <div class="dp-opt on" data-v="进行中">进行中</div>
        <div class="dp-opt" data-v="已完成">已完成</div>
        <div class="dp-opt" data-v="已终止">已终止</div>
      </div>
    </div>
    <div class="dp-group">
      <div class="dp-lab">流程配置权限（非工人）</div>
      <div class="dp-opts" id="optCfgPerm">
        <div class="dp-opt on" data-v="all">可配置</div>
        <div class="dp-opt" data-v="readonly">只读</div>
        <div class="dp-opt" data-v="none">无权限</div>
      </div>
    </div>
    <div class="dp-group">
      <div class="dp-lab">指派任务权限（按流程项）</div>
      <div class="dp-opts" id="optAssignPerm">
        <div class="dp-opt on" data-v="all">全部可指派</div>
        <div class="dp-opt" data-v="partial">仅基础施工</div>
        <div class="dp-opt" data-v="none">全部无权限</div>
      </div>
    </div>
    <div class="dp-group">
      <div class="dp-lab">查看全部流程权限（工人视角）</div>
      <div class="dp-opts" id="optViewAll">
        <div class="dp-opt on" data-v="yes">可查看</div>
        <div class="dp-opt" data-v="no">不可查看</div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

<script>
/* ===== 状态色 ===== */
function statusStyle(s) {
  switch (s) {
    case '进行中': return { dot: '#1677ff', ring: '', badge: 'b-go', bar: '#1677ff' };
    case '已完成': return { dot: '#52c41a', ring: '', badge: 'b-done', bar: '#52c41a' };
    case '已终止': return { dot: '#fff', ring: '#ff4d4f', badge: 'b-stop', bar: '#ff4d4f' };
    default:       return { dot: '#fff', ring: '#d9d9d9', badge: 'b-wait', bar: '#d9d9d9' };
  }
}
function badgeText(s) { return s === '未开始' ? '待开始' : s; }

/* ===== 数据 ===== */
function baseItems() {
  return [
    { id: 'lh', name: '量房', kind: 'task', status: '已完成', done: 3, total: 3,
      tasks: [
        { name: '原始尺寸复测', exec: '张设计', status: '已完成' },
        { name: '墙体结构勘测', exec: '李设计', status: '已完成' },
        { name: '设备点位确认', exec: '王设计', status: '已完成' }
      ] },
    { id: 'cs', name: '初步设计', kind: 'task', status: '已完成', done: 4, total: 4,
      tasks: [
        { name: '方案文件·户型优化', exec: '张设计', status: '已完成' },
        { name: '内部评审', exec: '李设计', status: '已完成' },
        { name: '会审', exec: '王设计', status: '已完成' },
        { name: '方案定稿', exec: '张设计', status: '已完成' }
      ] },
    { id: 'ht', name: '设计服务', kind: 'contract', status: '已完成', done: 7, total: 7,
      subCount: 1, mainDone: true, subDone: 1, hasContract: true,
      stages: [
        { id: 'ht-s1', name: '方案设计阶段', status: '已完成', collapsed: false, tasks: [
          { name: '原始量房尺寸复测', status: '已完成' },
          { name: '户型优化方案', status: '已完成' },
          { name: '方案评审与定稿', status: '已完成' }
        ] },
        { id: 'ht-s2', name: '施工图设计阶段', status: '已完成', collapsed: false, tasks: [
          { name: '平立面布置图', status: '已完成' },
          { name: '水电点位深化图', status: '已完成' },
          { name: '节点大样图', status: '已完成' }
        ] }
      ],
      externals: [ { name: '设计交底', exec: '张设计', status: '已完成' } ] },
    { id: 'sg', name: '基础施工服务', kind: 'contract', status: '进行中', done: 10, total: 39,
      subCount: 3, mainDone: true, subDone: 2, hasContract: true,
      stages: [
        { id: 'sg-s1', name: '基础施工阶段', status: '已完成', collapsed: false, tasks: [
          { name: '现场放线与三方交底', status: '已完成' },
          { name: '墙体拆除与建筑垃圾清运', status: '已完成' },
          { name: '新建砌墙与植筋加固', status: '已完成' },
          { name: '门窗洞口修整与过梁浇筑', status: '已完成' },
          { name: '成品保护与文明施工验收', status: '已完成' }
        ] },
        { id: 'sg-s2', name: '水电隐蔽工程', status: '进行中', collapsed: false, tasks: [
          { name: '强弱电开槽与弹线定位', status: '已完成' },
          { name: '冷热水管路铺设与打压测试', status: '已完成' },
          { name: '卫生间沉箱防漏与二次排水', status: '进行中', hasTag: true },
          { name: '中央空调/新风主机吊装穿梁', status: '进行中', hasTag: true },
          { name: '强弱电穿线与底盒安装', status: '未开始' },
          { name: '隐蔽工程节点联合三方验收', status: '未开始' }
        ] },
        { id: 'sg-s3', name: '泥瓦铺贴与防水防渗', status: '未开始', collapsed: true, tasks: [
          { name: '卫生间及阳台高分子防水刷制', status: '未开始' },
          { name: '闭水试验48小时联合签字', status: '未开始' },
          { name: '墙地砖铺贴与地面找平', status: '未开始' },
          { name: '窗台石与门槛石安装', status: '未开始' },
          { name: '泥瓦工程完工验收', status: '未开始' }
        ] },
        { id: 'sg-s4', name: '木工吊顶与柜体制作', status: '未开始', collapsed: true, tasks: [
          { name: '轻钢龙骨吊顶封板', status: '未开始' },
          { name: '背景墙基层与造型制作', status: '未开始' },
          { name: '现场柜体下料与组装', status: '未开始' },
          { name: '木工工程完工验收', status: '未开始' }
        ] },
        { id: 'sg-s5', name: '油漆涂饰与竣工收尾', status: '未开始', collapsed: true, tasks: [
          { name: '墙面挂网与腻子批刮三遍', status: '未开始' },
          { name: '顶面乳胶漆滚涂两遍', status: '未开始' },
          { name: '木作油漆与收口补缝', status: '未开始' },
          { name: '开荒保洁与竣工初验', status: '未开始' }
        ] }
      ],
      externals: [
        { name: '工地巡检', exec: '王强', status: '已完成' },
        { name: '材料进场验收', exec: '李伟', status: '进行中' },
        { name: '收口验收', exec: '孙磊', status: '未开始' },
        { name: '水电节点复检', exec: '赵敏', status: '未开始' },
        { name: '隐蔽工程旁站', exec: '赵敏', status: '未开始' },
        { name: '瓷砖/石材进场复验', exec: '李伟', status: '已完成', confirms: ['孙磊', '王强'] },
        { name: '卫生间防水闭水旁站', exec: '赵敏', status: '已完成' },
        { name: '瓷砖空鼓与平整度抽检', exec: '李伟', status: '进行中' },
        { name: '吊顶龙骨间距抽检', exec: '钱七', status: '进行中', confirms: ['孙磊'] },
        { name: '墙面腻子打磨验收', exec: '钱七', status: '未开始' },
        { name: '门套与柜体基层尺寸复核', exec: '王强', status: '未开始' },
        { name: '强弱电箱回路核对', exec: '赵敏', status: '未开始', confirms: ['孙磊'] },
        { name: '成品保护巡查', exec: '孙磊', status: '未开始' },
        { name: '工地安全用电检查', exec: '孙磊', status: '未开始' },
        { name: '竣工前全面巡检', exec: '王强', status: '未开始', confirms: ['孙磊', '李伟'] }
      ] },
    { id: 'cz', name: '主材安装', kind: 'contract', status: '未开始', done: 0, total: 5,
      subCount: 0, mainDone: false, subDone: 0, hasContract: true,
      stages: [
        { id: 'cz-s1', name: '主材进场阶段', status: '未开始', collapsed: false, tasks: [
          { name: '瓷砖/石材进场', status: '未开始' },
          { name: '卫浴洁具进场', status: '未开始' },
          { name: '橱柜进场', status: '未开始' }
        ] },
        { id: 'cz-s2', name: '安装收尾阶段', status: '未开始', collapsed: false, tasks: [
          { name: '灯具安装', status: '未开始' },
          { name: '开关插座安装', status: '未开始' }
        ] }
      ],
      externals: [] },
    { id: 'sh', name: '售后', kind: 'task', status: '未开始', done: 0, total: 0, tasks: [] }
  ];
}
/* ===== 服务流程项：结构由「服务流程配置」驱动（SSOT = js/flow-config-store.js） =====
   配置项提供顺序 / 名称 / 是否含合同 / 增减；明细（阶段、任务、临时任务）按 id 从 baseItems 继承。
   新增项无明细 → stages/tasks 为空，浮窗显示「暂无阶段任务」；是否含合同决定有无合同入口。 */
function cfgItems() {
  var cfg = (window.FlowCfgStore ? FlowCfgStore.get() : null);
  if (!cfg || !cfg.length) return baseItems();
  var detail = {};
  baseItems().forEach(function (it) { detail[it.id] = it; });
  return cfg.map(function (c) {
    var d = detail[c.id] || {};
    return {
      id: c.id,
      name: c.name,
      kind: c.hasContract ? 'contract' : 'task',
      hasContract: !!c.hasContract,
      status: d.status || c.status || '未开始',
      done: typeof d.done === 'number' ? d.done : 0,
      total: typeof d.total === 'number' ? d.total : (c.tasks || 0),
      subCount: d.subCount || 0,
      mainDone: !!d.mainDone,
      subDone: d.subDone || 0,
      stages: d.stages || [],
      tasks: d.tasks || [],
      externals: d.externals || []
    };
  });
}
/* 配置变更后重新载入：流程条、浮窗、主线统计一起刷新，选中项失效则兜底第一项 */
function reloadFlowItems() {
  ITEMS = cfgItems();
  var still = ITEMS.some(function (x) { return x.id === selectedId; });
  if (!still) selectedId = (ITEMS[0] || {}).id;
  refreshStats();
  renderRail();
  syncDrawerIfOpen();
}

var ITEMS = cfgItems();
var selectedId = 'sg';      // 默认首个进行中项
var detailOpen = true;
var overrideStatus = '进行中'; // 演示开关：覆盖选中项状态

/* ===== 渲染流程条 ===== */
function renderRail(smooth) {
  var rail = document.getElementById('flowRail');
  rail.innerHTML = '';
  var list = ITEMS;
  list.forEach(function (it) {
    var st = (it.id === selectedId) ? overrideStatus : it.status;
    var ss = statusStyle(st);
    var el = document.createElement('div');
    el.className = 'flow-item' + (it.id === selectedId ? ' on' : '');
    el.setAttribute('data-id', it.id);
    var prog = it.total > 0 ? (it.done + '/' + it.total) : '—';
    var pct = it.total > 0 ? Math.round(it.done / it.total * 100) : 0;
    el.innerHTML =
      '<span class="fi-dot" style="background:' + ss.dot + (ss.ring ? ';border:2px solid ' + ss.ring : '') + '"></span>' +
      '<span class="fi-name">' + it.name + '</span>' +
      '<span class="fi-bar"><i style="width:' + pct + '%;background:' + ss.bar + '"></i></span>' +
      '<span class="fi-prog">' + prog + '</span>';
    el.addEventListener('click', function () { selectItem(it.id); });
    rail.appendChild(el);
  });
  updateMask();
  // 选中项居中：仅在流程条确实溢出时才加首尾留白（避免内容本可容纳时凭空出现滚动）
  rail.classList.toggle('centerable', rail.scrollWidth > rail.clientWidth + 2);
  centerRail(rail, rail.querySelector('.flow-item.on'), smooth === true);
  renderContractAction();
}

function updateMask() {
  var rail = document.getElementById('flowRail');
  var mask = document.getElementById('railMask');
  mask.style.display = rail.scrollWidth > rail.clientWidth + 2 ? 'block' : 'none';
}

function selectItem(id) {
  selectedId = id;
  renderRail(true);
  openFlowDrawer();   // 选中流程项 → 展开并展示右侧浮窗
}

/* ===== 渲染明细（主页面已不再内联展示，明细统一在右侧浮窗；保留函数名以免破坏调用方） ===== */
function renderDetail() {
  return;
}

function rowHtml(name, meta, badge, status, isContract) {
  var ss = statusStyle(status);
  return '<div class="d-row" onclick="go(\'' + (isContract ? 'contract-detail.html' : 'task-detail.html') + '\')">' +
    '<span class="d-name">' + name + '</span>' +
    '<span class="d-meta">' + meta + '</span>' +
    '<span class="badge ' + ss.badge + '">' + badge + '</span>' +
    '<span class="d-go">›</span></div>';
}
function countDone(arr) { return arr.filter(function (x) { return x.status === '已完成'; }).length; }

function setDetail(open) {
  detailOpen = open;
  var box = document.getElementById('flowDetail');
  if (box) box.classList.toggle('collapsed', !open);
}

/* ===== 统计 / 主线 ===== */
function refreshStats() {
  // 合同：主合同 + 子合同数 / 已签(进行中+已完成)；任务：阶段任务 + 临时任务 的 已完成/总数
  var list = ITEMS;
  var cTotal = 0, cDone = 0, tTotal = 0, tDone = 0, mainDone = 0;
  list.forEach(function (it) {
    if (it.kind === 'contract') {
      cTotal += 1 + (it.subCount || 0);
      if (it.mainDone) cDone += 1;
      cDone += (it.subDone || 0);
      (it.stages || []).forEach(function (s) {
        tTotal += s.tasks.length;
        tDone += s.tasks.filter(function (t) { return t.status === '已完成'; }).length;
      });
      (it.externals || []).forEach(function (e) { tTotal += 1; if (e.status === '已完成') tDone += 1; });
    } else {
      tTotal += it.tasks.length;
      tDone += countDone(it.tasks);
      (it.externals || []).forEach(function (e) { tTotal += 1; if (e.status === '已完成') tDone += 1; });
    }
    if (it.status === '已完成') mainDone += 1;
  });
  document.getElementById('cNum').textContent = cDone + '/' + cTotal;
  document.getElementById('tNum').textContent = tDone + '/' + tTotal;
  document.getElementById('cPct').textContent = (cTotal ? Math.round(cDone / cTotal * 100) : 0) + '%';
  document.getElementById('tPct').textContent = (tTotal ? Math.round(tDone / tTotal * 100) : 0) + '%';
  document.getElementById('mainLine').textContent = '主线 ' + mainDone + '/' + list.length;
}

/* ===== 今日动态：展开更多 ===== */
function toggleActivityMore() {
  var extras = document.querySelectorAll('#activityList .activity-item.extra');
  var willShow = document.querySelector('#activityList .activity-item.extra.hidden') !== null;
  extras.forEach(function (it) { it.classList.toggle('hidden', !willShow); });
  document.getElementById('activityMoreBtn').textContent = willShow ? '收起' : '展开更多';
}

/* ===== 项目切换面板（沿用旧项目主页：筛选 / 选择项目 / 新建项目 + 认证拦截） ===== */
var PROJECTS = [
  { name: '西安全屋整装', status: '进行中', address: '西安市雁塔区***号***室', contractSigned: 4, contractTotal: 5, taskDone: 18, taskTotal: 24 },
  { name: '北京旧房翻新', status: '进行中', address: '北京市朝阳区***号***室', contractSigned: 2, contractTotal: 3, taskDone: 8, taskTotal: 15 },
  { name: '南阳样板间', status: '已完工', address: '南阳市宛城区***号', contractSigned: 6, contractTotal: 6, taskDone: 32, taskTotal: 32 }
];
var currentIndex = 0;
var panelFilter = 'all';
var currentRole = 'nonworker';
var isUserCertified = false;

function renderPanel() {
  var list = PROJECTS.filter(function (p) {
    if (panelFilter === 'ongoing') return p.status === '进行中';
    if (panelFilter === 'done') return p.status === '已完工' || p.status === '已完成';
    return true;
  });
  var box = document.getElementById('projPanelInner');
  if (!list.length) { box.innerHTML = '<div class="proj-empty">暂无匹配的项目</div>'; return; }
  box.innerHTML = list.map(function (p) {
    var realIdx = PROJECTS.indexOf(p);
    var pct = Math.round(p.contractSigned / p.contractTotal * 100);
    var active = realIdx === currentIndex ? ' active' : '';
    var done = p.status === '已完工' ? ' done' : '';
    return '<div class="proj-option' + active + '" onclick="selectProject(' + realIdx + ')">' +
      '<div class="po-top"><span class="po-name">' + p.name + '</span><span class="po-status' + done + '">' + p.status + '</span></div>' +
      '<div class="po-addr">📍 ' + p.address + '</div>' +
      '<div class="po-stats"><span>合同 ' + p.contractSigned + '/' + p.contractTotal + '</span><span>任务 ' + p.taskDone + '/' + p.taskTotal + '</span></div>' +
      '<div class="po-bar"><div class="po-bar-fill" style="width:' + pct + '%"></div></div></div>';
  }).join('');
}
function renderSwitchBar() {
  var p = PROJECTS[currentIndex];
  document.getElementById('curProjName').textContent = p.name;
  var st = document.getElementById('curProjStatus');
  st.textContent = p.status;
  st.className = 'proj-status' + (p.status === '已完工' ? ' done' : '');
}
function togglePanel() {
  var panel = document.getElementById('projPanel');
  var arrow = document.getElementById('switchArrow');
  var open = panel.classList.toggle('open');
  if (arrow) arrow.classList.toggle('open', open);
}
function selectProject(i) {
  currentIndex = i;
  renderSwitchBar();
  renderPanel();
  togglePanel();
  toast('已切换到 ' + PROJECTS[i].name);
}
function setPanelFilter(f, el) {
  panelFilter = f;
  document.querySelectorAll('#projPanelFilter .pf-item').forEach(function (it) { it.classList.remove('active'); });
  if (el) el.classList.add('active');
  renderPanel();
}
function createProject() {
  if (isUserCertified) { window.location.href = 'create-project.html'; }
  else { document.getElementById('authRequiredModal').classList.add('show'); }
}
function closeAuthModal() { document.getElementById('authRequiredModal').classList.remove('show'); }
function goToAuthPage() { closeAuthModal(); window.location.href = 'promoter-auth.html'; }
function viewProjectInfo() { window.location.href = 'project-info.html'; }

/* 统一真实跳转（对齐旧页 navigate/go/openPage 口径：全部跳转到既有原型页） */
function go(href) { if (href) window.location.href = href; }
/* 我的任务：与 task-list.html 的 ?scope=mytasks 契约同源，带上当前视角 */
function myTasksHref() { return 'task-list.html?scope=mytasks&role=' + currentRole; }
function renderMyTaskSummary() {
  if (!window.MyTasksStore) return;
  var el = document.getElementById(currentRole === 'worker' ? 'mtSWorker' : 'mtSNonworker');
  if (el) el.textContent = MyTasksStore.text(currentRole);
}
function navigate(href) { go(href); }
function openPage(href) { go(href); }

/* 原型导航：收起/展开 + 记忆 */
function togglePageNav() {
  var nav = document.querySelector('.page-nav');
  var btn = document.getElementById('pageNavToggle');
  if (!nav) return;
  var collapsed = nav.classList.toggle('collapsed');
  if (btn) btn.classList.toggle('collapsed', collapsed);
  try { localStorage.setItem('pageNavCollapsed', collapsed ? 'true' : 'false'); } catch (e) {}
}
(function restorePageNav() {
  try {
    if (localStorage.getItem('pageNavCollapsed') === 'true') {
      var nav = document.querySelector('.page-nav');
      var btn = document.getElementById('pageNavToggle');
      if (nav) nav.classList.add('collapsed');
      if (btn) btn.classList.add('collapsed');
    }
  } catch (e) {}
})();

/* 角色视角：非工人 = 服务流程主视图；工人 = 待办/我的任务/合同/任务统计 */
/* ===== 工人视角：我的合同（由「我签订的工人合同」驱动） =====
   一处只展示工人合同本身（contract-store.js 六类工种合同：拆除/水电/木作/泥瓦/油漆/小零工），
   不以项目级服务流程项（基础施工服务 / 主材安装 / 设计服务…）作为卡片主体——那是非工人的服务合同口径。
   卡片 = 一份工种合同：合同名 + 签订状态 + 甲方/工期 + 该合同的「承接任务」阶段轨 + 我的任务。
   本块不展开服务流程，服务流程统一收在卡头「全部流程」入口（按权限显隐）。
   示例数据取 2 条（已签约 / 待确认 各一），覆盖两种签订态。
   跳转带 id（demo-<工种>-example）+ 受邀方状态，落到对应的工种合同详情。 */
var MY_CONTRACTS = [
  {
    contract: '水电班组服务合同', type: 'shuidian', contractName: '全屋水电改造合同',
    partyA: '陈庄', duration: 30,
    signState: '已签约',
    stages: [
      { n: '开槽', s: 'done' }, { n: '布管', s: 'done' }, { n: '沉箱·我', s: 'cur' },
      { n: '穿线', s: 'todo' }, { n: '验收', s: 'todo' }
    ],
    myStage: '当前水电隐蔽', myDone: 3, myTotal: 6,
    href: 'worker-contract-detail.html?id=demo-shuidian-example&viewer=receiver&status=worker_signed'
  },
  {
    contract: '泥瓦工班组服务合同', type: 'niwa', contractName: '厨卫贴砖泥瓦合同',
    partyA: '陈庄', duration: 20,
    signState: '待确认',
    stages: [
      { n: '防水', s: 'todo' }, { n: '闭水', s: 'todo' }, { n: '铺贴·我', s: 'todo' }, { n: '收口', s: 'todo' }
    ],
    myStage: '待合同生效', myDone: 0, myTotal: 5,
    href: 'worker-contract-detail.html?id=demo-niwa-example&viewer=receiver&status=worker_inviting_receiver'
  }
];
function myFlowHtml() {
  return MY_CONTRACTS.map(function (c) {
    var stHtml = c.stages.map(function (s) {
      var cls = 'mf-st' + (s.s === 'done' ? ' done' : s.s === 'cur' ? ' cur' : '');
      return '<span class="' + cls + '">' + s.n + '</span>';
    }).join('');
    var meta = c.contractName + ' · 甲方 ' + c.partyA + ' · 工期 ' + c.duration + ' 天';
    return '<div class="mf-item">' +
      '<div class="mf-top"><span class="mf-name">' + c.contract + '</span>' +
        '<span class="mf-badge ' + (c.signState === '待确认' ? 'off' : 'on') + '">' + c.signState + '</span></div>' +
      '<div class="mf-contract"><span class="mf-ct-tag">工人合同</span>' + meta + '</div>' +
      '<div class="mf-stages">' + stHtml + '</div>' +
      '<div class="mf-foot"><span class="mf-tasks">我的任务 ' + c.myDone + '/' + c.myTotal + ' · ' + c.myStage + '</span>' +
        '<span class="mf-link" onclick="event.stopPropagation();go(\'' + c.href + '\')">查看合同 ›</span></div>' +
    '</div>';
  }).join('');
}
function renderMyFlow() {
  var list = document.getElementById('myFlowList');
  if (!list) return;
  list.innerHTML = myFlowHtml();
  var cnt = document.getElementById('mfCount');
  if (cnt) cnt.textContent = MY_CONTRACTS.length + ' 份合同';
  // 「全部流程」按权限显隐：无可查看全部流程权限时不提供入口
  var va = document.getElementById('mfViewAll');
  if (va) va.style.display = canViewAllFlow ? '' : 'none';
}
/* 快捷入口「我的合同」：合同信息已并入我的合同块，此处滚动定位该卡并短暂高亮 */
function scrollToMyFlow() {
  var card = document.getElementById('myFlowCard');
  if (!card) return;
  if (typeof card.scrollIntoView === 'function') card.scrollIntoView({ block: 'center', behavior: 'smooth' });
  card.classList.add('hl');
  setTimeout(function () { card.classList.remove('hl'); }, 1400);
}

function setRole(role) {
  currentRole = role;
  document.getElementById('nonworkerView').style.display = role === 'nonworker' ? '' : 'none';
  document.getElementById('workerView').style.display = role === 'worker' ? '' : 'none';
  // 服务流程仅非工人（项目负责人）视角存在：工人视角隐藏右侧浮窗入口
  var ft = document.getElementById('flowTrigger');
  if (ft) ft.style.display = role === 'worker' ? 'none' : 'flex';
  if (role === 'worker') closeFlowDrawer();
  syncFlowCfgEntry();
  document.getElementById('pageBody').scrollTop = 0;
  renderMyTaskSummary();
}
function setCertified(yes) {
  isUserCertified = yes;
}

/* 点击面板外部自动收起项目切换面板 */
document.addEventListener('click', function (e) {
  var panel = document.getElementById('projPanel');
  var topbar = document.getElementById('topbar');
  if (panel && panel.classList.contains('open') && topbar && !topbar.contains(e.target)) togglePanel();
});

/* ===== Toast ===== */
var toastTimer;
function toast(msg) {
  var t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { t.classList.remove('show'); }, 1600);
}

/* ===== sticky 常驻分隔线 ===== */
document.getElementById('pageBody').addEventListener('scroll', function () {
  var st = document.getElementById('flowSticky');
  if (!st) return;
  // 以「元素是否真正贴到滚动容器顶部」判定，而非 scrollTop 阈值（sticky 元素不在页面顶部时阈值判定会提前亮起）
  var pr = this.getBoundingClientRect().top;
  var sr = st.getBoundingClientRect().top;
  st.classList.toggle('stuck', sr <= pr + 1);
});
/* 浮窗内容滚动：流程项 Tab 条吸顶后亮阴影（提示上方仍有流程项上下文） */
(function () {
  var fc = document.querySelector('.fd-content');
  if (!fc) return;
  fc.addEventListener('scroll', function () {
    var fl = document.getElementById('fdFlowList');
    if (fl) fl.classList.toggle('stuck', this.scrollTop > 8);
  });
})();

/* ===== 右侧「服务流程项」浮窗 ===== */
function mainDoneCount() {
  var list = ITEMS;
  return list.filter(function (x) { return x.status === '已完成'; }).length;
}
function syncDrawerIfOpen() {
  var d = document.getElementById('flowDrawer');
  if (d && d.classList.contains('open')) renderFlowDrawer();
}
function openFlowDrawer() {
  renderFlowDrawer();
  document.getElementById('flowDrawerMask').classList.add('open');
  document.getElementById('flowDrawer').classList.add('open');
  document.getElementById('flowTrigger').style.opacity = '0';
}
function closeFlowDrawer() {
  document.getElementById('flowDrawerMask').classList.remove('open');
  document.getElementById('flowDrawer').classList.remove('open');
  document.getElementById('flowTrigger').style.opacity = '1';
}
function fdRow(name, meta, badge, status) {
  var ss = statusStyle(status);
  return '<div class="fd-item" onclick="go(\'task-detail.html\')">' +
    '<span class="fd-dot" style="background:' + ss.dot + (ss.ring ? ';border:2px solid ' + ss.ring : '') + '"></span>' +
    '<span class="fd-name">' + name + '</span>' +
    '<span class="fd-meta">' + meta + '</span>' +
    '<span class="fd-badge badge ' + ss.badge + '">' + badge + '</span></div>';
}
function selectFlow(id) {
  selectedId = id;
  renderRail(true);
  renderDetail();
  setDetail(true);
  renderFlowDrawer();   // 抽屉内流程条由 renderFlowDrawer 自行居中
}
var fdDetailTab = 'stage';   // 'stage' = 主合同内的阶段任务；'ext' = 临时任务阶段任务
var fdStageCollapsed = {};   // 阶段卡片折叠态（按 stage id 记忆）
var fdLastSelId = null;
function fdStageCls(s) { return s === '已完成' ? 'completed' : (s === '进行中' ? 'in_progress' : 'pending'); }
function fdTaskIcon(s) { return s === '已完成' ? '✓' : ''; }
/* 选中项居中：把横向流程条滚到「选中项居中」位置（首尾留白由 ::before/::after 提供） */
function centerRail(rail, item, smooth) {
  if (!rail || !item || !rail.clientWidth) return;
  var target = item.offsetLeft - (rail.clientWidth - item.offsetWidth) / 2;
  if (target < 0) target = 0;
  var max = rail.scrollWidth - rail.clientWidth;
  if (max > 0 && target > max) target = max;
  if (typeof rail.scrollTo === 'function') {
    try { rail.scrollTo({ left: target, behavior: smooth ? 'smooth' : 'auto' }); }
    catch (e) { rail.scrollLeft = target; }
  } else {
    rail.scrollLeft = target;
  }
}
/* ===== 合同入口：与选中流程项强关联（仅含合同型流程项出现） =====
   浮窗（抽屉）全口径：已建合同显示「查看合同」，未建合同显示「拟定合同」；
   主页服务流程卡为纯概览，不再提供任何合同动作（查看/拟定统一收归浮窗与「合同」模块）。 */
function fdList() { return ITEMS; }
function contractAction(sel, surface) {
  if (!sel || !sel.hasContract) return null;            // 未配置「含合同」的流程项不出现任何合同入口
  if (surface === 'home') return null;                  // 主页服务流程卡 = 纯概览，不渲染任何合同按钮
  if (sel.subCount) return { text: '查看合同', cls: 'view', url: 'contract-detail.html?from=flow&item=' + sel.id };
  return { text: '拟定合同', cls: 'create', url: 'create-contract.html?from=flow&item=' + sel.id };
}
function goContract(surface) {
  var sel = fdList().filter(function (x) { return x.id === selectedId; })[0];
  var a = contractAction(sel, surface || 'drawer');
  if (!a) return;
  window.location.href = a.url;
}
/* 仅浮窗头部渲染合同动作（查看/拟定）；主页服务流程卡已取消合同按钮，纯概览。 */
function renderContractAction() {
  var sel = fdList().filter(function (x) { return x.id === selectedId; })[0];
  var el = document.getElementById('fdContractAct');
  if (!el) return;
  var a = contractAction(sel, 'drawer');
  if (!a) { el.style.display = 'none'; el.textContent = ''; return; }
  el.style.display = '';
  el.className = 'fd-act ' + a.cls;
  el.textContent = a.text;
}
function centerFdRail(smooth) {
  var rail = document.querySelector('#fdFlowList .fd-rail');
  if (rail) centerRail(rail, rail.querySelector('.fd-rail-item.active'), smooth);
}
/* ===== 定位当前：把浮窗复位到「现场真实进度」 =====
   ① 当前施工项：第一个进行中项 → 全完成则最后一个已完成项 → 否则第一项（演示覆盖态优先）
   ② 选中并居中鱼眼 Tab（主页面流程条同步）
   ③ 明细滚到该项「进行中」阶段顶部，折叠则先展开，并高亮 1.6s
   ④ 轻提示说明落点，重复点击也重新闪一次（避免死点） */
function currentFlowItem() {
  var list = fdList();
  var st = function (it) { return it.id === selectedId ? overrideStatus : it.status; };
  var running = list.filter(function (it) { return st(it) === '进行中'; });
  if (running.length) return running[0];
  var done = list.filter(function (it) { return st(it) === '已完成'; });
  if (done.length) return done[done.length - 1];
  return list[0] || null;
}
function locateStageOf(it) {
  var stages = (it && it.stages) || [];
  var running = stages.filter(function (s) { return s.status === '进行中'; });
  if (running.length) return running[0];
  var next = stages.filter(function (s) { return s.status !== '已完成'; });
  return next[0] || stages[stages.length - 1] || null;
}
function scrollFdToLocate(stage) {
  var fc = document.querySelector('.fd-content');
  if (!fc) return;
  var fl = document.getElementById('fdFlowList');
  var railH = (fl && fl.offsetHeight) ? fl.offsetHeight : 0;
  var card = stage ? document.querySelector('.fd-stage-card[data-sid="' + stage.id + '"]') : null;
  var target = card || document.getElementById('fdDetailBody');
  if (!target) return;
  var top = fc.scrollTop + target.getBoundingClientRect().top - fc.getBoundingClientRect().top - railH - 6;
  if (top < 0) top = 0;
  if (typeof fc.scrollTo === 'function') {
    try { fc.scrollTo({ top: top, behavior: 'smooth' }); }
    catch (e) { fc.scrollTop = top; }
  } else {
    fc.scrollTop = top;
  }
  if (card) {
    card.classList.remove('locate-hl');
    void card.offsetWidth;              // 强制重排，重复点击也能重新触发动画
    card.classList.add('locate-hl');
    setTimeout(function () { card.classList.remove('locate-hl'); }, 1700);
  }
  return card;
}
function locateCurrent() {
  var it = currentFlowItem();
  if (!it) return;
  var switched = it.id !== selectedId;
  if (switched) {
    selectedId = it.id;
    renderRail(true);                   // 主页面流程条同步选中并居中
  }
  fdDetailTab = 'stage';                // 合同项若停在「临时任务」页签，先回到阶段页签，阶段才可见
  renderFlowDrawer();
  var stage = locateStageOf(it);
  if (stage && fdStageCollapsed[stage.id]) {
    var card = document.querySelector('.fd-stage-card[data-sid="' + stage.id + '"]');
    if (card) toggleFdStage(stage.id);  // 折叠态自动展开（同步 max-height 与折叠记忆）
  }
  scrollFdToLocate(stage);
  toast('已定位 · ' + it.name + (stage ? ' · ' + stage.name : ''));
}

/* ===== 指派任务（临时任务）：轻量表单弹窗，确认/担责标准非必填 ===== */
var AS_WORKERS = [
  { name: '王强', role: '施工' },
  { name: '李伟', role: '施工' },
  { name: '孙磊', role: '监理' },
  { name: '赵敏', role: '水电' },
  { name: '钱七', role: '油漆' }
];
var asExecutor = '';
var asConfirmers = [];
/* 工人视角是否可查看全部服务流程（决定「我的服务流程」卡头「查看全部」的显隐） */
var canViewAllFlow = true;
/* 流程配置权限：非工人 + 有权配置才出现「⚙ 配置」入口（演示三态 all/readonly/none） */
var flowCfgPerm = 'all';
function canConfigFlow() { return currentRole !== 'worker' && flowCfgPerm !== 'none'; }
function syncFlowCfgEntry() {
  var b = document.getElementById('flowCfgBtn');
  if (b) b.style.display = canConfigFlow() ? '' : 'none';
  var f = document.getElementById('fdCfg');
  if (f) f.style.display = canConfigFlow() ? '' : 'none';
}
function openFlowConfig() {
  if (currentRole === 'worker') { toast('工人无流程配置权限'); return; }
  if (flowCfgPerm === 'none') { toast('暂无流程配置权限'); return; }
  window.location.href = 'flow-config.html?perm=' + flowCfgPerm + '&from=project';
}
/* 指派任务权限：原型按「人员权限内是否赋予该流程项的指派任务功能权限」控制入口显隐（演示用三态） */
var assignPermMode = 'all';   // 'all' 全部可指派 | 'partial' 仅基础施工服务 | 'none' 全部无权限
function canAssign(it) {
  if (!it) return false;
  if (currentRole === 'worker') return false;   // 工人无指派权限
  if (assignPermMode === 'none') return false;
  if (assignPermMode === 'partial') return it.id === 'sg';
  return true;
}
function openAssignModal() {
  var sel = fdList().filter(function (x) { return x.id === selectedId; })[0];
  if (!sel || !canAssign(sel)) return;
  // 重置表单
  document.getElementById('asName').value = '';
  document.getElementById('asExecStd').value = '';
  document.getElementById('asConfirmStd').value = '';
  document.getElementById('asLiableStd').value = '';
  asExecutor = ''; asConfirmers = [];
  document.getElementById('asExecutorText').textContent = '请选择执行人';
  document.getElementById('asConfirmText').textContent = '请选择确认人';
  document.getElementById('asNameErr').style.display = 'none';
  document.getElementById('asStdErr').style.display = 'none';
  document.getElementById('asExecutorErr').style.display = 'none';
  document.getElementById('asConfirmErr').style.display = 'none';
  // 执行人选项（静态演示人员）
  document.getElementById('asExecutorDropdown').innerHTML = AS_WORKERS.map(function (p) {
    return '<div class="am-opt" onclick="pickAsExecutor(\'' + p.name + '\', \'' + p.role + '\')">' + p.name + '<span class="role">' + p.role + '</span></div>';
  }).join('');
  // 确认人选项（多选，最多5人）
  renderAsConfirmOptions();
  closeAsDropdowns();
  document.getElementById('assignModal').classList.add('show');
}
function closeAssignModal() {
  document.getElementById('assignModal').classList.remove('show');
  closeAsDropdowns();
}
function toggleAsSelect(id) {
  var el = document.getElementById(id);
  if (!el) return;
  var willOpen = !el.classList.contains('open');
  closeAsDropdowns();
  if (willOpen) el.classList.add('open');
}
function closeAsDropdowns() {
  document.querySelectorAll('.am-select.open').forEach(function (e) { e.classList.remove('open'); });
}
function pickAsExecutor(name, role) {
  asExecutor = name;
  document.getElementById('asExecutorText').textContent = name + ' · ' + role;
  var err = document.getElementById('asExecutorErr');
  if (err) { err.style.display = 'none'; }
  closeAsDropdowns();
}
function renderAsConfirmOptions() {
  document.getElementById('asConfirmDropdown').innerHTML = AS_WORKERS.map(function (p) {
    var checked = asConfirmers.indexOf(p.name) >= 0;
    return '<div class="am-opt' + (checked ? ' checked' : '') + '" onclick="pickAsConfirmer(\'' + p.name + '\')">' + p.name +
      '<span class="role">' + p.role + '</span>' + (checked ? '<span class="ck">✓</span>' : '') + '</div>';
  }).join('');
}
function pickAsConfirmer(name) {
  var err = document.getElementById('asConfirmErr');
  var idx = asConfirmers.indexOf(name);
  if (idx >= 0) {
    asConfirmers.splice(idx, 1);
  } else {
    if (asConfirmers.length >= 5) {
      if (err) { err.textContent = '最多选择 5 位确认人'; err.style.display = 'block'; }
      return;
    }
    asConfirmers.push(name);
  }
  if (err) { err.style.display = 'none'; }
  var n = asConfirmers.length;
  document.getElementById('asConfirmText').textContent = n === 0 ? '请选择确认人'
    : (n <= 2 ? asConfirmers.join('、') : asConfirmers.slice(0, 2).join('、') + ' 等' + n + '人');
  renderAsConfirmOptions();  // 就地刷新勾选态（下拉保持展开）
}
function confirmAssignTask() {
  document.getElementById('asNameErr').style.display = 'none';
  document.getElementById('asStdErr').style.display = 'none';
  document.getElementById('asExecutorErr').style.display = 'none';
  var sel = fdList().filter(function (x) { return x.id === selectedId; })[0];
  if (!sel || !canAssign(sel)) return;
  var name = document.getElementById('asName').value.trim();
  var std = document.getElementById('asExecStd').value.trim();
  var valid = true;
  if (!name) { var e1 = document.getElementById('asNameErr'); e1.textContent = '请输入任务名称'; e1.style.display = 'block'; valid = false; }
  if (!std) { var e2 = document.getElementById('asStdErr'); e2.textContent = '请输入执行标准'; e2.style.display = 'block'; valid = false; }
  if (!asExecutor) { var e3 = document.getElementById('asExecutorErr'); e3.textContent = '请选择执行人'; e3.style.display = 'block'; valid = false; }
  if (!valid) return;
  // 写回数据：插入该流程项的临时任务列表（未开始），流程项任务总数 +1，各处计数自动重算
  sel.externals = sel.externals || [];
  sel.externals.push({ name: name, exec: asExecutor, confirms: asConfirmers.slice(), status: '未开始' });
  sel.total = (sel.total || 0) + 1;
  closeAssignModal();
  if (sel.kind === 'contract') fdDetailTab = 'ext';   // 合同型项：切到临时任务 Tab；任务型项内容内联，无需切 Tab
  refreshStats();
  renderFlowDrawer();
}
function renderFlowDrawer() {
  var list = ITEMS;
  var selIdx = -1;
  list.forEach(function (it, i) { if (it.id === selectedId) selIdx = i; });
  // 流程项：横向鱼眼 Tab（选中放大、邻项按距离缩小；进度颜色与计数保留）
  var railEl = document.getElementById('fdFlowList');
  var cards = railEl.querySelectorAll('.fd-rail .fd-rail-item');
  if (cards.length === list.length) {
    // 数量未变：就地更新类名/进度（保留 DOM，让鱼眼缩放过渡动画生效）
    list.forEach(function (it, i) {
      var el = cards[i];
      var st = (it.id === selectedId) ? overrideStatus : it.status;
      var ss = statusStyle(st);
      var prog = it.total > 0 ? (it.done + '/' + it.total) : '—';
      var pct = it.total > 0 ? Math.round(it.done / it.total * 100) : 0;
      var d = Math.abs(i - selIdx);
      el.className = 'fd-rail-item' + (it.id === selectedId ? ' active' : '') + ' fd-ri-d' + (d > 3 ? 3 : d);
      var barI = el.querySelector('.fd-ri-bar i');
      barI.style.width = pct + '%';
      barI.style.background = ss.bar;
      el.querySelector('.fd-ri-prog').textContent = prog;
    });
  } else {
    // 数量变化（演示开关 6/8 项）：整条重建
    railEl.innerHTML = '<div class="fd-rail">' + list.map(function (it, i) {
      var st = (it.id === selectedId) ? overrideStatus : it.status;
      var ss = statusStyle(st);
      var active = it.id === selectedId ? ' active' : '';
      var d = Math.abs(i - selIdx);
      var prog = it.total > 0 ? (it.done + '/' + it.total) : '—';
      var pct = it.total > 0 ? Math.round(it.done / it.total * 100) : 0;
      return '<div class="fd-rail-item' + active + ' fd-ri-d' + (d > 3 ? 3 : d) + '" onclick="selectFlow(\'' + it.id + '\')">' +
        '<span class="fd-ri-name">' + it.name + '</span>' +
        '<span class="fd-ri-bar"><i style="width:' + pct + '%;background:' + ss.bar + '"></i></span>' +
        '<span class="fd-ri-prog">' + prog + '</span></div>';
    }).join('') + '</div>';
  }

  var sel = list.filter(function (x) { return x.id === selectedId; })[0];
  // 切换流程项时，按数据初始折叠态重建阶段卡片折叠记忆
  if (selectedId !== fdLastSelId) {
    fdStageCollapsed = {};
    if (sel && sel.stages) sel.stages.forEach(function (s) { fdStageCollapsed[s.id] = (s.collapsed === true); });
    fdLastSelId = selectedId;
  }
  document.getElementById('fdDetail').innerHTML = renderFdDetail(sel);
  updateCollapseAllLabel();
  centerFdRail(true);
  // 书签列吸顶位置 = 流程项 Tab 条实际高度 + 明细区上边距（消除签与面板顶部之间的透明缝隙）
  var flEl = document.getElementById('fdFlowList');
  var wrapEl = document.querySelector('#fdDetail .fd-bm-wrap');
  if (flEl && flEl.offsetHeight > 0) {
    var bmMt = 0;
    if (wrapEl) { var m = parseFloat(getComputedStyle(wrapEl).marginTop); if (!isNaN(m)) bmMt = m; }
    document.documentElement.style.setProperty('--fd-rail-h', (flEl.offsetHeight + bmMt) + 'px');
  }
  document.getElementById('fdMainCount').innerHTML = '主线 <b>' + mainDoneCount() + '</b>/' + list.length + ' 环';
  renderContractAction();
}
function renderFdDetail(sel) {
  if (!sel) return '';
  if (sel.kind === 'contract') {
    var stageOn = fdDetailTab === 'stage' ? ' on' : '';
    var extOn = fdDetailTab === 'ext' ? ' on' : '';
    var stageCount = sel.stages.length;
    var extList = sel.externals || [];
    var extDone = extList.filter(function (e) { return e.status === '已完成'; }).length;
    return '<div class="fd-bm-wrap">' +
      '<div class="fd-bm-col">' +
      '<div class="fd-bm' + stageOn + '" data-g="stage" onclick="switchFdTab(\'stage\')">合同内<span class="fd-bm-n">' + stageCount + ' 阶段</span></div>' +
      '<div class="fd-bm' + extOn + '" data-g="ext" onclick="switchFdTab(\'ext\')">临时任务<span class="fd-bm-n">' + extDone + '/' + extList.length + '</span></div>' +
      '<div class="fd-bm-util"' + (fdDetailTab === 'ext' ? ' style="display:none"' : '') + ' onclick="toggleAllFdStages()"><span id="fdcLabel">收起</span></div>' +
      '</div>' +
      '<div class="fd-bm-panel">' +
        '<div id="fdDetailBody">' + fdDetailBody(sel, fdDetailTab) + '</div>' +
      '</div>' +
      '</div>';
  }
  // 任务型流程项（量房/初步设计/售后等）：本项任务 + 临时任务内联列表 + 吸底指派入口
  var tRows = sel.tasks && sel.tasks.length
    ? sel.tasks.map(function (t) { return fdRow(t.name, '执行 ' + t.exec, badgeText(t.status), t.status); }).join('')
    : '<div class="fd-empty">' + ((sel.stages && sel.stages.length)
        ? '该项未开启「含合同」，阶段任务已隐藏'
        : '该流程项暂无任务') + '</div>';
  var ext = sel.externals || [];
  var extHtml = '';
  if (ext.length) {
    extHtml = '<div class="fd-ext-sub"><div class="fd-ext-sub-h">临时任务<span class="fd-ext-sub-n">' + ext.length + '</span></div>' +
      ext.map(function (e) { return fdExtRow(e); }).join('') + '</div>';
  }
  return '<div id="fdDetailBody">' + tRows + extHtml + fdAssignBar(sel) + '</div>';
}
function fdDetailBody(sel, group) {
  if (sel.kind !== 'contract') return '';
  if (group === 'ext') return fdExtHtml(sel);
  // 已开启「含合同」但还没有合同：阶段任务需在合同内配置
  if (!sel.stages || !sel.stages.length) {
    return '<div class="fd-empty">该项已开启「含合同」，尚未创建合同。创建合同后可配置阶段与任务</div>' + fdAssignBar(sel);
  }
  // 主合同内的阶段任务：可折叠阶段卡片（对齐 owner 项目导航）
  var html = '<div class="fd-stage-list">';
  sel.stages.forEach(function (st) {
    var collapsed = fdStageCollapsed[st.id] === true;
    var total = st.tasks.length;
    var done = st.tasks.filter(function (t) { return t.status === '已完成'; }).length;
    var ddCls = fdStageCls(st.status);
    var tasksHtml = st.tasks.map(function (t) {
      var tCls = fdStageCls(t.status);
      var tag = t.hasTag ? '<span class="fd-task-tag">#</span>' : '';
      return '<div class="fd-stage-task-item ' + tCls + '" onclick="go(\'task-detail.html\')">' +
        '<span class="fd-task-status-icon ' + tCls + '">' + fdTaskIcon(t.status) + '</span>' +
        '<span class="fd-task-name">' + t.name + '</span>' + tag +
        '<span class="fd-task-arrow">›</span></div>';
    }).join('');
    var maxH = collapsed ? '0px' : (total * 50 + 4) + 'px';
    html += '<div class="fd-stage-card' + (collapsed ? ' collapsed' : '') + '" data-sid="' + st.id + '">' +
      '<div class="fd-stage-header" onclick="toggleFdStage(\'' + st.id + '\')">' +
        '<span class="fd-stage-status-dot ' + ddCls + '"></span>' +
        '<div class="fd-stage-info"><span class="fd-stage-title">' + st.name + '</span>' +
          '<span class="fd-stage-count-badge ' + ddCls + '">' + done + '/' + total + '</span></div>' +
        '<span class="fd-stage-collapse-arrow">⌄</span>' +
      '</div>' +
      '<div class="fd-stage-task-list" style="max-height:' + maxH + '">' + tasksHtml + '</div>' +
    '</div>';
  });
  html += '</div>';
  return html;
}
function fdExtHtml(sel) {
  var list = sel.externals || [];
  var body = list.length
    ? '<div class="fd-ext-list">' + list.map(function (e) { return fdExtRow(e); }).join('') + '</div>'
    : '<div class="fd-ext-none">暂无临时任务</div>';
  return body + fdAssignBar(sel);
}
/* 指派任务入口：明细区底部吸底（有权限才渲染），临时任务再多也一步可达 */
function fdAssignBar(sel) {
  if (!canAssign(sel)) return '';
  return '<div class="fd-assignbar"><button type="button" class="fd-ext-add" onclick="openAssignModal()">＋ 指派任务</button></div>';
}
function fdExtRow(e) {
  var ss = statusStyle(e.status);
  return '<div class="fd-ext-task" onclick="go(\'task-detail.html\')">' +
    '<span class="fd-dot" style="background:' + ss.dot + (ss.ring ? ';border:2px solid ' + ss.ring : '') + '"></span>' +
    '<span class="fd-name">' + e.name + '</span>' +
    (e.exec ? '<span class="fd-meta">' + e.exec + '</span>' : '') +
    (e.confirms && e.confirms.length ? '<span class="fd-meta">确认' + e.confirms.length + '人</span>' : '') +
    '<span class="fd-badge badge ' + ss.badge + '">' + badgeText(e.status) + '</span></div>';
}
function toggleFdStage(sid) {
  var card = document.querySelector('.fd-stage-card[data-sid="' + sid + '"]');
  if (!card) return;
  var listEl = card.querySelector('.fd-stage-task-list');
  var collapsed = card.classList.toggle('collapsed');
  fdStageCollapsed[sid] = collapsed;
  var n = listEl.querySelectorAll('.fd-stage-task-item').length;
  listEl.style.maxHeight = collapsed ? '0px' : (n * 50 + 4) + 'px';
}
/* 一键收起/展开当前 Tab 内所有阶段卡片（作用于明细，不隐藏整区） */
function toggleAllFdStages() {
  var body = document.getElementById('fdDetailBody');
  if (!body) return;
  var cards = body.querySelectorAll('.fd-stage-card');
  if (!cards.length) return;
  var allCollapsed = true;
  cards.forEach(function (c) { if (!c.classList.contains('collapsed')) allCollapsed = false; });
  var target = allCollapsed ? 'expand' : 'collapse';
  cards.forEach(function (c) {
    var listEl = c.querySelector('.fd-stage-task-list');
    if (!listEl) return;
    if (target === 'collapse') {
      c.classList.add('collapsed');
      listEl.style.maxHeight = '0px';
    } else {
      c.classList.remove('collapsed');
      var n = listEl.querySelectorAll('.fd-stage-task-item').length;
      listEl.style.maxHeight = (n * 50 + 4) + 'px';
    }
    var sid = c.getAttribute('data-sid');
    if (sid) fdStageCollapsed[sid] = (target === 'collapse');
  });
  updateCollapseAllLabel();
}
function updateCollapseAllLabel() {
  var label = document.getElementById('fdcLabel');
  if (!label) return;
  var body = document.getElementById('fdDetailBody');
  if (!body) { label.textContent = '收起'; return; }
  var cards = body.querySelectorAll('.fd-stage-card');
  if (!cards.length) { label.textContent = '收起'; return; }
  var allCollapsed = true;
  cards.forEach(function (c) { if (!c.classList.contains('collapsed')) allCollapsed = false; });
  label.textContent = allCollapsed ? '展开' : '收起';
}
function switchFdTab(group) {
  fdDetailTab = group;
  var tabs = document.querySelectorAll('#fdDetail .fd-bm');
  tabs.forEach(function (t) { t.classList.toggle('on', t.getAttribute('data-g') === group); });
  // 收起/展开工具只对「合同内」阶段卡有效，临时任务平铺列表下隐藏
  var util = document.querySelector('#fdDetail .fd-bm-util');
  if (util) util.style.display = group === 'ext' ? 'none' : 'flex';
  var body = document.getElementById('fdDetailBody');
  if (!body) return;
  var sel = (ITEMS).filter(function (x) { return x.id === selectedId; })[0];
  if (sel && sel.kind === 'contract') body.innerHTML = fdDetailBody(sel, group);
  updateCollapseAllLabel();
}

/* ===== 演示开关 ===== */
function bindOpts(groupId, cb) {
  var g = document.getElementById(groupId);
  g.querySelectorAll('.dp-opt').forEach(function (o) {
    o.addEventListener('click', function () {
      g.querySelectorAll('.dp-opt').forEach(function (x) { x.classList.remove('on'); });
      o.classList.add('on');
      cb(o.getAttribute('data-v'));
    });
  });
}
bindOpts('optStatus', function (v) { overrideStatus = v; renderRail(); renderDetail(); syncDrawerIfOpen(); });
bindOpts('optAssignPerm', function (v) { assignPermMode = v; syncDrawerIfOpen(); });
bindOpts('optViewAll', function (v) { canViewAllFlow = v === 'yes'; renderMyFlow(); });
bindOpts('optCfgPerm', function (v) { flowCfgPerm = v; syncFlowCfgEntry(); });
bindOpts('optRole', function (v) { setRole(v); });
bindOpts('optAuth', function (v) { setCertified(v === 'yes'); });

/* ===== 初始化 ===== */
refreshStats();
renderRail();
renderDetail();
setDetail(true);
renderMyFlow();
renderSwitchBar();
syncFlowCfgEntry();

/* 从「服务流程配置」返回（含 bfcache 恢复）时重新读取配置：流程条 / 浮窗 / 主线统计同步 */
window.addEventListener('pageshow', function () {
  if (!window.FlowCfgStore) return;
  reloadFlowItems();
  syncFlowCfgEntry();
  renderMyFlow();
});
renderPanel();
setRole('nonworker');
window.addEventListener('resize', updateMask);

/* 合同列表页「查看流程」回跳：?item=<流程项id> 直接打开对应流程项浮窗 */
(function () {
  var m = /[?&]item=([^&]+)/.exec(location.search);
  if (!m) return;
  var id = decodeURIComponent(m[1]);
  var hit = false;
  for (var i = 0; i < ITEMS.length; i++) { if (ITEMS[i].id === id) { hit = true; break; } }
  if (!hit) return;
  selectedId = id;
  renderRail(false);
  renderDetail();
  openFlowDrawer();
})();
</script>
</body>
</html>
