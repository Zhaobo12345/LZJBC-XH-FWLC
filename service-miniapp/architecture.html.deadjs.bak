    <script>
        let currentCreateType = 'level1';
        let hasCreatePermission = true;
        let currentCreateParentName = '';
        const currentUser = { name: '张三', role: '项目经理' };
        function escapeHtml(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
        
        const groupContracts = {
            '水电工作组': { name: '水电分包合同', status: '已签约', id: 'contract-1' },
            '泥瓦工作组': { name: '泥瓦分包合同', status: '已签约', id: 'contract-4' },
            '木工工作组': null,
            '油漆工作组': null
        };
        
        const joinedGroups = ['水电工作组', '强电施工组'];
        
        let exitGroupName = '';
        
        const userTaskRoles = {
            executor: ['水电工作组-开槽布线', '强电施工组-布管'],
            confirmer: ['水电工作组-水电验收']
        };
        
        function checkCanExitGroup(groupName) {
            const contract = groupContracts[groupName];
            if (contract && contract.status === '已签约') {
                return { canExit: false, reason: '该工作组已签订合同，无法退出' };
            }
            
            const allTaskRoles = [...userTaskRoles.executor, ...userTaskRoles.confirmer];
            const isTaskRole = allTaskRoles.some(task => task.startsWith(groupName));
            if (isTaskRole) {
                return { canExit: false, reason: '您是该工作组任务的执行人或确认人，无法退出' };
            }
            
            return { canExit: true, reason: '' };
        }
        
        function checkCanExitProject() {
            for (const groupName of joinedGroups) {
                const contract = groupContracts[groupName];
                if (contract && contract.status === '已签约') {
                    return { canExit: false, reason: `您加入的"${groupName}"已签订合同，无法退出项目部` };
                }
            }
            
            const allTaskRoles = [...userTaskRoles.executor, ...userTaskRoles.confirmer];
            if (allTaskRoles.length > 0) {
                return { canExit: false, reason: '您是项目任务的执行人或确认人，无法退出项目部' };
            }
            
            return { canExit: true, reason: '' };
        }
        
        function showAppModal(title, content, onConfirm, showCancel = true) {
            document.getElementById('appModalTitle').textContent = title;
            document.getElementById('appModalContent').textContent = content;
            document.getElementById('appModalCancel').style.display = showCancel ? 'flex' : 'none';
            document.getElementById('appModal').classList.add('show');
            
            document.getElementById('appModalConfirm').onclick = function() {
                closeAppModal();
                if (onConfirm) onConfirm();
            };
        }
        
        function closeAppModal() {
            document.getElementById('appModal').classList.remove('show');
        }
        
        function showToast(message, duration = 2000) {
            const toast = document.getElementById('appToast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, duration);
        }
        
        function toggleNode(header) {
            const children = header.nextElementSibling;
            const expand = header.querySelector('.node-expand');
            
            if (children && children.classList.contains('node-children')) {
                children.classList.toggle('show');
                if (expand) {
                    expand.classList.toggle('expanded');
                }
            }
        }
        
        function showCreateModal(type, parentName) {
            if (!hasCreatePermission) {
                showAppModal('提示', '您没有创建架构的权限', null, false);
                return;
            }
            
            if (type === 'level2' && parentName) {
                const contract = groupContracts[parentName];
                if (!contract) {
                    showAppModal('提示', '该工作组尚未创建合同，请先创建合同后再添加施工组', null, false);
                    return;
                }
            }
            
            currentCreateType = type;
            
            document.getElementById('level1Form').style.display = 'none';
            document.getElementById('level2Form').style.display = 'none';
            
            const modalTitle = document.getElementById('modalTitle');
            
            if (type === 'level1') {
                modalTitle.textContent = '创建工作组';
                document.getElementById('level1Form').style.display = 'block';
                document.getElementById('level1Name').value = '';
                currentCreateParentName = '';
            } else if (type === 'level2') {
                modalTitle.textContent = '创建施工组';
                document.getElementById('level2Form').style.display = 'block';
                document.getElementById('level2Name').value = '';
                currentCreateParentName = parentName || '';
                document.getElementById('level2ParentDisplay').textContent = parentName || '';
            }
            
            document.getElementById('createModal').classList.add('show');
        }
        
        function closeCreateModal() {
            document.getElementById('createModal').classList.remove('show');
        }
        
        function createNode() {
            let name = '';
            
            if (currentCreateType === 'level1') {
                name = document.getElementById('level1Name').value;
                if (!name.trim()) {
                    showAppModal('提示', '请填写工作组名称', null, false);
                    return;
                }
            } else if (currentCreateType === 'level2') {
                name = document.getElementById('level2Name').value;
                if (!name.trim()) {
                    showAppModal('提示', '请填写施工组名称', null, false);
                    return;
                }
            }
            
            showAppModal('创建确认', `确定要创建"${name}"吗？`, function() {
                insertCreatedNode(currentCreateType, name, currentCreateParentName);
                showToast('创建成功！创建人：' + currentUser.name);
                closeCreateModal();
            });
        }
        
        function findGroupNode(name) {
            const headers = document.querySelectorAll('.architecture-tree > .tree-node > .node-children > .tree-node > .node-header.level-1');
            for (const h of headers) {
                const nm = h.querySelector('.node-name');
                if (nm && nm.textContent.replace(/\s/g, '').indexOf(name.replace(/\s/g, '')) === 0) {
                    return h.parentElement;
                }
            }
            return null;
        }
        
        function insertCreatedNode(type, name, parentName) {
            const safeName = escapeHtml(name);
            const jsName = name.replace(/['"\\\n\r]/g, '');
            const creatorMeta = '<span class="role-tag creator">创建人</span> ' + escapeHtml(currentUser.name);
            if (type === 'level1') {
                const container = document.querySelector('.architecture-tree > .tree-node > .node-children');
                if (!container) return;
                const node = document.createElement('div');
                node.className = 'tree-node';
                node.innerHTML = `
                    <div class="node-header level-1" onclick="toggleNode(this)">
                        <div class="node-icon">🏗️</div>
                        <div class="node-info">
                            <div class="node-name">${safeName} <span class="contract-status-badge no-contract">待创建合同</span></div>
                            <div class="node-meta">${creatorMeta} · 0个施工组</div>
                        </div>
                        <div class="node-expand">▼</div>
                    </div>
                    <div class="node-children">
                        <div class="node-actions">
                            <div class="action-item primary" onclick="event.stopPropagation(); goCreateContract('${jsName}')">
                                <span class="icon">📝</span>
                                <span>创建合同</span>
                            </div>
                            <div class="action-item" onclick="event.stopPropagation(); showInviteMemberModal('${jsName}')">
                                <span class="icon">👥</span>
                                <span>邀请成员</span>
                            </div>
                            <div class="action-item" onclick="event.stopPropagation(); showCreateModal('level2', '${jsName}')">
                                <span class="icon">+</span>
                                <span>添加施工组</span>
                            </div>
                            <div class="action-item danger" onclick="event.stopPropagation(); showDeleteModal('${jsName}')">
                                <span class="icon">×</span>
                                <span>删除</span>
                            </div>
                        </div>
                    </div>`;
                container.appendChild(node);
                const statsNum = document.querySelector('.architecture-header .stat-item-inline .num');
                if (statsNum) statsNum.textContent = String(parseInt(statsNum.textContent, 10) + 1);
            } else if (type === 'level2') {
                const parentNode = findGroupNode(parentName);
                if (!parentNode) return;
                const children = parentNode.querySelector('.node-children');
                if (!children) return;
                const node = document.createElement('div');
                node.className = 'tree-node';
                node.innerHTML = `
                    <div class="node-header level-2" onclick="toggleNode(this)">
                        <div class="node-icon">🔧</div>
                        <div class="node-info">
                            <div class="node-name">${safeName}</div>
                            <div class="node-meta">${creatorMeta} · 0人</div>
                        </div>
                        <div class="node-expand">▼</div>
                    </div>
                    <div class="node-children">
                        <div class="node-actions">
                            <div class="action-item" onclick="event.stopPropagation(); showInviteMemberModal('${jsName}')">
                                <span class="icon">👥</span>
                                <span>邀请成员</span>
                            </div>
                            <div class="action-item danger" onclick="event.stopPropagation(); showExitGroupModal('${jsName}')">
                                <span class="icon">🚪</span>
                                <span>退出施工组</span>
                            </div>
                        </div>
                    </div>`;
                const actions = children.querySelector('.node-actions');
                if (actions && actions.nextSibling) {
                    children.insertBefore(node, actions.nextSibling);
                } else {
                    children.appendChild(node);
                }
            }
        }
        
        document.getElementById('createModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeCreateModal();
            }
        });
        
        let deleteTarget = '';
        
        function showDeleteModal(name) {
            if (!hasCreatePermission) {
                showAppModal('提示', '您没有删除架构的权限', null, false);
                return;
            }
            
            if (groupContracts[name]) {
                showAppModal('提示', '该工作组已创建合同，无法删除。如需删除请先删除合同。', null, false);
                return;
            }
            
            deleteTarget = name;
            document.getElementById('deleteModalContent').textContent = '确定要删除"' + name + '"吗？删除后该工作组下的所有施工组都将被删除，此操作无法恢复。';
            document.getElementById('deleteModal').classList.add('show');
        }
        
        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }
        
        function confirmDelete() {
            closeDeleteModal();
            showToast('"' + deleteTarget + '" 已删除');
        }
        
        function showExitGroupModal(groupName) {
            const checkResult = checkCanExitGroup(groupName);
            if (!checkResult.canExit) {
                showAppModal('无法退出', checkResult.reason, null, false);
                return;
            }
            exitGroupName = groupName;
            document.getElementById('exitGroupModalContent').textContent = '确定要退出"' + groupName + '"吗？退出后将无法查看该工作组的相关信息。';
            document.getElementById('exitGroupModal').classList.add('show');
        }
        
        function closeExitGroupModal() {
            document.getElementById('exitGroupModal').classList.remove('show');
        }
        
        function confirmExitGroup() {
            const index = joinedGroups.indexOf(exitGroupName);
            if (index > -1) {
                joinedGroups.splice(index, 1);
            }
            closeExitGroupModal();
            showToast('已退出"' + exitGroupName + '"');
        }
        
        function showExitProjectModal() {
            const checkResult = checkCanExitProject();
            if (!checkResult.canExit) {
                showAppModal('无法退出', checkResult.reason, null, false);
                return;
            }
            document.getElementById('exitProjectModalContent').textContent = '确定要退出项目部吗？退出后将无法查看该项目的相关信息。';
            document.getElementById('exitProjectModal').classList.add('show');
        }
        
        function closeExitProjectModal() {
            document.getElementById('exitProjectModal').classList.remove('show');
        }
        
        function confirmExitProject() {
            closeExitProjectModal();
            showToast('已退出项目部');
            setTimeout(() => {
                location.href = 'project-list.html';
            }, 1500);
        }
        
        function viewContract(nodeName) {
            const contract = groupContracts[nodeName];
            const contractList = document.getElementById('contractList');
            
            if (!contract) {
                contractList.innerHTML = '<div style="text-align: center; color: var(--text-tertiary); padding: 20px;">暂无关联合同</div>';
            } else {
                contractList.innerHTML = `
                    <div class="contract-item" onclick="goToContract('${contract.id}')">
                        <div class="icon">📄</div>
                        <div class="info">
                            <div class="name">${contract.name}</div>
                            <div class="status">状态：${contract.status}</div>
                        </div>
                        <div class="arrow">›</div>
                    </div>
                `;
            }
            
            document.getElementById('contractModal').classList.add('show');
        }
        
        function closeContractModal() {
            document.getElementById('contractModal').classList.remove('show');
        }
        
        function goToContract(contractId) {
            closeContractModal();
            location.href = 'contract-detail.html?id=' + contractId;
        }
        
        function setPermission(hasPermission) {
            hasCreatePermission = hasPermission;
            const actionBar = document.getElementById('actionBar');
            const notice = document.getElementById('permissionNotice');
            
            if (hasPermission) {
                actionBar.style.display = 'flex';
                notice.style.display = 'none';
            } else {
                actionBar.style.display = 'none';
                notice.style.display = 'flex';
            }
        }
        
        let currentInviteTarget = '';
        let currentInviteMethod = 'platform';
        
        let currentInviteCategory = 'service'; // service（服务人员） / owner（业主及家人）
        let currentPlatformUser = null; // 当前选中的平台用户 {id, name, role}

        const platformUsers = [
            { id: 'pu1', name: '张水电', type: 'service', role: '水电工', avatar: '张', verifiedRoles: 2 },
            { id: 'pu2', name: '李监理', type: 'service', role: '监理', avatar: '李', verifiedRoles: 1 },
            { id: 'pu3', name: '王设计', type: 'service', role: '设计师', avatar: '王', verifiedRoles: 0 },
            { id: 'pu4', name: '陈业主', type: 'owner', role: '业主', avatar: '陈', verifiedRoles: null },
            { id: 'pu5', name: '赵家人', type: 'owner', role: '业主家人', avatar: '赵', verifiedRoles: null }
        ];

        function selectInviteCategory(element, category) {
            currentInviteCategory = category;
            document.querySelectorAll('#inviteCategory .cat-seg').forEach(s => s.classList.remove('active'));
            element.classList.add('active');
            updateInviteTargetApp();
            currentPlatformUser = null;
            renderPlatformUsers();
            const qrText = document.querySelector('#qrcodeInviteForm .qrcode-text');
            if (qrText) qrText.textContent = category === 'service' ? '扫码加入工作组' : '扫码进入业主端小程序';
        }

        function updateInviteTargetApp() {
            const appHint = document.getElementById('inviteTargetApp');
            if (!appHint) return;
            const isService = currentInviteCategory === 'service';
            appHint.querySelector('.app-icon').textContent = isService ? '🛠️' : '🏠';
            appHint.querySelector('.app-line').innerHTML = isService
                ? '被邀请人将进入 <b>服务端小程序</b>'
                : '被邀请人将进入 <b>业主端小程序</b>（仅查看/确认，不进入施工组）';
            appHint.querySelector('.app-perm').textContent = isService
                ? '默认权限：仅基础公开数据，无治理权限'
                : '默认权限：全部权限';
        }

        function renderPlatformUsers() {
            const list = document.getElementById('platformUserList');
            if (!list) return;
            const kw = (document.getElementById('platformUserSearch').value || '').toLowerCase().trim();
            const isService = currentInviteCategory === 'service';
            // 方案A：默认不展示人员，需输入关键词搜索匹配（未认证角色的服务方人员不进入候选）
            if (!kw) {
                list.innerHTML = '<div class="empty-result">输入关键词搜索平台内的服务人员 / 业主</div>';
                return;
            }
            const filtered = platformUsers.filter(u => {
                if (u.type !== currentInviteCategory) return false;
                if (kw && !(u.name.toLowerCase().includes(kw) || u.role.toLowerCase().includes(kw))) return false;
                // 服务方人员须已认证至少一个角色，方可被匹配选择；未认证者不进入候选列表
                if (isService && !(u.verifiedRoles >= 1)) return false;
                return true;
            });
            if (!filtered.length) {
                list.innerHTML = '<div class="empty-result">未找到可匹配的用户</div>';
                return;
            }
                        list.innerHTML = filtered.map(u => `
                <div class="platform-user-item${currentPlatformUser && currentPlatformUser.id === u.id ? ' selected' : ''}" onclick="selectPlatformUser('${u.id}')">
                    <span class="pu-avatar">${u.avatar}</span>
                    <span class="pu-name">${u.name}</span>
                    <span class="pu-role">${u.role}</span>
                    <span class="pu-check">✓</span>
                </div>`).join('');
        }

        function filterPlatformUsers(keyword) {
            renderPlatformUsers();
        }

        function selectPlatformUser(id) {
            const u = platformUsers.find(x => x.id === id);
            if (!u) return;
            if (currentInviteCategory === 'service' && !(u.verifiedRoles >= 1)) return;
            currentPlatformUser = u;
            renderPlatformUsers();
        }

        function showInviteMemberModal(targetName) {
            if (!hasCreatePermission) {
                showAppModal('提示', '您没有邀请成员的权限', null, false);
                return;
            }
            currentInviteTarget = targetName;
            document.getElementById('inviteTargetName').textContent = targetName;

            currentInviteMethod = 'platform';
            document.querySelectorAll('#inviteMemberModal .invite-method').forEach(m => m.classList.remove('active'));
            document.querySelector('#inviteMemberModal .invite-method[onclick*="platform"]').classList.add('active');
            document.getElementById('platformInviteForm').style.display = 'block';
            document.getElementById('qrcodeInviteForm').style.display = 'none';
            document.getElementById('wechatInviteForm').style.display = 'none';

            const searchInput = document.getElementById('platformUserSearch');
            if (searchInput) searchInput.value = '';

            const confirmBtn = document.querySelector('#inviteMemberModal .modal-actions .modal-btn.confirm');
            if (confirmBtn) {
                confirmBtn.style.display = 'inline-block';
                confirmBtn.textContent = '发送邀请';
            }

            currentInviteCategory = 'service';
            document.querySelectorAll('#inviteCategory .cat-seg').forEach(ss => ss.classList.toggle('active', ss.dataset.cat === 'service'));
            renderPlatformUsers();
            updateInviteTargetApp();

            document.getElementById('inviteMemberModal').classList.add('show');
        }
        
        function closeInviteMemberModal() {
            document.getElementById('inviteMemberModal').classList.remove('show');
        }
        
        function selectInviteMethod(element, method) {
            currentInviteMethod = method;
            document.querySelectorAll('.invite-method').forEach(m => m.classList.remove('active'));
            element.classList.add('active');
            
            document.getElementById('platformInviteForm').style.display = method === 'platform' ? 'block' : 'none';
            document.getElementById('qrcodeInviteForm').style.display = method === 'qrcode' ? 'block' : 'none';
            document.getElementById('wechatInviteForm').style.display = method === 'wechat' ? 'block' : 'none';

            const confirmBtn = document.querySelector('#inviteMemberModal .modal-actions .modal-btn.confirm');
            if (confirmBtn) {
                confirmBtn.style.display = method === 'wechat' ? 'none' : 'inline-block';
                if (method === 'qrcode') {
                    confirmBtn.textContent = '下载二维码';
                } else {
                    confirmBtn.textContent = '发送邀请';
                }
            }
        }
        
        function sendInvite() {
            if (currentInviteMethod === 'platform') {
                if (!currentPlatformUser) {
                    showAppModal('提示', '请选择要邀请的平台用户', null, false);
                    return;
                }
                if (currentInviteCategory === 'service') {
                    showAppModal('邀请成功', `已向 ${currentPlatformUser.name} 发送加入"${currentInviteTarget}"（服务端小程序）的邀请，对方将在消息中心收到通知`, null, false);
                } else {
                    showAppModal('邀请成功', `已向 ${currentPlatformUser.name} 发送（业主端小程序）的邀请，对方将在业主端小程序收到通知`, null, false);
                }
                closeInviteMemberModal();
            } else if (currentInviteMethod === 'qrcode') {
                showToast('二维码已生成');
                closeInviteMemberModal();
            }
        }

        function shareToWechat() {
            const targetName = currentInviteTarget;
            const cardTitle = document.getElementById('wechatCardTitle');
            const cardDesc = document.getElementById('wechatCardDesc');
            let title, desc, toastMsg;
            if (currentInviteCategory === 'service') {
                title = `邀请你加入"${targetName}"`;
                desc = '点击卡片进入服务端小程序，开始团队协作';
                toastMsg = `已调起微信分享，选择好友发送邀请卡片即可邀请其加入"${targetName}"`;
            } else {
                title = '邀请你加入我的家装项目';
                desc = '点击卡片进入业主端小程序，查看项目进度';
                toastMsg = '已调起微信分享，选择好友发送邀请卡片即可邀请其进入业主端查看项目';
            }
            if (cardTitle) cardTitle.textContent = title;
            if (cardDesc) cardDesc.textContent = desc;

            if (typeof wx !== 'undefined' && wx.miniProgram && wx.miniProgram.shareAppMessage) {
                wx.miniProgram.shareAppMessage({
                    title: title,
                    path: '/pages/project-detail/index?invite=1'
                });
            } else {
                showToast('正在调起微信分享面板...');
                setTimeout(function() {
                    showAppModal('分享成功', toastMsg, function() {
                        closeInviteMemberModal();
                    });
                }, 1500);
            }
        }
        
        let currentContractTarget = '';
        
        function goCreateContract(groupName) {
            if (!hasCreatePermission) {
                showAppModal('提示', '您没有创建合同的权限', null, false);
                return;
            }
            if (groupContracts[groupName]) {
                showAppModal('提示', '该工作组已存在合同，一个工作组只能有一个合同', null, false);
                return;
            }
            location.href = 'create-contract.html?group=' + encodeURIComponent(groupName);
        }
        
        document.getElementById('inviteMemberModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeInviteMemberModal();
            }
        });
        

        function toggleActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.toggle('show');
            }
        }
        
        function closeActionMenu() {
            const actionMenu = document.getElementById('actionMenu');
            if (actionMenu) {
                actionMenu.classList.remove('show');
            }
        }
        
        function shareToFriend() {
            showToast('分享给朋友');
            closeActionMenu();
        }
    </script>
</body>
</html>
